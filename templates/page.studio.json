    "offer": {
      "type": "rb-media-cards",
      "blocks": {
        "workshops": {
          "type": "card",
          "settings": {
            "collection": "workshops",
            "title": "Studio Workshops",
            "image": "shopify://shop_images/saf-studio-workshops.jpg",
            "body": "<p>Our workshops are your chance to try something new without committing to a full term. Explore different mediums, techniques and creative ideas in relaxed, hands-on sessions led by talented artists and makers.</p>",
            "link": "",
            "button_label": "Browse Workshops"
          }
        },
        "classes": {
          "type": "card",
          "settings": {
            "collection": "classes",
            "title": "Studio Classes",
            "image": "shopify://shop_images/saf-studio-classes.jpg",
            "body": "<p>Our termly classes are designed to make creativity part of your week. Meet with the same small group each week, learn from experienced artists, and explore a wide variety of mediums - from painting and drawing to watercolour and beyond.</p><p>With different days, times and skill levels to choose from, there’s a class for every kind of creative.</p>",
            "link": "",
            "button_label": "Browse Classes"
          }
        },
        "events": {
          "type": "card",
          "settings": {
            "collection": "workshops-classes",
            "title": "Studio Events",
            "image": "shopify://shop_images/saf-studio-events.jpg",
            "body": "<p>From small exhibitions and artist talks to creative evenings and special gatherings, our events bring people together around art, conversation and good company.</p>",
            "link": "",
            "button_label": "Browse Events"
          }
        }
      },
      "block_order": [
        "workshops",
        "classes",
        "events"
      ],
      "settings": {
        "show_mark": true,
        "eyebrow": "<p>We host an array of <strong>annual classes, workshops</strong> and <strong>events</strong></p>",
        "heading": "",
        "image_ratio": "535 / 572",
        "background": "#ffffff",
        "title_color": "#1e1e1e",
        "body_color": "#1e1e1e"
      }
    },
    "steps": {
      "type": "rb-steps",
      "blocks": {
        "pick": {
          "type": "step",
          "settings": {
            "icon": "easel",
            "number": "1.",
            "title": "Picking A Class",
            "notes": "<p><strong>What To Expect</strong>Our classes vary by medium, teacher and experience level, with options for both adults and children. Most classes meet weekly for around two hours, with up to 10 classes each term.</p><p><strong>Materials</strong>Your teacher will share a materials list before your class, helping you gather everything you need to get creative — and keep creating at home.</p>"
          }
        },
        "book": {
          "type": "step",
          "settings": {
            "icon": "palette",
            "number": "2.",
            "title": "Booking A Class",
            "notes": "<p><strong>Simple Online Booking</strong>Find the class that feels right for you, choose your preferred day and time, and book your place online. Most classes welcome new students throughout the term, so you don’t always have to wait for the next one to begin.</p><p><strong>Missed A Class?</strong>Life happens. If you miss a class, you can make it up by joining another suitable class — giving you a little more flexibility in your creative week.</p>"
          }
        },
        "package": {
          "type": "step",
          "settings": {
            "icon": "laptop",
            "number": "3.",
            "title": "Pick A Package",
            "notes": "<p><strong>Choose What Works For You</strong>Depending on the class, you can choose to drop in, pay monthly or book for the full term. Pick the option that suits your schedule and how you want to create.</p><p><strong>Paying Online</strong>Everything is handled online, making it simple to book your place, choose your payment option and get straight to the creative part.</p>"
          }
        }
      },
      "block_order": [
        "pick",
        "book",
        "package"
      ],
      "settings": {
        "show_rule": true,
        "rule_color": "#c9c9c9",
        "background": "#ffffff",
        "number_color": "#b00e3f",
        "title_color": "#1e1e1e",
        "label_color": "#1e1e1e",
        "body_color": "#1e1e1e"
      }
    },
    "testimonials": {
      "type": "rb-testimonials",
      "blocks": {
        "t1": {
          "type": "quote",
          "settings": {
            "quote": "<p>“There is a great need for a nurturing place where artists at all levels can learn new approaches and styles in different media. The Studio is a place where you can grow.”</p>",
            "attribution": "- Michelle Alexander",
            "background": "#e07468",
            "quote_color": "#0c3642",
            "attr_color": "#0c3642"
          }
        },
        "t2": {
          "type": "quote",
          "settings": {
            "quote": "<p>“Friday is now my favorite day of the week. Zara is a nurturing, gentle and inspiring teacher and I am learning so much and in a fun and lighthearted atmosphere. It’s a wonderful group of supportive and encouraging people. Everyone brings something different and meaningful to add to my creative process. I highly recommend it.”</p>",
            "attribution": "- Dani Rubehiemer",
            "background": "#b00e3f",
            "quote_color": "#e07468",
            "attr_color": "#e07468"
          }
        },
        "t3": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/saf-class-artwork.jpg",
            "attribution": "",
            "attr_color": "#0c3642"
          }
        },
        "t4": {
          "type": "quote",
          "settings": {
            "quote": "<p>“The SA Art Fair is such a special organisation that is run by the amazing duo; Georgina &amp; Bianca. The way that these 2 ladies support South African artists &amp; South African art in general, is just wonderful! The Studio is such a special spot too!!”</p>",
            "attribution": "- Kate Mackenzie",
            "background": "#0c3642",
            "quote_color": "#e07468",
            "attr_color": "#e07468"
          }
        },
        "t5": {
          "type": "quote",
          "settings": {
            "quote": "<p>“I have been attending the watercolor classes at the SA Art Fair Studio this term and am absolutely loving them. I have been so impressed by what we have all been able to create in a few sessions. The class has students from all skill levels and if you are just there for the fun of it (like I am!), you never feel left behind or overwhelmed. It’s been nice to meet new faces and learn new watercolor techniques from an artist in a fun, welcoming environment. I can highly recommend this space for experienced artists and newbies who are looking for some creative ‘me time’.”</p>",
            "attribution": "- Tarryn Bartlett",
            "background": "#e07468",
            "quote_color": "#0c3642",
            "attr_color": "#0c3642"
          }
        },
        "t6": {
          "type": "quote",
          "settings": {
            "quote": "<p>“Beautiful relaxing space to explore your artistic endeavours. Different courses for all levels and styles offered.”</p>",
            "attribution": "- Gaby Blumberg",
            "background": "#b00e3f",
            "quote_color": "#e07468",
            "attr_color": "#e07468"
          }
        }
      },
