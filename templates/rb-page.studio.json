    "offer": {
      "type": "rb-media-cards",
      "blocks": {
        "workshops": {
          "type": "card",
          "settings": {
            "collection": "workshops",
            "title": "Studio Workshops",
            "image": "shopify://shop_images/saf-studio-workshops.jpg",
            "body": "<p>Our workshops are your chance to try something new without committing to a full term. Explore different mediums, techniques and creative ideas in relaxed, hands-on sessions led by talented artists and makers.</p>",
            "button_label": "Browse Workshops"
          }
        },
        "classes": {
          "type": "card",
          "settings": {
            "collection": "classes",
            "title": "Studio Classes",
            "image": "shopify://shop_images/saf-studio-classes.jpg",
            "body": "<p>Our termly classes are designed to make creativity part of your week. Meet with the same small group each week, learn from experienced artists, and explore a wide variety of mediums \u2014 from painting and drawing to watercolour and beyond.</p><p>With different days, times and skill levels to choose from, there\u2019s a class for every kind of creative.</p>",
            "button_label": "Browse Classes"
          }
        },
        "events": {
          "type": "card",
          "settings": {
            "collection": "workshops-classes",
            "title": "Studio Events",
            "image": "shopify://shop_images/saf-studio-events.jpg",
            "body": "<p>From small exhibitions and artist talks to creative evenings and special gatherings, our events bring people together around art, conversation and good company.</p>",
            "button_label": "Browse Events"
          }
        }
      },
      "block_order": [
        "workshops",
        "classes",
        "events"
      ],
      "settings": {
        "show_mark": true,
        "eyebrow": "<p>We host an array of <strong>termly classes, workshops</strong> and <strong>events</strong></p>",
        "image_ratio": "535 / 572",
        "background": "#ffffff",
        "title_color": "#1e1e1e",
        "body_color": "#1e1e1e"
      }
    },
    "steps": {
      "type": "rb-steps",
      "blocks": {
        "pick": {
          "type": "step",
          "settings": {
            "icon": "easel",
            "number": "1.",
            "title": "Picking A Class",
            "notes": "<p><strong>What To Expect</strong>Our classes vary by medium, teacher and experience level, with options for both adults and children. Most classes meet weekly for around two hours, with up to 10 classes each term.</p><p><strong>Materials</strong>Your teacher will share a materials list before your class, helping you gather everything you need to get creative \u2014 and keep creating at home.</p>"
          }
        },
        "book": {
          "type": "step",
          "settings": {
            "icon": "palette",
            "number": "2.",
            "title": "Booking A Class",
            "notes": "<p><strong>Simple Online Booking</strong>Find the class that feels right for you, choose your preferred day and time, and book your place online. Most classes welcome new students throughout the term, so you don\u2019t always have to wait for the next one to begin.</p><p><strong>Missed A Class?</strong>Life happens. If you miss a class, you can make it up by joining another suitable class \u2014 giving you a little more flexibility in your creative week.</p>"
          }
        },
        "package": {
          "type": "step",
          "settings": {
            "icon": "laptop",
            "number": "3.",
            "title": "Pick A Package",
            "notes": "<p><strong>Choose What Works For You</strong>Depending on the class, you can choose to drop in, pay monthly or book for the full term. Pick the option that suits your schedule and how you want to create.</p><p><strong>Paying Online</strong>Everything is handled online, making it simple to book your place, choose your payment option and get straight to the creative part.</p>"
          }
        }
      },
      "block_order": [
        "pick",
        "book",
        "package"
      ],
