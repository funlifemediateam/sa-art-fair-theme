        "c1": { "type": "column", "settings": { "title": "Learn", "text": "<p>Hands-on classes and workshops for every level, led by working artists.</p>", "link_label": "Explore Create Art", "link": "shopify://collections/workshops-classes" } },
        "c2": { "type": "column", "settings": { "title": "Create", "text": "<p>A studio built for making — the same space our resident artists work in.</p>" } },
        "c3": { "type": "column", "settings": { "title": "Exhibit", "text": "<p>A curated online gallery where our artists show their latest work.</p>" } },
        "c4": { "type": "column", "settings": { "title": "Collect", "text": "<p>Buy original art and limited editions directly from the makers.</p>", "link_label": "Explore Collect Art", "link": "shopify://collections/gallery" } }
