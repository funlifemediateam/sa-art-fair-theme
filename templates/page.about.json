    "intro": {
      "type": "rich-text",
      "blocks": {
        "caption": { "type": "caption", "settings": { "caption": "Learn. Create. Exhibit. Collect.", "text_style": "caption-with-letter-spacing", "text_size": "medium" } },
        "heading": { "type": "heading", "settings": { "heading": "Your Creative Ecosystem", "heading_size": "h1" } },
        "text": { "type": "text", "settings": { "text": "<p>SA Art Fair is a working art ecosystem in Hout Bay — a studio where artists learn and make, an online gallery where they exhibit and sell, and a home for collectors who want to buy from the artists who create. Whichever door you come in through — creator, collector, artist or teacher — you're part of the same creative circle.</p>" } }
      },
      "block_order": ["caption", "heading", "text"],
      "settings": { "desktop_content_position": "center", "content_alignment": "center", "color_scheme": "scheme-1", "full_width": true, "padding_top": 56, "padding_bottom": 40 }
    },
    "studio": {
      "type": "image-with-text",
      "blocks": {
        "caption": { "type": "caption", "settings": { "caption": "The studio", "text_style": "caption-with-letter-spacing", "text_size": "medium" } },
        "heading": { "type": "heading", "settings": { "heading": "Made and shown in Hout Bay", "heading_size": "h2" } },
        "text": { "type": "text", "settings": { "text": "<p>Our light-filled studio is where classes happen, where our resident artists work, and where much of the art you see online is created. It's a space built for making — and for the community that gathers around it.</p>", "text_style": "body" } }
      },
      "block_order": ["caption", "heading", "text"],
      "settings": { "height": "large", "desktop_image_width": "medium", "layout": "text_first", "content_layout": "no-overlap", "desktop_content_position": "middle", "desktop_content_alignment": "left", "color_scheme": "scheme-2", "section_color_scheme": "scheme-1", "padding_top": 24, "padding_bottom": 24 }
    },
