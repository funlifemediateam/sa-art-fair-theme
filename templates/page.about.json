    "founders": {
      "type": "rb-founders",
      "settings": {
        "image": "shopify://shop_images/saf-home-founders.png",
        "image_width": 475,
        "show_stamp": true,
        "stamp_width": 175,
        "heading": "SA Art Fair began with two friends, a love of art, and a simple belief: art is better when it is shared.",
        "heading_color": "#b00e3f",
        "column_one": "<p>What started as a local art fair has grown into a welcoming space to discover, collect, learn and create. An eco-system that brings artists and art lovers together in one community.</p><p>In The Store, discover and collect work from South African artists. In The Studio, pick up a brush, try something new and create alongside others.</p>",
        "column_two": "<p>You don’t need to be an expert or an artist to belong here. Just bring your curiosity.</p><p>Come and discover. Come and create. Come and be part of it.</p>",
        "body_color": "#1e1e1e",
        "signature": "– Bianca & Georgina xx",
        "background": "#ffffff"
      }
