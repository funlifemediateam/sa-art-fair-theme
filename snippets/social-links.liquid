{%- comment -%}
  Social/website links for a person, from shop metafield booking_app.socials (json).
  The map is keyed by handleized display name and written by the booking admin app
  (the same entry backs the Artists, Teachers and Team tabs).

  Usage (filters are not allowed in render args — assign the key first):
    {%- assign social_key = block.settings.name | handleize -%}
    {% render 'social-links', person_key: social_key, extra_class: 'theteam-member__socials' %}

  Icons inherit currentColor — set colour/size on .saf-socials in the calling section.
  Renders nothing when the person has no saved links.
{%- endcomment -%}

{%- assign saf_socials_map = shop.metafields.booking_app.socials.value -%}
{%- assign saf_social = saf_socials_map[person_key] -%}
{%- if saf_social -%}
<div class="saf-socials{% if extra_class != blank %} {{ extra_class }}{% endif %}">
  {%- if saf_social.instagram -%}
    <a href="{{ saf_social.instagram }}" class="saf-socials__link" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none"/></svg>
    </a>
  {%- endif -%}
  {%- if saf_social.facebook -%}
    <a href="{{ saf_social.facebook }}" class="saf-socials__link" target="_blank" rel="noopener" aria-label="Facebook" title="Facebook">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.87.24-1.46 1.49-1.46h1.6V4.44A21 21 0 0 0 14.25 4.3c-2.3 0-3.87 1.4-3.87 3.98v2.22H7.8v3h2.58V21h3.12z"/></svg>
    </a>
  {%- endif -%}
  {%- if saf_social.tiktok -%}
    <a href="{{ saf_social.tiktok }}" class="saf-socials__link" target="_blank" rel="noopener" aria-label="TikTok" title="TikTok">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 3c.35 1.98 1.6 3.36 3.9 3.5v2.7c-1.4.1-2.8-.32-3.9-1.13v5.87c0 3.6-2.34 5.86-5.4 5.86A5.13 5.13 0 0 1 6 14.66c0-2.9 2.32-5.2 5.5-5.05v2.83c-.3-.07-.62-.11-.93-.1a2.38 2.38 0 0 0-2.34 2.4c0 1.35 1.06 2.4 2.4 2.4 1.44 0 2.5-1.06 2.5-2.7V3h3.47z"/></svg>
    </a>
  {%- endif -%}
  {%- if saf_social.youtube -%}
    <a href="{{ saf_social.youtube }}" class="saf-socials__link" target="_blank" rel="noopener" aria-label="YouTube" title="YouTube">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.28 5 12 5 12 5s-6.28 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.77C5.72 19 12 19 12 19s6.28 0 7.84-.43a2.5 2.5 0 0 0 1.76-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15.2V8.8L15.6 12 10 15.2z"/></svg>
    </a>
  {%- endif -%}
  {%- if saf_social.x -%}
    <a href="{{ saf_social.x }}" class="saf-socials__link" target="_blank" rel="noopener" aria-label="X (Twitter)" title="X (Twitter)">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.3 3H20l-6.6 7.6L21.2 21h-6.1l-4.8-6.2L4.8 21H2.1l7.1-8.1L2.5 3h6.3l4.3 5.7L17.3 3zm-1.1 16.3h1.7L7.7 4.6H5.9l10.3 14.7z"/></svg>
    </a>
  {%- endif -%}
  {%- if saf_social.linkedin -%}
    <a href="{{ saf_social.linkedin }}" class="saf-socials__link" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.94 8.5H3.56V20.4h3.38V8.5zM5.25 3.2a2 2 0 1 0 0 4.02 2 2 0 0 0 0-4.02zM20.4 13.87c0-3.28-1.75-4.81-4.08-4.81-1.88 0-2.72 1.03-3.19 1.76V8.5h-3.38c.04.94 0 11.9 0 11.9h3.38v-6.65c0-.36.03-.71.13-.97.29-.71.94-1.45 2.03-1.45 1.44 0 2.01 1.09 2.01 2.69v6.38h3.38l-.28-6.53z"/></svg>
    </a>
  {%- endif -%}
  {%- if saf_social.website -%}
    {%- assign saf_site_label = saf_social.website | remove: 'https://' | remove: 'http://' | split: '/' | first | remove_first: 'www.' -%}
    <a href="{{ saf_social.website }}" class="saf-socials__link saf-socials__link--site" target="_blank" rel="noopener" aria-label="Website" title="{{ saf_site_label | escape }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.75 5.6 3.75 9S14.5 18.4 12 21c-2.5-2.6-3.75-5.6-3.75-9S9.5 5.6 12 3z"/></svg>
      <span class="saf-socials__site-label">{{ saf_site_label }}</span>
    </a>
  {%- endif -%}
</div>
{%- endif -%}
