{%- comment -%}
  Artwork product page only: plain-text "About the artist" note under the
  product description, so a one-line-description artwork page doesn't end
  right after the buy button. Deliberately unstyled — reuses Dawn's own
  .rte/.link classes rather than a custom card (Keagan rejected a first pass
  with a photo circle + coloured band).

  Skips itself entirely on Class/Workshop products, and when no artist
  collection can be resolved or that collection has no bio to show.

  Usage: render inside .product__info-container, after the block loop.
{%- endcomment -%}
{%- assign is_class = false -%}
{%- if product.type == 'Class' or product.type == 'Workshop' or product.template_suffix contains 'booking' -%}
  {%- assign is_class = true -%}
{%- endif -%}

{%- unless is_class -%}
  {%- capture artist_handle -%}{%- render 'rb-artist-handle', product: product -%}{%- endcapture -%}
  {%- assign artist_handle = artist_handle | strip -%}
  {%- assign artist_col = collections[artist_handle] -%}

  {%- assign has_content = false -%}
  {%- if artist_col != blank and artist_col.title != blank and artist_col.description != blank -%}
    {%- assign has_content = true -%}
  {%- endif -%}

  {%- if has_content -%}
    {%- assign artist_name = artist_col.title -%}
    {%- assign artist_bio = artist_col.description | strip_html | strip_newlines | strip | truncatewords: 42 -%}

    <div class="product__description rte">
      <p><strong>About.......... {{ artist_name }}</strong></p>
      <p>{{ artist_bio }}</p>
      <p><a href="{{ artist_col.url }}" class="link">View {{ artist_name | split: ' ' | first }}'s full collection</a></p>
    </div>
  {%- endif -%}
{%- endunless -%}
