{% comment %}
  Slide-in menu behind the rebrand header's burger.

  Accepts: sid (section id), menu (link_list), section (for settings).
  One level of children is supported — deeper nesting is flattened, which the
  brand's flat two-path IA does not need.
{% endcomment %}

<style>
  #rb-drawer-{{ sid }} {
    position: fixed;
    inset: 0;
    z-index: 60;
    visibility: hidden;
    pointer-events: none;
  }
  #rb-drawer-{{ sid }}.is-open { visibility: visible; pointer-events: auto; }

  #rb-drawer-{{ sid }} .rb-drawer__scrim {
    /* explicit display: Dawn's base.css hides every `div:empty`, and these
       decorative layers have no children */
    display: block;
    position: absolute;
    inset: 0;
    background: rgba(30, 30, 30, 0.42);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  #rb-drawer-{{ sid }}.is-open .rb-drawer__scrim { opacity: 1; }

  #rb-drawer-{{ sid }} .rb-drawer__panel {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: min(460px, 88vw);
    background: {{ section.settings.background | default: '#ffffff' }};
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 2.6vw, 44px);
    box-sizing: border-box;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.38s cubic-bezier(0.32, 0.72, 0, 1);
  }
  #rb-drawer-{{ sid }}.is-open .rb-drawer__panel { transform: none; }

  #rb-drawer-{{ sid }} .rb-drawer__close {
    align-self: flex-end;
    width: 44px; height: 44px;
    border: 0;
    background: none;
    color: {{ section.settings.text_color | default: '#1e1e1e' }};
    cursor: pointer;
    font-size: 26px;
    line-height: 1;
  }
  #rb-drawer-{{ sid }} .rb-drawer__nav {
    list-style: none;
    margin: clamp(12px, 1.5vw, 26px) 0 0;
    padding: 0;
  }
  #rb-drawer-{{ sid }} .rb-drawer__nav > li { margin-bottom: clamp(10px, 0.9vw, 16px); }
  #rb-drawer-{{ sid }} .rb-drawer__link {
    display: block;
    font-family: var(--rb-serif);
    font-size: clamp(24px, 1.88vw, 36px);
    font-weight: 400;
    line-height: 1.25;
    color: {{ section.settings.text_color | default: '#1e1e1e' }};
    text-decoration: none;
  }
  #rb-drawer-{{ sid }} .rb-drawer__link:hover { color: var(--rb-cherry); }
  #rb-drawer-{{ sid }} .rb-drawer__sub {
    list-style: none;
    margin: 6px 0 0;
    padding: 0 0 0 14px;
  }
  #rb-drawer-{{ sid }} .rb-drawer__sub a {
    display: block;
    padding: 3px 0;
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-body-sm);
    color: {{ section.settings.text_color | default: '#1e1e1e' }};
    text-decoration: none;
  }
  #rb-drawer-{{ sid }} .rb-drawer__sub a:hover { color: var(--rb-cherry); }

  #rb-drawer-{{ sid }} .rb-drawer__foot {
    margin-top: auto;
    padding-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }
  #rb-drawer-{{ sid }} .rb-drawer__foot a {
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-body-sm);
    color: {{ section.settings.text_color | default: '#1e1e1e' }};
    text-decoration: none;
  }
  #rb-drawer-{{ sid }} .rb-drawer__actions { margin-top: 20px; }

  /* Call and Instagram sit on their own row ABOVE the two path buttons, as
     icon-only circles. Contact used to be a third pill in the same row and
     pushed Create Art onto a second line at the panel's 460px — the pair now
     always shares one line because nothing else competes for it. */
  #rb-drawer-{{ sid }} .rb-drawer__icons {
    display: flex;
    gap: 10px;
    margin-bottom: 12px;
  }
  #rb-drawer-{{ sid }} .rb-drawer__icon-btn {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    min-height: 48px;
    padding: 0;
  }
  #rb-drawer-{{ sid }} .rb-drawer__icon-btn svg {
    width: 20px;
    height: 20px;
  }

  /* auto-flow column = one equal-width track per button, so a single button
     still fills the row instead of leaving a dead half */
  #rb-drawer-{{ sid }} .rb-drawer__ctas {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 10px;
  }
  #rb-drawer-{{ sid }} .rb-drawer__ctas .rb-btn {
    min-width: 0;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    #rb-drawer-{{ sid }} .rb-drawer__panel,
    #rb-drawer-{{ sid }} .rb-drawer__scrim { transition: none; }
  }
</style>

<div id="rb-drawer-{{ sid }}" class="rb-drawer" data-rb-drawer>
  <div class="rb-drawer__scrim" data-rb-drawer-close></div>

  <div class="rb-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <button type="button" class="rb-drawer__close" data-rb-drawer-close aria-label="Close menu">&times;</button>

    {%- if linklists[menu].links.size > 0 -%}
      <ul class="rb-drawer__nav">
        {%- for link in linklists[menu].links -%}
          <li>
            <a href="{{ link.url }}" class="rb-drawer__link">{{ link.title | escape }}</a>
            {%- if link.links.size > 0 -%}
              <ul class="rb-drawer__sub">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- comment -%}
      The pills carry whatever fill the header is set to, so a coloured header
      does not open a drawer wearing the old outline pair.
    {%- endcomment -%}
    {%- liquid
      assign fill_a = section.settings.cta_a_fill | default: 'outline'
      assign fill_b = section.settings.cta_b_fill | default: 'outline'

      comment
        The call button prefers its own number, then the WhatsApp number the
        site already publishes site-wide, then the shop record. With none of
        those set it falls back to the contact page rather than rendering a
        dead tel: link.
      endcomment
      assign phone_raw = section.settings.phone_number | default: settings.saf_whatsapp_number | default: shop.phone
      assign phone_digits = phone_raw | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '+'
      assign ig_url = section.settings.instagram_url | default: settings.social_instagram_link
    -%}
    <div class="rb-drawer__actions">
      {%- comment -%}
        Contact and Instagram are actions, not places to browse, so they sit
        with the path buttons rather than in the menu above — but as icons on
        their own row, so Buy Art and Create Art keep a full line to themselves.
      {%- endcomment -%}
      {%- if section.settings.show_contact or section.settings.show_instagram -%}
        <div class="rb-drawer__icons">
          {%- if section.settings.show_contact -%}
            {%- if phone_digits != blank -%}
              <a
                href="tel:+{{ phone_digits }}"
                class="rb-btn rb-btn--plain rb-btn--outline rb-drawer__icon-btn"
                aria-label="Call {{ phone_raw | escape }}"
                title="Call {{ phone_raw | escape }}"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M6.4 3.5h3l1.5 3.8-2 1.4a12.5 12.5 0 0 0 6.4 6.4l1.4-2 3.8 1.5v3a1.9 1.9 0 0 1-2.1 1.9A16.6 16.6 0 0 1 4.5 5.6 1.9 1.9 0 0 1 6.4 3.5z"></path>
                </svg>
              </a>
            {%- elsif section.settings.contact_url != blank -%}
              <a
                href="{{ section.settings.contact_url }}"
                class="rb-btn rb-btn--plain rb-btn--outline rb-drawer__icon-btn"
                aria-label="{{ section.settings.contact_label | default: 'Contact' | escape }}"
                title="{{ section.settings.contact_label | default: 'Contact' | escape }}"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <rect x="2.5" y="5" width="19" height="14" rx="2"></rect>
                  <path d="M3 6.5l9 6 9-6"></path>
                </svg>
              </a>
            {%- endif -%}
          {%- endif -%}

          {%- if section.settings.show_instagram and ig_url != blank -%}
            <a
              href="{{ ig_url }}"
              class="rb-btn rb-btn--plain rb-btn--outline rb-drawer__icon-btn"
              target="_blank"
              rel="noopener"
              aria-label="Instagram (opens in a new tab)"
              title="Instagram"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"></circle>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="rb-drawer__ctas">
        {%- if section.settings.cta_a_label != blank -%}
          <a href="{{ section.settings.cta_a_url | default: '#' }}" class="rb-btn rb-btn--plain rb-btn--{{ fill_a }}">
            {{- section.settings.cta_a_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.cta_b_label != blank -%}
          <a href="{{ section.settings.cta_b_url | default: '#' }}" class="rb-btn rb-btn--plain rb-btn--{{ fill_b }}">
            {{- section.settings.cta_b_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="rb-drawer__foot">
      {%- comment -%}
        The contact PAGE lost its route when the button became a phone icon —
        'Contact' is not in the drawer menu (it was removed when the button was
        added). This keeps the page one tap away without a third pill.
      {%- endcomment -%}
      {%- if section.settings.contact_url != blank and phone_digits != blank -%}
        <a href="{{ section.settings.contact_url }}">
          {{- section.settings.contact_label | default: 'Contact' | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.drawer_cart_link -%}
        <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
      {%- endif -%}
      {%- if section.settings.drawer_account_link and shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}">
          {%- if customer %}Account{% else %}Log in{% endif -%}
        </a>
      {%- endif -%}
      <a href="{{ routes.search_url }}">Search</a>
    </div>
  </div>
</div>
