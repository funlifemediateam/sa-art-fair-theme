{%- comment -%}
  Shop by Colour — hover a colour to preview it, click through to the collection.
  Each block = one colour: pick a collection, optionally override title/label/image/swatch.
  Image fallback chain: block image → collection image → first product image → placeholder.
{%- endcomment -%}

{% style %}
  .sbc-section {
    background: {{ section.settings.background | default: '#eeefeb' }};
    padding: 96px 0;
  }
  .sbc-container {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 40px;
    display: grid;
    grid-template-columns: minmax(0, 46%) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .sbc-container--flip .sbc-media { order: 2; }
  .sbc-container--flip .sbc-panel { order: 1; }

  /* Image stack (desktop) */
  .sbc-media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 6px;
    overflow: hidden;
    background: #e7e2d8;
  }
  .sbc-card {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.55s ease, visibility 0.55s;
    text-decoration: none;
  }
  .sbc-card.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .sbc-card__img,
  .sbc-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sbc-card__placeholder {
    background: linear-gradient(145deg, #e7e2d8 0%, #d9d2c4 100%);
  }
  .sbc-card__label {
    position: absolute;
    top: 34px;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #ffffff;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }
  .sbc-card__meta { display: none; }

  /* Text panel */
  .sbc-eyebrow {
    font-family: var(--font-body-family);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #18727d;
    margin: 0 0 14px;
  }
  .sbc-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    font-weight: 700;
    color: #1d1c21;
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0 0 clamp(28px, 4vw, 52px);
  }
  .sbc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sbc-list li + li { margin-top: clamp(18px, 2.6vw, 30px); }
  .sbc-link {
    display: inline-flex;
    align-items: baseline;
    gap: 14px;
    font-family: var(--font-heading-family);
    font-size: clamp(1.45rem, 2.2vw, 1.9rem);
    font-weight: 500;
    color: #85796c;
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .sbc-link__swatch {
    align-self: center;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: inset 0 0 0 1px rgba(29, 28, 33, 0.12);
    transition: transform 0.25s ease;
  }
  .sbc-link__text {
    position: relative;
  }
  .sbc-link__text::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -5px;
    height: 2px;
    background: currentColor;
    transition: right 0.35s ease;
  }
  .sbc-link__count {
    font-family: var(--font-body-family);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: #85796c;
    transition: opacity 0.25s;
    opacity: 0;
    transform: translateY(-1px);
  }
  .sbc-link.is-active,
  .sbc-link:hover,
  .sbc-link:focus-visible {
    color: #1d1c21;
  }
  .sbc-link.is-active .sbc-link__text::after { right: 0; }
  .sbc-link.is-active .sbc-link__swatch { transform: scale(1.25); }
  .sbc-link.is-active .sbc-link__count { opacity: 1; }
  .sbc-link:focus-visible {
    outline: 2px solid #18727d;
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sbc-card, .sbc-link, .sbc-link__text::after,
    .sbc-link__swatch, .sbc-link__count { transition: none; }
  }

  /* Mobile: heading on top, colours as swipeable image cards */
  @media (max-width: 749px) {
    .sbc-section { padding: 56px 0 64px; }
    .sbc-container {
      display: flex;
      flex-direction: column;
      padding-inline: 24px;
    }
    .sbc-panel { order: -1; margin-bottom: 26px; }
    .sbc-heading { margin-bottom: 0; }
    .sbc-list { display: none; }
    .sbc-media {
      aspect-ratio: auto;
      border-radius: 0;
      overflow-x: auto;
      overflow-y: hidden;
      background: none;
      display: flex;
      gap: 14px;
      scroll-snap-type: x mandatory;
      margin-inline: -24px;
      padding-inline: 24px;
      scrollbar-width: none;
    }
    .sbc-media::-webkit-scrollbar { display: none; }
    .sbc-card {
      position: relative;
      inset: auto;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      flex: 0 0 74%;
      max-width: 74%;
      scroll-snap-align: start;
    }
    .sbc-card__img,
    .sbc-card__placeholder {
      aspect-ratio: 4 / 5;
      height: auto;
      border-radius: 6px;
    }
    .sbc-card__label { top: 22px; font-size: 0.8rem; }
    .sbc-card__meta {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px;
      padding: 12px 2px 0;
      font-family: var(--font-heading-family);
      font-size: 1.15rem;
      font-weight: 600;
      color: #1d1c21;
    }
    .sbc-card__meta-count {
      font-family: var(--font-body-family);
      font-size: 0.75rem;
      font-weight: 400;
      color: #85796c;
      white-space: nowrap;
    }
  }
{% endstyle %}

<section class="sbc-section">
  <div class="sbc-container{% if section.settings.image_position == 'right' %} sbc-container--flip{% endif %}" data-sbc>
    <div class="sbc-media">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- assign card_title = block.settings.title -%}
        {%- if card_title == blank and col != blank -%}{%- assign card_title = col.title -%}{%- endif -%}
        {%- if card_title == blank -%}{%- assign card_title = 'Colour' -%}{%- endif -%}
        {%- assign card_label = block.settings.label | default: card_title -%}

        {%- assign card_image = block.settings.image -%}
        {%- if card_image == blank and col != blank -%}
          {%- assign card_image = col.image | default: col.products.first.featured_image -%}
        {%- endif -%}

        <a
          class="sbc-card{% if forloop.first %} is-active{% endif %}"
          href="{% if col != blank %}{{ col.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
          data-sbc-card="{{ forloop.index0 }}"
          aria-label="{{ card_title | escape }}{% if col != blank %} — {{ col.products_count }} works{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if card_image -%}
            {{ card_image | image_url: width: 1000 | image_tag:
              class: 'sbc-card__img',
              loading: 'lazy',
              widths: '500, 750, 1000, 1400',
              sizes: '(max-width: 749px) 74vw, 46vw',
              alt: card_label
            }}
          {%- else -%}
            <div class="sbc-card__placeholder"></div>
          {%- endif -%}
          <span class="sbc-card__label">{{ card_label }}</span>
          <span class="sbc-card__meta">
            {{ card_title }}
            {%- if col != blank -%}
              <span class="sbc-card__meta-count">{{ col.products_count }} work{% if col.products_count != 1 %}s{% endif %}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>

    <div class="sbc-panel">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sbc-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="sbc-heading">{{ section.settings.heading | default: 'Shop by Colour' }}</h2>
      <ul class="sbc-list">
        {%- for block in section.blocks -%}
          {%- assign col = block.settings.collection -%}
          {%- assign link_title = block.settings.title -%}
          {%- if link_title == blank and col != blank -%}{%- assign link_title = col.title -%}{%- endif -%}
          {%- if link_title == blank -%}{%- assign link_title = 'Colour' -%}{%- endif -%}
          <li>
            <a
              class="sbc-link{% if forloop.first %} is-active{% endif %}"
              href="{% if col != blank %}{{ col.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
              data-sbc-link="{{ forloop.index0 }}"
            >
              {%- if block.settings.swatch != blank and block.settings.swatch != 'rgba(0,0,0,0)' -%}
                <span class="sbc-link__swatch" style="background: {{ block.settings.swatch }};"></span>
              {%- endif -%}
              <span class="sbc-link__text">{{ link_title }}</span>
              {%- if col != blank -%}
                <span class="sbc-link__count">{{ col.products_count }} work{% if col.products_count != 1 %}s{% endif %}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('[data-sbc]').forEach(function (root) {
      if (root.dataset.sbcBound) return;
      root.dataset.sbcBound = '1';
      var links = root.querySelectorAll('[data-sbc-link]');
      var cards = root.querySelectorAll('[data-sbc-card]');
      function activate(i) {
        links.forEach(function (el) { el.classList.toggle('is-active', el.dataset.sbcLink === i); });
        cards.forEach(function (el) { el.classList.toggle('is-active', el.dataset.sbcCard === i); });
      }
      links.forEach(function (link) {
        ['mouseenter', 'focus'].forEach(function (evt) {
          link.addEventListener(evt, function () { activate(link.dataset.sbcLink); });
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Shop by Colour",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ART FOR YOUR SPACE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Colour" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "#eeefeb", "label": "Studio white" },
        { "value": "#f5ece6", "label": "Warm paper" }
      ],
      "default": "#eeefeb"
    }
  ],
  "blocks": [
    {
      "type": "colour",
      "name": "Colour",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave blank to use the collection title" },
        { "type": "text", "id": "label", "label": "Label over image", "info": "Leave blank to use the title" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave blank to use the collection image" },
        { "type": "color", "id": "swatch", "label": "Swatch dot", "default": "#d9cfc0" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop by Colour",
      "blocks": [
        { "type": "colour", "settings": { "title": "Warm", "swatch": "#c96a4a" } },
        { "type": "colour", "settings": { "title": "Cool", "swatch": "#18727d" } },
        { "type": "colour", "settings": { "title": "Neutral", "swatch": "#b7ab99" } }
      ]
    }
  ]
}
{% endschema %}
