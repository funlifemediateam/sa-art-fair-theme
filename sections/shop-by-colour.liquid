{%- comment -%}
  Shop by Colour — hover a colour to preview it, click through to the collection.
  Each block = one colour: pick a collection, optionally override title/label/image/swatch.
  App overrides: shop.metafields.booking_app.shop_by_colour (json) — fields set in the
  admin app win over theme-editor settings; blank app fields fall back to the block.
  Image fallback chain: app image → block image → collection image → first product image.
{%- endcomment -%}

{%- assign sbc_cfg = shop.metafields.booking_app.shop_by_colour.value -%}
{%- assign sbc_eyebrow = section.settings.eyebrow -%}
{%- assign sbc_heading = section.settings.heading | default: 'Shop by Colour' -%}
{%- if sbc_cfg.eyebrow != blank -%}{%- assign sbc_eyebrow = sbc_cfg.eyebrow -%}{%- endif -%}
{%- if sbc_cfg.heading != blank -%}{%- assign sbc_heading = sbc_cfg.heading -%}{%- endif -%}

{% style %}
  .sbc-section {
    background: {{ section.settings.background | default: '#eeefeb' }};
    padding: clamp(52px, 7vh, 84px) 0;
  }
  .sbc-container {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(24px, 4vw, 48px);
    display: grid;
    grid-template-columns: minmax(0, 44%) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 92px);
    align-items: center;
  }
  .sbc-container--flip .sbc-media { order: 2; }
  .sbc-container--flip .sbc-panel { order: 1; }

  /* ── Image stack (desktop) — height capped so the section always fits the viewport ── */
  .sbc-media {
    position: relative;
    height: clamp(400px, 60vh, 550px);
    border-radius: 6px;
    overflow: hidden;
    background: #e7e2d8;
  }
  .sbc-card {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.6s ease, visibility 0.6s;
    text-decoration: none;
  }
  .sbc-card.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .sbc-card__img,
  .sbc-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sbc-card:hover .sbc-card__img { transform: scale(1.035); }
  .sbc-card__placeholder {
    background: linear-gradient(145deg, #e7e2d8 0%, #d9d2c4 100%);
  }
  .sbc-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 110px;
    background: linear-gradient(to bottom, rgba(20, 18, 16, 0.28), transparent);
    pointer-events: none;
    z-index: 1;
  }
  .sbc-card__label {
    position: absolute;
    top: 30px;
    left: 0;
    right: 0;
    z-index: 2;
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.32em;
    text-indent: 0.32em;
    text-transform: uppercase;
    color: #ffffff;
    pointer-events: none;
  }
  .sbc-card__meta { display: none; }
  .sbc-progress { display: none; }

  /* ── Text panel ── */
  .sbc-eyebrow {
    font-family: var(--font-body-family);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #18727d;
    margin: 0 0 14px;
  }
  .sbc-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 700;
    color: #1d1c21;
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0 0 clamp(20px, 3vh, 36px);
  }
  .sbc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sbc-list li { border-bottom: 1px solid rgba(29, 28, 33, 0.12); }
  .sbc-list li:first-child { border-top: 1px solid rgba(29, 28, 33, 0.12); }
  .sbc-link {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: clamp(16px, 2.6vh, 24px) 2px;
    font-family: var(--font-heading-family);
    font-size: clamp(1.35rem, 1.9vw, 1.65rem);
    font-weight: 500;
    color: rgba(29, 28, 33, 0.42);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .sbc-link__swatch {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: inset 0 0 0 1px rgba(29, 28, 33, 0.12);
    transition: transform 0.3s ease;
  }
  .sbc-link__text { flex: 1 1 auto; }
  .sbc-link__count {
    font-family: var(--font-body-family);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: rgba(29, 28, 33, 0.38);
    white-space: nowrap;
    transition: color 0.3s ease;
  }
  .sbc-link__arrow {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: #1d1c21;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .sbc-link__arrow svg { display: block; width: 100%; height: 100%; }
  .sbc-link.is-active,
  .sbc-link:hover,
  .sbc-link:focus-visible { color: #1d1c21; }
  .sbc-link.is-active .sbc-link__swatch { transform: scale(1.3); }
  .sbc-link.is-active .sbc-link__count { color: rgba(29, 28, 33, 0.62); }
  .sbc-link.is-active .sbc-link__arrow { opacity: 1; transform: translateX(0); }
  .sbc-link:focus-visible {
    outline: 2px solid #18727d;
    outline-offset: 2px;
    border-radius: 2px;
  }
  .sbc-viewall {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: clamp(20px, 3vh, 32px);
    font-family: var(--font-body-family);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #1d1c21;
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(29, 28, 33, 0.35);
    transition: border-color 0.25s ease;
  }
  .sbc-viewall:hover { border-color: #1d1c21; }
  .sbc-viewall svg { width: 14px; height: 14px; }
  .sbc-viewall--mobile { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .sbc-card, .sbc-card__img, .sbc-link, .sbc-link__swatch,
    .sbc-link__count, .sbc-link__arrow, .sbc-viewall { transition: none; }
  }

  /* ── Mobile: heading on top, one swipeable card with a peek of the next ── */
  @media (max-width: 749px) {
    .sbc-section { padding: 44px 0 48px; }
    .sbc-container {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-inline: 24px;
    }
    .sbc-panel { order: -1; margin-bottom: 20px; }
    .sbc-heading { margin-bottom: 0; }
    .sbc-list, .sbc-link__arrow, .sbc-viewall--desktop { display: none; }
    .sbc-viewall--mobile { display: inline-flex; margin-top: 22px; align-self: flex-start; }
    .sbc-media {
      height: auto;
      border-radius: 0;
      overflow-x: auto;
      overflow-y: hidden;
      background: none;
      display: flex;
      gap: 12px;
      scroll-snap-type: x mandatory;
      margin-inline: -24px;
      padding-inline: 24px;
      scrollbar-width: none;
    }
    .sbc-media::-webkit-scrollbar { display: none; }
    .sbc-card {
      position: relative;
      inset: auto;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      flex: 0 0 76%;
      max-width: 76%;
      scroll-snap-align: start;
    }
    .sbc-card__img,
    .sbc-card__placeholder {
      height: min(48vh, 380px);
      width: 100%;
      border-radius: 6px;
    }
    .sbc-card:hover .sbc-card__img { transform: none; }
    .sbc-card::before { border-radius: 6px 6px 0 0; height: 80px; }
    .sbc-card__label { top: 20px; font-size: 0.68rem; }
    .sbc-card__meta {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px;
      padding: 11px 2px 0;
      font-family: var(--font-heading-family);
      font-size: 1.12rem;
      font-weight: 600;
      color: #1d1c21;
    }
    .sbc-card__meta-count {
      font-family: var(--font-body-family);
      font-size: 0.72rem;
      font-weight: 400;
      letter-spacing: 0.04em;
      color: rgba(29, 28, 33, 0.45);
      white-space: nowrap;
    }
    .sbc-progress {
      display: block;
      position: relative;
      height: 1px;
      margin-top: 18px;
      background: rgba(29, 28, 33, 0.14);
    }
    .sbc-progress__fill {
      position: absolute;
      top: -0.5px;
      left: 0;
      height: 2px;
      width: 33%;
      background: #1d1c21;
      transition: width 0.15s ease, transform 0.15s ease;
      will-change: transform;
    }
  }
{% endstyle %}

<section class="sbc-section">
  <div class="sbc-container{% if section.settings.image_position == 'right' %} sbc-container--flip{% endif %}" data-sbc data-section-id="{{ section.id }}">
    <div class="sbc-media" data-sbc-track>
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}

        {%- comment -%} App (metafield) override for this colour, matched by collection handle {%- endcomment -%}
        {%- assign ov_title = blank -%}{%- assign ov_label = blank -%}{%- assign ov_image = blank -%}
        {%- if sbc_cfg and col != blank -%}
          {%- for c in sbc_cfg.colours -%}
            {%- if c.collection == col.handle -%}
              {%- assign ov_title = c.title -%}
              {%- assign ov_label = c.label -%}
              {%- assign ov_image = c.image -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- assign card_title = ov_title | default: block.settings.title -%}
        {%- if card_title == blank and col != blank -%}{%- assign card_title = col.title -%}{%- endif -%}
        {%- if card_title == blank -%}{%- assign card_title = 'Colour' -%}{%- endif -%}
        {%- assign card_label = ov_label | default: block.settings.label | default: card_title -%}

        {%- assign card_image = block.settings.image -%}
        {%- if card_image == blank and col != blank -%}
          {%- assign card_image = col.image | default: col.products.first.featured_image -%}
        {%- endif -%}

        <a
          class="sbc-card{% if forloop.first %} is-active{% endif %}"
          href="{% if col != blank %}{{ col.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
          data-sbc-card="{{ forloop.index0 }}"
          aria-label="{{ card_title | escape }}{% if col != blank %} — {{ col.products_count }} works{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if ov_image != blank -%}
            {%- assign sep = '?' -%}{%- if ov_image contains '?' -%}{%- assign sep = '&' -%}{%- endif -%}
            <img
              class="sbc-card__img"
              loading="lazy"
              decoding="async"
              width="900"
              height="1125"
              alt="{{ card_label | escape }}"
              src="{{ ov_image }}{{ sep }}width=900"
              srcset="{{ ov_image }}{{ sep }}width=500 500w, {{ ov_image }}{{ sep }}width=900 900w, {{ ov_image }}{{ sep }}width=1200 1200w"
              sizes="(max-width: 749px) 76vw, 44vw"
            >
          {%- elsif card_image -%}
            {{ card_image | image_url: width: 900 | image_tag:
              class: 'sbc-card__img',
              loading: 'lazy',
              decoding: 'async',
              widths: '500, 750, 900, 1200',
              sizes: '(max-width: 749px) 76vw, 44vw',
              alt: card_label
            }}
          {%- else -%}
            <div class="sbc-card__placeholder"></div>
          {%- endif -%}
          <span class="sbc-card__label">{{ card_label }}</span>
          <span class="sbc-card__meta">
            {{ card_title }}
            {%- if col != blank -%}
              <span class="sbc-card__meta-count">{{ col.products_count }} work{% if col.products_count != 1 %}s{% endif %}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>

    <div class="sbc-panel">
      {%- if sbc_eyebrow != blank -%}
        <p class="sbc-eyebrow">{{ sbc_eyebrow }}</p>
      {%- endif -%}
      <h2 class="sbc-heading">{{ sbc_heading }}</h2>
      <ul class="sbc-list">
        {%- for block in section.blocks -%}
          {%- assign col = block.settings.collection -%}

          {%- assign ov_title = blank -%}{%- assign ov_swatch = blank -%}
          {%- if sbc_cfg and col != blank -%}
            {%- for c in sbc_cfg.colours -%}
              {%- if c.collection == col.handle -%}
                {%- assign ov_title = c.title -%}
                {%- assign ov_swatch = c.swatch -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- assign link_title = ov_title | default: block.settings.title -%}
          {%- if link_title == blank and col != blank -%}{%- assign link_title = col.title -%}{%- endif -%}
          {%- if link_title == blank -%}{%- assign link_title = 'Colour' -%}{%- endif -%}
          {%- assign link_swatch = ov_swatch | default: block.settings.swatch -%}
          <li>
            <a
              class="sbc-link{% if forloop.first %} is-active{% endif %}"
              href="{% if col != blank %}{{ col.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
              data-sbc-link="{{ forloop.index0 }}"
            >
              {%- if link_swatch != blank and link_swatch != 'rgba(0,0,0,0)' -%}
                <span class="sbc-link__swatch" style="background: {{ link_swatch }};"></span>
              {%- endif -%}
              <span class="sbc-link__text">{{ link_title }}</span>
              {%- if col != blank -%}
                <span class="sbc-link__count">{{ col.products_count }} work{% if col.products_count != 1 %}s{% endif %}</span>
              {%- endif -%}
              <span class="sbc-link__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.view_all_label != blank -%}
        <a class="sbc-viewall sbc-viewall--desktop" href="{{ section.settings.view_all_url | default: '/collections/gallery' }}">
          {{ section.settings.view_all_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="sbc-progress" aria-hidden="true"><span class="sbc-progress__fill"></span></div>
    {%- if section.settings.view_all_label != blank -%}
      <a class="sbc-viewall sbc-viewall--mobile" href="{{ section.settings.view_all_url | default: '/collections/gallery' }}">
        {{ section.settings.view_all_label }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    function initSbc(scope) {
      (scope || document).querySelectorAll('[data-sbc]').forEach(function (root) {
        if (root.dataset.sbcBound) return;
        root.dataset.sbcBound = '1';
        var links = root.querySelectorAll('[data-sbc-link]');
        var cards = root.querySelectorAll('[data-sbc-card]');
        var track = root.querySelector('[data-sbc-track]');
        var fill  = root.querySelector('.sbc-progress__fill');

        function activate(i) {
          links.forEach(function (el) { el.classList.toggle('is-active', el.dataset.sbcLink === i); });
          cards.forEach(function (el) { el.classList.toggle('is-active', el.dataset.sbcCard === i); });
        }
        root.sbcActivate = activate;

        links.forEach(function (link) {
          ['mouseenter', 'focus'].forEach(function (evt) {
            link.addEventListener(evt, function () { activate(link.dataset.sbcLink); });
          });
        });

        /* Mobile swipe progress line */
        if (track && fill) {
          var ticking = false;
          function paint() {
            ticking = false;
            var max = track.scrollWidth - track.clientWidth;
            if (max <= 0 || !cards.length) return;
            var seg = 100 / cards.length;
            fill.style.width = seg + '%';
            fill.style.transform = 'translateX(' + (track.scrollLeft / max) * (100 / seg - 1) * 100 + '%)';
          }
          track.addEventListener('scroll', function () {
            if (!ticking) { ticking = true; requestAnimationFrame(paint); }
          }, { passive: true });
          paint();
        }
      });
    }
    initSbc();

    /* Theme editor: rebind after section reload, preview the block being edited */
    document.addEventListener('shopify:section:load', function (e) { initSbc(e.target); });
    document.addEventListener('shopify:block:select', function (e) {
      var card = e.target.closest ? e.target.closest('[data-sbc-card]') : null;
      if (!card) return;
      var root = card.closest('[data-sbc]');
      if (root && root.sbcActivate) root.sbcActivate(card.dataset.sbcCard);
      if (card.scrollIntoView && window.innerWidth < 750) card.scrollIntoView({ inline: 'start', block: 'nearest' });
    });
  })();
</script>

{% schema %}
{
  "name": "Shop by Colour",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Heading, colour names, swatches and images can also be managed from the SA Art Fair admin app (Shop by Colour tab) — values set there override these." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ART FOR YOUR SPACE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Colour" },
    { "type": "text", "id": "view_all_label", "label": "View-all link text", "default": "View all art", "info": "Leave blank to hide the link" },
    { "type": "url", "id": "view_all_url", "label": "View-all link" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "#eeefeb", "label": "Studio white" },
        { "value": "#f5ece6", "label": "Warm paper" }
      ],
      "default": "#eeefeb"
    }
  ],
  "blocks": [
    {
      "type": "colour",
      "name": "Colour",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave blank to use the collection title" },
        { "type": "text", "id": "label", "label": "Label over image", "info": "Leave blank to use the title" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave blank to use the collection image" },
        { "type": "color", "id": "swatch", "label": "Swatch dot", "default": "#d9cfc0" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop by Colour",
      "blocks": [
        { "type": "colour", "settings": { "title": "Warm", "swatch": "#c96a4a" } },
        { "type": "colour", "settings": { "title": "Cool", "swatch": "#18727d" } },
        { "type": "colour", "settings": { "title": "Neutral", "swatch": "#b7ab99" } }
      ]
    }
  ]
}
{% endschema %}
