{% comment %}
  Rebrand quiz banner — blurred floral photograph, gold-filled stadium badge,
  white italic heading, white pill. Comp: 1920 x 883.

  The badge PNG is a white stadium with the protea knocked out of it, so the
  gold comes from a backing element clipped to the same stadium shape. That is
  the only way to tint the mark without shipping a second image.
{% endcomment %}

{{ 'saf-rebrand.css' | asset_url | stylesheet_tag }}

{%- assign sid = section.id -%}

<style>
  #shopify-section-{{ sid }} .rb-quiz {
    position: relative;
    width: 100%;
    aspect-ratio: 1920 / {{ section.settings.band_height }};
    min-height: {{ section.settings.min_height }}px;
    overflow: hidden;
    background: var(--rb-ink);
    display: flex;
  }
  #shopify-section-{{ sid }} .rb-quiz__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%;
  }
  #shopify-section-{{ sid }} .rb-quiz__overlay {
    /* explicit display: Dawn's base.css hides every `div:empty`, and these
       decorative layers have no children */
    display: block;
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  #shopify-section-{{ sid }} .rb-quiz__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-sizing: border-box;
    padding: clamp(40px, 9.43vw, 181px) var(--rb-gutter) clamp(48px, 14.95vw, 287px);
  }
  #shopify-section-{{ sid }} .rb-quiz__badge {
    display: block;
    width: clamp(66px, 5.73vw, 110px);
    aspect-ratio: 253 / 395;
    border-radius: 999px;
    overflow: hidden;
    background: {{ section.settings.badge_color }};
    margin-bottom: clamp(16px, 1.98vw, 38px);
  }
  #shopify-section-{{ sid }} .rb-quiz__badge img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  #shopify-section-{{ sid }} .rb-quiz__heading {
    margin: 0;
    font-family: var(--rb-serif);
    font-weight: 300;
    font-style: italic;
    font-size: var(--rb-fs-display-lg);
    line-height: 1.2;
    color: {{ section.settings.text_color }};
    max-width: 22ch;
    text-wrap: balance;
  }
  #shopify-section-{{ sid }} .rb-quiz__cta {
    margin-top: clamp(20px, 2.4vw, 46px);
    min-height: clamp(48px, 4.22vw, 81px);
    padding-inline: clamp(28px, 3.13vw, 60px);
  }

  /* The home page runs this band edge to edge. The Store page insets it into
     the container and rounds the corners — same band, different framing. */
  {%- if section.settings.contained -%}
    #shopify-section-{{ sid }} .rb-quiz-wrap {
      box-sizing: border-box;
      width: 100%;
      max-width: calc(var(--rb-container) + var(--rb-gutter) * 2);
      margin-inline: auto;
      padding-inline: var(--rb-gutter);
    }
  {%- endif -%}
  #shopify-section-{{ sid }} .rb-quiz { border-radius: {{ section.settings.radius }}px; }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ sid }} .rb-quiz {
      aspect-ratio: {{ section.settings.mobile_ratio }};
    }
    #shopify-section-{{ sid }} .rb-quiz__inner { padding-block: 56px 64px; }
  }
</style>

<div class="rb-section rb-bleed{% if section.settings.contained %} rb-quiz-wrap{% endif %}">
  <div class="rb-quiz">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          class: 'rb-quiz__img',
          widths: '750, 1100, 1500, 1920, 2400, 3840',
          sizes: '100vw',
          loading: 'lazy',
          alt: section.settings.image.alt | default: ''
      }}
    {%- endif -%}

    {%- if section.settings.overlay_opacity > 0 -%}
      <div class="rb-quiz__overlay" aria-hidden="true"></div>
    {%- endif -%}

    <div class="rb-quiz__inner">
      {%- if section.settings.show_badge -%}
        <span class="rb-quiz__badge">
          <img src="{{ 'saf-badge-saaf.png' | asset_url }}" alt="" width="253" height="395" loading="lazy">
        </span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="rb-quiz__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="rb-btn rb-btn--white rb-quiz__cta">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rebrand quiz banner",
  "tag": "section",
  "class": "rb-section-wrapper",
  "settings": [
    { "type": "checkbox", "id": "contained", "default": false,
      "label": "Inset into the container",
      "info": "The Store page frames this band inside the page; the home page runs it edge to edge." },
    { "type": "range", "id": "radius", "min": 0, "max": 60, "step": 2,
      "default": 0, "unit": "px", "label": "Corner radius" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "band_height", "min": 500, "max": 1100, "step": 10,
      "default": 880, "unit": "px", "label": "Band height at 1920px wide" },
    { "type": "range", "id": "min_height", "min": 240, "max": 700, "step": 10,
      "default": 400, "unit": "px", "label": "Minimum height" },
    { "type": "text", "id": "mobile_ratio", "default": "3 / 4", "label": "Mobile aspect ratio" },
    { "type": "range", "id": "focal_x", "min": 0, "max": 100, "step": 1, "default": 50,
      "unit": "%", "label": "Image focal point — horizontal" },
    { "type": "range", "id": "focal_y", "min": 0, "max": 100, "step": 1, "default": 50,
      "unit": "%", "label": "Image focal point — vertical" },
    { "type": "color", "id": "overlay_color", "default": "#1e1e1e", "label": "Overlay colour" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "default": 0,
      "unit": "%", "label": "Overlay opacity" },
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_badge", "default": true, "label": "Show protea badge" },
    { "type": "color", "id": "badge_color", "default": "#bea532", "label": "Badge protea colour" },
    { "type": "text", "id": "heading",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit.", "label": "Heading" },
    { "type": "color", "id": "text_color", "default": "#ffffff", "label": "Heading colour" },
    { "type": "text", "id": "button_label", "default": "Take the quiz", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rebrand quiz banner" }]
}
{% endschema %}
