{% comment %}
  Rebrand media cards — the Studio page's "Studio Workshops / Studio Classes /
  Studio Events" row: a cherry protea and an uppercase teal line over three
  photo cards, each with an IvyPresto title, a short paragraph and an outline
  pill.

  The eyebrow mixes teal and cherry mid-sentence in the comp ("WE HOST AN
  ARRAY OF ANNUAL CLASSES, WORKSHOPS AND EVENTS"), so it takes richtext and
  colours <strong> runs cherry — same contract as .rb-caps everywhere else.
{% endcomment %}

{{ 'saf-rebrand.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign cols = section.blocks.size | at_least: 1
-%}

<style>
  #shopify-section-{{ sid }} .rb-mc {
    background: {{ section.settings.background }};
    padding-block:
      clamp(48px, 5.73vw, 110px)
      clamp(48px, 6.77vw, 130px);
  }
  #shopify-section-{{ sid }} .rb-mc__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(12px, 1.25vw, 24px);
    text-align: center;
    margin-bottom: clamp(28px, 3.44vw, 66px);
  }
  #shopify-section-{{ sid }} .rb-mc__mark {
    display: block;
    width: clamp(26px, 1.98vw, 38px);
    height: auto;
  }
  #shopify-section-{{ sid }} .rb-mc__grid {
    display: grid;
    grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));
    gap: clamp(24px, 2.5vw, 48px);
  }
  #shopify-section-{{ sid }} .rb-mc__card {
    display: flex;
    flex-direction: column;
  }
  #shopify-section-{{ sid }} .rb-mc__media {
    aspect-ratio: {{ section.settings.image_ratio }};
    width: 100%;
  }
  #shopify-section-{{ sid }} .rb-mc__media img { transition: transform 0.6s ease; }
  #shopify-section-{{ sid }} .rb-mc__media:hover img { transform: scale(1.03); }

  #shopify-section-{{ sid }} .rb-mc__title {
    margin: clamp(12px, 1.15vw, 22px) 0 0;
    color: {{ section.settings.title_color }};
    font-size: clamp(20px, 1.77vw, 34px);
  }
  #shopify-section-{{ sid }} .rb-mc__title a { color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} .rb-mc__title a:hover { text-decoration: underline; }
  #shopify-section-{{ sid }} .rb-mc__body {
    margin-top: clamp(6px, 0.63vw, 12px);
    font-size: var(--rb-fs-body-sm);
    color: {{ section.settings.body_color }};
  }
  #shopify-section-{{ sid }} .rb-mc__body p { margin: 0; }
  /* a card whose copy runs to two paragraphs needs the break to read as one */
  #shopify-section-{{ sid }} .rb-mc__body p + p { margin-top: 0.7em; }

  /* the pill is centred under the card and pinned to the bottom so a longer
     paragraph in one card does not lift its button out of line */
  #shopify-section-{{ sid }} .rb-mc__cta-row {
    display: flex;
    justify-content: center;
    margin-top: auto;
    padding-top: clamp(16px, 1.72vw, 33px);
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ sid }} .rb-mc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 639px) {
    #shopify-section-{{ sid }} .rb-mc__grid { grid-template-columns: 1fr; }
  }
</style>

<div class="rb-section rb-mc">
  <div class="rb-container">
    {%- if section.settings.show_mark or section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="rb-mc__head">
        {%- if section.settings.show_mark -%}
          <img
            src="{{ 'saf-protea-cherry.png' | asset_url }}"
            alt=""
            width="179"
            height="243"
            class="rb-mc__mark"
            loading="lazy"
          >
        {%- endif -%}
        {%- if section.settings.eyebrow != blank -%}
          <div class="rb-caps">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rb-section-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="rb-mc__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign title = block.settings.title | default: col.title
          assign img = block.settings.image | default: col.featured_image
          assign url = block.settings.link | default: col.url
        -%}
        <div class="rb-mc__card" {{ block.shopify_attributes }}>
          <a href="{{ url | default: '#' }}" class="rb-media rb-mc__media" tabindex="-1" aria-hidden="true">
            {%- if img != blank -%}
              {{
                img
                | image_url: width: 1200
                | image_tag:
                  widths: '400, 520, 700, 1040, 1200',
                  sizes: '(max-width: 639px) 90vw, (max-width: 989px) 45vw, 30vw',
                  loading: 'lazy',
                  alt: ''
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>

          {%- if title != blank -%}
            <h3 class="rb-section-title rb-mc__title">
              <a href="{{ url | default: '#' }}">{{ title }}</a>
            </h3>
          {%- endif -%}

          {%- if block.settings.body != blank -%}
            <div class="rb-body rb-mc__body">{{ block.settings.body }}</div>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            <div class="rb-mc__cta-row">
              <a href="{{ url | default: '#' }}" class="rb-btn rb-btn--serif rb-btn--outline">
                {{- block.settings.button_label | escape -}}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rebrand media cards",
  "tag": "section",
  "class": "rb-section-wrapper",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "show_mark", "default": true, "label": "Show small cherry protea" },
    { "type": "richtext", "id": "eyebrow",
      "default": "<p>We host an array of <strong>annual classes, workshops</strong> and <strong>events</strong></p>",
      "label": "Eyebrow",
      "info": "Rendered uppercase. Bold runs render cherry, the rest teal — that is the design's two-tone line." },
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "text", "id": "image_ratio", "default": "535 / 400", "label": "Card image ratio" },
    { "type": "header", "content": "Colour" },
    { "type": "color", "id": "background", "default": "#ffffff", "label": "Background" },
    { "type": "color", "id": "title_color", "default": "#1e1e1e", "label": "Card title" },
    { "type": "color", "id": "body_color", "default": "#1e1e1e", "label": "Card body" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection",
          "info": "Supplies the title, image and link unless you override them below." },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "richtext", "id": "body",
          "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>",
          "label": "Body" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "text", "id": "button_label", "default": "Browse", "label": "Button label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rebrand media cards",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
