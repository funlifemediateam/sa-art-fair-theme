{% comment %}
  Wishlist page — hydrated client-side by assets/wishlist.js from localStorage
  (synced to the customer metafield for logged-in customers).
{% endcomment %}

<div class="page-width section-{{ section.id }}-padding saf-wishlist-page">
  <h1 class="title title--primary">{{ section.settings.heading | default: 'My Wishlist' }}</h1>

  {%- unless customer -%}
    <p class="saf-wishlist-nudge">
      <a href="{{ routes.account_login_url }}">Sign in</a> to keep your wishlist across devices.
    </p>
  {%- endunless -%}

  <div data-wishlist-empty hidden class="saf-wishlist-empty">
    <p>You haven't saved anything yet.</p>
    <a href="{{ routes.all_products_collection_url }}" class="button">Discover art</a>
  </div>

  <div id="saf-wishlist-grid" class="saf-wishlist-grid"></div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: 36px;
    padding-bottom: 52px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "My Wishlist",
      "label": "Heading"
    }
  ]
}
{% endschema %}
