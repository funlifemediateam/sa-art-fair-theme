{%- style -%}
  .announcement-pills-bar {
    overflow: hidden;
    height: 52px;
  }
  .announcement-pills-slider {
    display: flex;
    height: 100%;
  }
  .announcement-pill-slide {
    min-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .announcement-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 28px;
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 3px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.18s, background 0.18s;
  }
  .announcement-pill:hover {
    border-color: rgba(255,255,255,0.72);
    background: rgba(255,255,255,0.09);
  }
  .announcement-bar-section { position: relative; }
  .announcement-socials {
    position: absolute;
    left: 2rem;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    z-index: 1;
  }
  .announcement-socials .saf-socials {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .announcement-socials .saf-socials__link {
    display: inline-flex;
    color: inherit;
    opacity: 0.85;
    transition: opacity 0.18s;
  }
  .announcement-socials .saf-socials__link:hover { opacity: 1; }
  .announcement-socials .saf-socials__link svg {
    width: 17px;
    height: 17px;
    display: block;
  }
  @media screen and (max-width: 749px) {
    .announcement-pills-bar { height: 46px; }
    .announcement-pill { height: 28px; padding: 0 16px; font-size: 0.64rem; }
    .announcement-socials { left: 1.2rem; }
    .announcement-socials .saf-socials { gap: 11px; }
    .announcement-socials .saf-socials__link svg { width: 15px; height: 15px; }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient announcement-bar-section">
  {%- if section.settings.show_socials -%}
    {%- assign store_social = shop.metafields.booking_app.store_socials.value -%}
    {%- if store_social -%}
      <div class="announcement-socials">
        {% render 'social-links', entry: store_social, icons_only: true %}
      </div>
    {%- endif -%}
  {%- endif -%}
  <div class="announcement-pills-bar">
    <div class="announcement-pills-slider">
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          <div class="announcement-pill-slide" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="announcement-pill">{{ block.settings.text | escape }}</a>
            {%- else -%}
              <span class="announcement-pill">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_socials",
      "label": "Show social icons",
      "info": "The links are managed in the booking admin app, under Socials. Only filled-in links get an icon.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [{ "type": "announcement" }]
    }
  ]
}
{% endschema %}
