{% comment %}
  Rebrand artist cards — the artists index. Each card is one of the artist's
  works with their black-and-white portrait set into it, a sage or moss paper
  panel underneath carrying a medium/place meta row, the name in large
  IvyPresto and a short bio, then a full-width pill under the card.

  The comp darkens the middle column of every row, so "Auto" tones by column
  position rather than by a flat alternation — with three columns that gives
  light / dark / light on every row, which is what the design shows.

  Cards read from collections, which is how artists are modelled in this
  store, and every field can be overridden per card.
{% endcomment %}

{{ 'saf-rebrand.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign cols = section.settings.columns
-%}

<style>
  #shopify-section-{{ sid }} .rb-ac {
    background: {{ section.settings.background }};
    padding-block:
      clamp(40px, 5.21vw, 100px)
      clamp(48px, 7.29vw, 140px);
  }
  /* this grid runs wider than the site container in the comp, so it carries
     its own measure instead of using .rb-container's */
  #shopify-section-{{ sid }} .rb-ac__wrap {
    width: 100%;
    max-width: calc({{ section.settings.grid_width }}px + var(--rb-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--rb-gutter);
    box-sizing: border-box;
  }
  /* Artist finder — search box plus the full list of names. */
  #shopify-section-{{ sid }} .rb-ac__finder {
    margin: 0 auto clamp(28px, 3vw, 58px);
    text-align: center;
  }
  #shopify-section-{{ sid }} .rb-ac__finder-label {
    color: {{ section.settings.finder_accent }};
    margin: 0 0 14px;
  }
  #shopify-section-{{ sid }} .rb-ac__search {
    display: block;
    width: min(420px, 100%);
    margin: 0 auto;
    box-sizing: border-box;
    min-height: clamp(40px, 3.18vw, 56px);
    padding: 0 22px;
    border: 1px solid rgba(30, 30, 30, 0.22);
    border-radius: 999px;
    background: transparent;
    color: {{ section.settings.finder_text_color }};
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-btn);
    line-height: 1;
    -webkit-appearance: none;
    appearance: none;
  }
  #shopify-section-{{ sid }} .rb-ac__search::placeholder { color: rgba(30, 30, 30, 0.5); }
  #shopify-section-{{ sid }} .rb-ac__search:focus {
    outline: none;
    border-color: {{ section.settings.finder_accent }};
  }

  #shopify-section-{{ sid }} .rb-ac__names {
    list-style: none;
    margin: clamp(16px, 1.6vw, 26px) auto 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 0;
  }
  #shopify-section-{{ sid }} .rb-ac__names li { display: inline-flex; align-items: center; }
  /* a dot between names, never a trailing one */
  #shopify-section-{{ sid }} .rb-ac__names li + li::before {
    content: '';
    display: block;
    width: 3px;
    height: 3px;
    margin: 0 12px;
    border-radius: 50%;
    background: {{ section.settings.finder_accent }};
    opacity: 0.55;
  }
  #shopify-section-{{ sid }} .rb-ac__names a {
    color: {{ section.settings.finder_text_color }};
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-body-sm);
    line-height: 1.35;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  #shopify-section-{{ sid }} .rb-ac__names a:hover,
  #shopify-section-{{ sid }} .rb-ac__names a:focus-visible {
    color: {{ section.settings.finder_accent }};
    border-bottom-color: currentColor;
  }
  #shopify-section-{{ sid }} .rb-ac__names li[hidden] { display: none; }
  /* the separator belongs to the item before it, so a hidden neighbour must
     not leave an orphan dot at the start of a filtered row */
  #shopify-section-{{ sid }} .rb-ac__names li[hidden] + li::before { display: none; }

  #shopify-section-{{ sid }} .rb-ac__empty {
    margin: clamp(20px, 2vw, 34px) 0 0;
    color: {{ section.settings.finder_text_color }};
  }
  #shopify-section-{{ sid }} .rb-ac__card[hidden] { display: none; }

  #shopify-section-{{ sid }} .rb-ac__grid {
    display: grid;
    grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));
    gap: clamp(20px, 2.55vw, 49px);
  }

  #shopify-section-{{ sid }} .rb-ac__card {
    display: flex;
    flex-direction: column;
  }
  #shopify-section-{{ sid }} .rb-ac__body {
    display: flex;
    flex-direction: column;
    border-radius: {{ section.settings.radius }}px;
    overflow: hidden;
    flex: 1 1 auto;
  }
  #shopify-section-{{ sid }} .rb-ac__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    background: #efefef;
  }
  #shopify-section-{{ sid }} .rb-ac__media > img,
  #shopify-section-{{ sid }} .rb-ac__media > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ sid }} .rb-ac__portrait {
    left: {{ section.settings.portrait_x }}%;
    top: {{ section.settings.portrait_y }}%;
    width: {{ section.settings.portrait_w }}%;
    aspect-ratio: {{ section.settings.portrait_ratio }};
    transform: translate(-50%, -50%);
  }

  #shopify-section-{{ sid }} .rb-ac__panel {
    flex: 1 1 auto;
    box-sizing: border-box;
    padding: clamp(12px, 1.25vw, 24px) clamp(14px, 1.15vw, 22px) clamp(18px, 1.98vw, 38px);
    --rb-paper-strength: {{ section.settings.texture | divided_by: 100.0 }};
  }
  #shopify-section-{{ sid }} .rb-ac__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 clamp(8px, 0.83vw, 16px);
  }
  #shopify-section-{{ sid }} .rb-ac__name {
    margin: 0;
    line-height: 1.02;
  }
  #shopify-section-{{ sid }} .rb-ac__name a { color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} .rb-ac__name a:hover { text-decoration: underline; }
  #shopify-section-{{ sid }} .rb-ac__bio {
    margin-top: clamp(8px, 0.83vw, 16px);
    font-size: var(--rb-fs-body-sm);
  }
  #shopify-section-{{ sid }} .rb-ac__bio p { margin: 0; }

  /* the pill is a separate bar under the card, not inside it */
  #shopify-section-{{ sid }} .rb-ac__cta {
    display: flex;
    width: 100%;
    margin-top: clamp(6px, 0.63vw, 12px);
    min-height: clamp(44px, 4.01vw, 77px);
    border-radius: 999px;
    font-family: var(--rb-serif);
    font-size: clamp(16px, 1.35vw, 26px);
    letter-spacing: 0;
    text-transform: none;
    font-weight: 400;
    --rb-paper-strength: {{ section.settings.texture | divided_by: 100.0 }};
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ sid }} .rb-ac__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 639px) {
    #shopify-section-{{ sid }} .rb-ac__grid { grid-template-columns: 1fr; }
  }

  {%- for block in section.blocks -%}
    {%- liquid
      assign tone = block.settings.tone
      if tone == 'auto'
        assign pos = forloop.index0 | modulo: cols
        assign m = pos | modulo: 2
        if m == 1
          assign tone = 'b'
        else
          assign tone = 'a'
        endif
      endif
      if tone == 'a'
        assign bg = section.settings.tone_a
        assign fg = section.settings.tone_a_text
        assign meta = section.settings.tone_a_meta
      else
        assign bg = section.settings.tone_b
        assign fg = section.settings.tone_b_text
        assign meta = section.settings.tone_b_meta
      endif
    -%}
    #shopify-section-{{ sid }} [data-blk="{{ block.id }}"] .rb-ac__panel {
      background: {{ bg }};
      color: {{ fg }};
    }
    #shopify-section-{{ sid }} [data-blk="{{ block.id }}"] .rb-ac__meta { color: {{ meta }}; }
    #shopify-section-{{ sid }} [data-blk="{{ block.id }}"] .rb-ac__cta {
      background: {{ bg }};
      color: {{ fg }};
      border-color: {{ bg }};
    }
    #shopify-section-{{ sid }} [data-blk="{{ block.id }}"] .rb-ac__cta:hover {
      background: {{ fg }};
      color: {{ bg }};
    }
  {%- endfor -%}
</style>

<div class="rb-section rb-ac">
  <div class="rb-ac__wrap">
    {%- comment -%}
      Bianca's ask on the wording doc: "Can we have a list or search function
      underneath here somehow that shows all the artists names?"

      Off by default, so a page that just wants Hanre's wall of cards gets the
      comp untouched. When on, it is a search box plus every artist's name as a
      link — the names ARE the list she asked for, and clicking one jumps
      straight to that artist rather than only filtering the wall.

      Progressive enhancement: with no JS the input hides itself and the name
      list still works, because the names are real links, not filter triggers.
    {%- endcomment -%}
    {%- if section.settings.show_finder and section.blocks.size > 1 -%}
      <div class="rb-ac__finder" data-rb-ac-finder>
        {%- if section.settings.finder_label != blank -%}
          <p class="rb-caps rb-ac__finder-label">{{ section.settings.finder_label | escape }}</p>
        {%- endif -%}

        <input
          type="search"
          class="rb-ac__search"
          placeholder="{{ section.settings.search_placeholder | default: 'Search artists' | escape }}"
          aria-label="{{ section.settings.search_placeholder | default: 'Search artists' | escape }}"
          autocomplete="off"
          hidden
          data-rb-ac-search
        >

        {%- if section.settings.show_name_list -%}
          {%- comment -%}
            Alphabetical, which `sort: 'settings.name'` cannot do here: almost
            every block leaves `name` blank and inherits the collection's
            title, so sorting the blocks sorts a column of empty strings.
            Resolve each name FIRST, pack it with its url, then sort the
            resolved rows. `sort_natural` so "van der Berg" files with the v's
            rather than ahead of every lowercase-shy name.
          {%- endcomment -%}
          {%- capture rb_ac_rows -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign col = collections[block.settings.collection]
                assign nm = block.settings.name | default: col.title
                assign nurl = block.settings.link | default: col.url
              -%}
              {%- if nm != blank -%}{{ nm | strip }}~{{ nurl | default: '#' }}|{%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- assign rb_ac_list = rb_ac_rows | strip | split: '|' | sort_natural -%}

          <ul class="rb-ac__names" role="list">
            {%- for row in rb_ac_list -%}
              {%- assign parts = row | strip | split: '~' -%}
              {%- if parts.size == 2 -%}
                <li><a href="{{ parts[1] }}" data-rb-ac-name>{{ parts[0] }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <p class="rb-body rb-ac__empty" hidden data-rb-ac-empty>
          {{ section.settings.empty_text | default: 'No artists match that search.' | escape }}
        </p>
      </div>
    {%- endif -%}

    <div class="rb-ac__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign name = block.settings.name | default: col.title
          assign art = block.settings.image | default: col.featured_image
          assign url = block.settings.link | default: col.url
          assign bio = block.settings.bio
          if bio == blank
            assign bio = col.description
          endif
        -%}
        <article
          class="rb-ac__card"
          data-blk="{{ block.id }}"
          data-search="{{ name | append: ' ' | append: block.settings.medium | append: ' ' | append: block.settings.place | downcase | escape }}"
          {{ block.shopify_attributes }}
        >
          <div class="rb-ac__body">
            <div class="rb-ac__media">
              {%- if art != blank -%}
                {{
                  art
                  | image_url: width: 1200
                  | image_tag:
                    widths: '380, 560, 800, 1200',
                    sizes: '(max-width: 639px) 90vw, (max-width: 989px) 45vw, 30vw',
                    loading: 'lazy',
                    alt: ''
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- if block.settings.portrait != blank -%}
                <div class="rb-inset rb-ac__portrait">
                  {{
                    block.settings.portrait
                    | image_url: width: 600
                    | image_tag:
                      widths: '200, 320, 460, 600',
                      sizes: '(max-width: 639px) 40vw, 14vw',
                      loading: 'lazy',
                      alt: name
                  }}
                </div>
              {%- endif -%}
            </div>

            <div class="rb-ac__panel rb-paper">
              {%- if block.settings.medium != blank or block.settings.place != blank -%}
                <p class="rb-meta rb-ac__meta">
                  <span>{{ block.settings.medium }}</span>
                  <span>{{ block.settings.place }}</span>
                </p>
              {%- endif -%}

              {%- if name != blank -%}
                <h2 class="rb-name rb-ac__name"><a href="{{ url | default: '#' }}">{{ name }}</a></h2>
              {%- endif -%}

              {%- if bio != blank -%}
                <div class="rb-body rb-ac__bio">{{ bio }}</div>
              {%- endif -%}
            </div>
          </div>

          {%- if block.settings.button_label != blank -%}
            <a href="{{ url | default: '#' }}" class="rb-btn rb-ac__cta rb-paper">
              {{- block.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.show_finder and section.blocks.size > 1 -%}
  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ sid }}');
      if (!root) return;
      var finder = root.querySelector('[data-rb-ac-finder]');
      var input = root.querySelector('[data-rb-ac-search]');
      var empty = root.querySelector('[data-rb-ac-empty]');
      if (!finder || !input) return;

      /* The box is hidden in the markup and revealed here, so a visitor with
         no JS is never shown a search field that cannot search. The name list
         needs no such guard — those are ordinary links. */
      input.hidden = false;

      var cards = Array.prototype.slice.call(root.querySelectorAll('.rb-ac__card'));
      var names = Array.prototype.slice.call(finder.querySelectorAll('.rb-ac__names li'));

      function norm(s) {
        /* fold accents so "Zara-Leigh Farinha" is found by "farinha" and a
           name like "Liesel van der Bérg" by "berg" */
        return (s || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, ' ')
          .trim();
      }

      function apply() {
        var q = norm(input.value);
        var shown = 0;

        cards.forEach(function (card) {
          var hit = !q || norm(card.getAttribute('data-search')).indexOf(q) !== -1;
          card.hidden = !hit;
          if (hit) shown++;
        });

        names.forEach(function (li) {
          var a = li.querySelector('a');
          li.hidden = !!q && norm(a && a.textContent).indexOf(q) === -1;
        });

        if (empty) empty.hidden = shown !== 0;
      }

      input.addEventListener('input', apply);
      /* a browser-restored value (back button, bfcache) must not leave the
         grid and the box disagreeing */
      if (input.value) apply();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Rebrand artist cards",
  "tag": "section",
  "class": "rb-section-wrapper",
  "max_blocks": 50,
  "settings": [
    { "type": "header", "content": "Find an artist",
      "info": "Not part of the Figma comp — leave off and the wall of cards is the design exactly." },
    { "type": "checkbox", "id": "show_finder", "default": false,
      "label": "Show search and name list above the cards" },
    { "type": "text", "id": "finder_label", "label": "Label above the search box",
      "default": "Find an artist" },
    { "type": "text", "id": "search_placeholder", "label": "Search box placeholder",
      "default": "Search by name or medium" },
    { "type": "checkbox", "id": "show_name_list", "default": true,
      "label": "List every artist's name",
      "info": "Each name links to that artist's page. The list stays usable without JavaScript." },
    { "type": "text", "id": "empty_text", "label": "No-results message",
      "default": "No artists match that search." },
    { "type": "color", "id": "finder_text_color", "default": "#1e1e1e", "label": "Finder text" },
    { "type": "color", "id": "finder_accent", "default": "#b00e3f", "label": "Finder accent" },
    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1,
      "default": 3, "label": "Columns" },
    { "type": "range", "id": "grid_width", "min": 1200, "max": 1800, "step": 10,
      "default": 1760, "unit": "px", "label": "Grid max width",
      "info": "The comp runs this grid a little wider than the rest of the site." },
    { "type": "text", "id": "image_ratio", "default": "555 / 402", "label": "Artwork ratio" },
    { "type": "range", "id": "radius", "min": 0, "max": 48, "step": 1,
      "default": 20, "unit": "px", "label": "Card corner radius" },
    { "type": "header", "content": "Portrait inset" },
    { "type": "range", "id": "portrait_w", "min": 15, "max": 70, "step": 1,
      "default": 42, "unit": "%", "label": "Portrait width" },
    { "type": "text", "id": "portrait_ratio", "default": "132 / 130", "label": "Portrait aspect ratio" },
    { "type": "range", "id": "portrait_x", "min": 0, "max": 100, "step": 1,
      "default": 49, "unit": "%", "label": "Portrait centre — horizontal" },
    { "type": "range", "id": "portrait_y", "min": 0, "max": 100, "step": 1,
      "default": 50, "unit": "%", "label": "Portrait centre — vertical" },
    { "type": "header", "content": "Colour" },
    { "type": "color", "id": "background", "default": "#ffffff", "label": "Background" },
    { "type": "color", "id": "tone_a", "default": "#9da887", "label": "Tone A panel" },
    { "type": "color", "id": "tone_a_text", "default": "#ffffff", "label": "Tone A text" },
    { "type": "color", "id": "tone_a_meta", "default": "#f2f4ec", "label": "Tone A meta row" },
    { "type": "color", "id": "tone_b", "default": "#505a43", "label": "Tone B panel" },
    { "type": "color", "id": "tone_b_text", "default": "#dfe4d4", "label": "Tone B text" },
    { "type": "color", "id": "tone_b_meta", "default": "#a5ad93", "label": "Tone B meta row" },
    { "type": "range", "id": "texture", "min": 0, "max": 100, "step": 5,
      "default": 100, "unit": "%", "label": "Crumpled paper texture" }
  ],
  "blocks": [
    {
      "type": "artist",
      "name": "Artist",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Artist collection",
          "info": "Supplies the name, artwork, bio and link." },
        { "type": "text", "id": "name", "label": "Name override" },
        { "type": "text", "id": "medium", "default": "Watercolour Artist", "label": "Medium" },
        { "type": "text", "id": "place", "default": "Hout Bay, Western Cape", "label": "Place" },
        { "type": "richtext", "id": "bio", "label": "Bio override",
          "info": "Blank uses the collection description." },
        { "type": "image_picker", "id": "image", "label": "Artwork override" },
        { "type": "image_picker", "id": "portrait", "label": "Portrait",
          "info": "Rendered black and white, as in the design." },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "text", "id": "button_label", "default": "See Collections", "label": "Button label" },
        { "type": "select", "id": "tone", "label": "Panel colour", "default": "auto",
          "options": [
            { "value": "auto", "label": "Auto (darkens the middle column)" },
            { "value": "a", "label": "Tone A" },
            { "value": "b", "label": "Tone B" }
          ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rebrand artist cards",
      "blocks": [
        { "type": "artist" }, { "type": "artist" }, { "type": "artist" },
        { "type": "artist" }, { "type": "artist" }, { "type": "artist" }
      ]
    }
  ]
}
{% endschema %}
