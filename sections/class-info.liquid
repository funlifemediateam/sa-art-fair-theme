{%- liquid
  assign src = product
  assign _h = section.settings.class_handle
  if _h == 'ya-programme'
    assign _h = 'young-artist-programme-for-tweens-teens-with-janice-grant'
  elsif _h == 'sewing-jacqui'
    assign _h = 'beginners-sewing-workshop-jacqui-sundelson-from-fabric-to-finished-garment'
  endif
  if _h != blank
    assign src = all_products[_h]
  endif
  assign body = src.description
-%}

{%- if body != blank -%}
<div class="clsi-wrap">
  <div class="clsi-inner section-{{ section.id }}-padding">
    <div class="clsi-body rte">
      {{ body }}
    </div>
  </div>
</div>
{%- endif -%}

{%- style -%}
  .clsi-wrap {
    background: #fff;
    border-top: 1px solid rgba(46,26,40,0.08);
  }
  .clsi-inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    max-width: 860px;
    margin: 0 auto;
  }
  @media screen and (min-width: 750px) {
    .clsi-inner { padding-left: 3rem; padding-right: 3rem; }
  }
  .clsi-body { color: #1a1a1a; font-size: 0.95rem; line-height: 1.8; }
  .clsi-body h1, .clsi-body h2 {
    font-size: 1rem; font-weight: 700; letter-spacing: 0.09em;
    text-transform: uppercase; color: #c9873a; margin: 2.4rem 0 0.6rem;
    padding-bottom: 0.5rem; border-bottom: 2px solid rgba(201,135,58,0.25); line-height: 1.3;
  }
  .clsi-body h3 {
    font-size: 1rem; font-weight: 700; color: #2e1a28;
    margin: 1.6rem 0 0.4rem; letter-spacing: 0.02em; line-height: 1.4;
  }
  .clsi-body h4, .clsi-body h5, .clsi-body h6 {
    font-size: 0.9rem; font-weight: 600; color: #2e1a28;
    margin: 1.2rem 0 0.3rem; letter-spacing: 0.02em;
  }
  .clsi-body > h1:first-child, .clsi-body > h2:first-child, .clsi-body > h3:first-child { margin-top: 0; }
  .clsi-body p { margin: 0 0 1rem; color: rgba(26,26,26,0.82); }
  .clsi-body p:last-child { margin-bottom: 0; }
  .clsi-body ul, .clsi-body ol { margin: 0.4rem 0 1rem 1.2rem; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .clsi-body ul { list-style: none; margin-left: 0; }
  .clsi-body ul li { display: flex; align-items: flex-start; gap: 0.65rem; color: rgba(26,26,26,0.82); }
  .clsi-body ul li::before {
    content: ''; display: block; flex-shrink: 0;
    width: 6px; height: 6px; border-radius: 50%;
    background: #c9873a; margin-top: 0.58em;
  }
  .clsi-body ol li { color: rgba(26,26,26,0.82); padding-left: 0.2rem; }
  .clsi-body strong, .clsi-body b { font-weight: 700; color: #2e1a28; }
  .clsi-body em, .clsi-body i { color: rgba(26,26,26,0.7); }
  .clsi-body hr { border: none; border-top: 1px solid rgba(46,26,40,0.1); margin: 2rem 0; }
  .clsi-body a { color: #c9873a; text-decoration: underline; text-underline-offset: 2px; }
  .clsi-body a:hover { color: #2e1a28; }
{%- endstyle -%}

{% schema %}
{
  "name": "Class Info",
  "settings": [
    {
      "type": "header",
      "content": "Class \/ Workshop"
    },
    {
      "type": "paragraph",
      "content": "Select a class to display its full description. Content is managed via the SA Booking Admin app."
    },
    {
      "type": "select",
      "id": "class_handle",
      "label": "Class \/ Workshop",
      "options": [
        { "value": "", "label": "— Auto (current product page) —" },
        { "value": "ya-programme", "label": "Young Artist Programme | Tweens & Teens" },
        { "value": "young-artists-with-janice-grant", "label": "Young Artists with Janice Grant" },
        { "value": "permission-to-play-classes-with-zara-farinha", "label": "Permission to Play with Zara Farinha" },
        { "value": "watercolour-with-kerri-sassen", "label": "Watercolour with Kerri Sassen" },
        { "value": "beginners-sewing-workshop-16-aug-9am-5pm", "label": "Beginners Sewing — 16 Aug" },
        { "value": "sewing-jacqui", "label": "Beginners Sewing | Jacqui Sundelson" }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 16,
      "max": 80,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 80,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [{ "name": "Class Info" }]
}
{% endschema %}
