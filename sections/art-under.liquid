{%- comment -%}
  Art under R… — budget-friendly artwork, filled automatically from the
  art-under smart collection (any artwork with a variant priced below the
  limit; classes/workshops/gift cards excluded by the collection rules).
  The price limit + wording are managed from the SA Art Fair admin app
  ("Art Under" tab → shop metafield booking_app.art_under, json); blank
  app fields fall back to the theme-editor settings, then automatic copy.
  Desktop: editorial 4-up grid. Mobile: app-style swipe carousel with a
  progress line and a full-width shop-all pill.
{%- endcomment -%}

{%- assign au_cfg = shop.metafields.booking_app.art_under.value -%}
{%- assign au_label = au_cfg.thresholdLabel | default: 'R5 000' -%}

{%- assign au_eyebrow = section.settings.eyebrow | default: 'START YOUR COLLECTION' -%}
{%- assign au_heading = section.settings.heading -%}
{%- assign au_button  = section.settings.button_label -%}
{%- if au_cfg.eyebrow != blank -%}{%- assign au_eyebrow = au_cfg.eyebrow -%}{%- endif -%}
{%- if au_cfg.heading != blank -%}{%- assign au_heading = au_cfg.heading -%}{%- endif -%}
{%- if au_cfg.buttonLabel != blank -%}{%- assign au_button = au_cfg.buttonLabel -%}{%- endif -%}
{%- if au_heading == blank -%}{%- assign au_heading = 'Art under ' | append: au_label -%}{%- endif -%}
{%- if au_button == blank -%}{%- assign au_button = 'Shop all under ' | append: au_label -%}{%- endif -%}

{%- assign au_col = collections['art-under'] -%}
{%- assign au_limit = section.settings.product_limit | default: 8 -%}

{% style %}
  .hau-section {
    background: #f5ece6;
    padding: clamp(56px, 8vh, 96px) 0;
  }
  .hau-container {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(24px, 4vw, 48px);
  }
  .hau-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: clamp(28px, 4.5vh, 44px);
    gap: 20px;
  }
  .hau-eyebrow {
    font-family: var(--font-body-family);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #a35536;
    margin: 0 0 10px;
  }
  .hau-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    font-weight: 700;
    color: #1d1c21;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.015em;
  }
  .hau-view-all {
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 700;
    color: #a35536;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-bottom: 1px solid rgba(163,85,54,0.3);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .hau-view-all:hover { color: #1d1c21; border-color: #1d1c21; }

  .hau-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(18px, 2vw, 24px);
  }

  .hau-card { min-width: 0; }

  .hau-card__img-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 6px;
    background: #ece0d6;
    margin-bottom: 14px;
    isolation: isolate; /* keeps the heart/badges from escaping under the header */
  }
  .hau-card__img-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hau-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s ease;
  }
  .hau-card:hover .hau-card__img { transform: scale(1.04); }
  .hau-card--sold .hau-card__img { filter: grayscale(0.2) brightness(0.92); }
  .hau-card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, #ece0d6 0%, #ddcdbf 100%);
  }

  .hau-card__title {
    font-family: var(--font-heading-family);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 5px;
  }
  .hau-card__title a {
    color: #1d1c21;
    text-decoration: none;
    transition: color 0.2s;
  }
  .hau-card__title a:hover { color: #a35536; }

  .hau-card__meta {
    font-family: var(--font-body-family);
    font-size: 0.78rem;
    color: #85796c;
    line-height: 1.5;
    margin: 0 0 9px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hau-card__meta-dot {
    display: inline-block;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #85796c;
    vertical-align: middle;
    margin: 0 5px 2px;
  }
  .hau-card__price {
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    font-weight: 700;
    color: #1d1c21;
    margin: 0;
  }
  .hau-card__price--sold { color: #85796c; font-weight: 400; }

  .hau-progress { display: none; }
  .hau-button { display: none; }

  .hau-empty {
    font-family: var(--font-body-family);
    font-size: 1rem;
    color: #6b6460;
    font-style: italic;
    padding: 8px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hau-card__img, .hau-view-all, .hau-button { transition: none; }
  }

  @media (max-width: 1100px) {
    .hau-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* ── Mobile: app-style swipe carousel — one and a half cards, a progress
        line, and a full-width shop-all pill ── */
  @media (max-width: 749px) {
    .hau-section { padding: 56px 0 60px; }
    .hau-container { padding-inline: 24px; }
    .hau-header { margin-bottom: 22px; }
    .hau-view-all { display: none; }
    .hau-eyebrow { margin-bottom: 6px; }

    .hau-grid {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      margin-inline: -24px;
      padding-inline: 24px;
      scroll-padding-inline: 24px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .hau-grid::-webkit-scrollbar { display: none; }
    .hau-card {
      flex: 0 0 58%;
      max-width: 58%;
      scroll-snap-align: start;
    }
    .hau-card:hover .hau-card__img { transform: none; }
    .hau-card__title { font-size: 0.98rem; }
    .hau-card__meta { margin-bottom: 6px; }

    .hau-progress {
      display: block;
      position: relative;
      height: 1px;
      margin-top: 18px;
      background: rgba(29,28,33,0.14);
    }
    .hau-progress__fill {
      position: absolute;
      top: -0.5px;
      left: 0;
      height: 2px;
      width: 25%;
      background: #a35536;
      transition: width 0.15s ease, transform 0.15s ease;
      will-change: transform;
    }

    .hau-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 18px;
      width: 100%;
      padding: 13px 20px;
      border: 1px solid rgba(29,28,33,0.35);
      border-radius: 999px;
      font-family: var(--font-body-family);
      font-size: 0.74rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #1d1c21;
      text-decoration: none;
      transition: border-color 0.25s ease, color 0.25s ease;
    }
    .hau-button:hover { border-color: #a35536; color: #a35536; }
    .hau-button svg { width: 14px; height: 14px; }
  }
{% endstyle %}

{%- assign au_show = false -%}
{%- if au_col.products_count > 0 -%}{%- assign au_show = true -%}{%- endif -%}
{%- if request.design_mode -%}{%- assign au_show = true -%}{%- endif -%}
{%- if au_show -%}
<section class="hau-section">
  <div class="hau-container" data-hau>
    <div class="hau-header">
      <div>
        <p class="hau-eyebrow">{{ au_eyebrow }}</p>
        <h2 class="hau-heading">{{ au_heading }}</h2>
      </div>
      <a href="{{ routes.collections_url }}/art-under" class="hau-view-all">
        {{ au_button }} &rarr;
      </a>
    </div>

    {%- if au_col.products_count > 0 -%}
      <div class="hau-grid" data-hau-track>
        {%- for product in au_col.products limit: au_limit -%}
          {%- assign is_sold = false -%}
          {%- unless product.available -%}{%- assign is_sold = true -%}{%- endunless -%}

          <div class="hau-card{% if is_sold %} hau-card--sold{% endif %}">
            <div class="hau-card__img-wrap">
              <a class="hau-card__img-link" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                {%- if product.featured_image -%}
                  {%- assign hau_alt = product.featured_image.alt | default: product.title -%}
                  {{ product.featured_image
                      | image_url: width: 600
                      | image_tag:
                          class: 'hau-card__img',
                          loading: 'lazy',
                          decoding: 'async',
                          widths: '400, 600, 900',
                          sizes: '(max-width: 749px) 58vw, 25vw',
                          alt: hau_alt }}
                {%- else -%}
                  <div class="hau-card__placeholder"></div>
                {%- endif -%}
              </a>
              {%- unless is_sold -%}
                <button type="button" class="saf-wishlist-toggle"
                  data-product-id="{{ product.id }}"
                  data-product-handle="{{ product.handle }}"
                  aria-label="Save {{ product.title | escape }} to wishlist"
                  aria-pressed="false">
                  <span class="svg-wrapper">{{ 'icon-heart.svg' | inline_asset_content }}</span>
                </button>
              {%- endunless -%}
              {%- if is_sold -%}<span class="saf-sold-badge">Sold</span>{%- endif -%}
              {%- if product.tags contains 'dummy' -%}
                <span class="saf-dummy-badge">&#9679; Placeholder</span>
              {%- endif -%}
            </div>

            <h3 class="hau-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            {%- if product.vendor != blank or product.type != blank -%}
              <p class="hau-card__meta">
                {%- if product.vendor != blank -%}{{ product.vendor }}{%- endif -%}
                {%- if product.vendor != blank and product.type != blank -%}
                  <span class="hau-card__meta-dot"></span>
                {%- endif -%}
                {%- if product.type != blank -%}{{ product.type }}{%- endif -%}
              </p>
            {%- endif -%}
            {%- if is_sold -%}
              <p class="hau-card__price hau-card__price--sold">{{ product.price | money_without_trailing_zeros }} (SOLD)</p>
            {%- elsif product.price > 0 -%}
              <p class="hau-card__price">
                {%- if product.price_varies -%}From {% endif -%}
                {{ product.price_min | money_without_trailing_zeros }}
              </p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="hau-progress" aria-hidden="true"><span class="hau-progress__fill"></span></div>
      <a class="hau-button" href="{{ routes.collections_url }}/art-under">
        {{ au_button }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
    {%- else -%}
      <p class="hau-empty">Artwork priced under {{ au_label }} appears here automatically — nothing qualifies just yet.</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    function initHau(scope) {
      (scope || document).querySelectorAll('[data-hau]').forEach(function (root) {
        if (root.dataset.hauBound) return;
        root.dataset.hauBound = '1';
        var track = root.querySelector('[data-hau-track]');
        var fill  = root.querySelector('.hau-progress__fill');
        if (!track || !fill) return;
        var count = track.children.length;
        var ticking = false;
        function paint() {
          ticking = false;
          var max = track.scrollWidth - track.clientWidth;
          if (max <= 0 || !count) return;
          var seg = 100 / count;
          fill.style.width = seg + '%';
          fill.style.transform = 'translateX(' + (track.scrollLeft / max) * (100 / seg - 1) * 100 + '%)';
        }
        track.addEventListener('scroll', function () {
          if (!ticking) { ticking = true; requestAnimationFrame(paint); }
        }, { passive: true });
        paint();
      });
    }
    initHau();
    document.addEventListener('shopify:section:load', function (e) { initHau(e.target); });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Art under R…",
  "settings": [
    { "type": "paragraph", "content": "Filled automatically with artwork priced under the limit. The limit and wording are managed in the SA Art Fair admin app (Art Under tab) — values set there override these settings." },
    { "type": "text",  "id": "eyebrow",       "label": "Eyebrow", "default": "START YOUR COLLECTION" },
    { "type": "text",  "id": "heading",       "label": "Heading", "info": "Leave blank for automatic wording, e.g. Art under R5 000" },
    { "type": "text",  "id": "button_label",  "label": "Shop-all link text", "info": "Leave blank for automatic wording" },
    { "type": "range", "id": "product_limit", "label": "Number of artworks", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Art under R…" }]
}
{% endschema %}
