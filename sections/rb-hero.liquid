{% comment %}
  Rebrand hero — full-bleed photograph with the circled protea centred on it.
  Comp: 1920 x 849 band (2.26:1) directly under a 170px header.

  Two heading treatments. "statement" is the home page's sentence-sized
  IvyPresto. "page title" is the big letterspaced uppercase lockup the Store
  and Studio pages wear under the mark — solved off both comps at 120px on a
  1920 frame with 0.03em tracking. Each of those pages also swaps the protea
  inside the circle for its own, which is why the mark is a picker.
{% endcomment %}

{{ 'saf-rebrand.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign img = section.settings.image

  comment
    One template serves every unsuffixed collection, so the page-title lockup
    has to be able to name the page it is actually on. Off by default: the home
    page's heading is deliberately empty and the mark carries the hero alone.
  endcomment
  assign heading = section.settings.heading
  if heading == blank and section.settings.auto_heading
    assign heading = collection.title | default: page.title
  endif

  case section.settings.mark
    when 'store'
      assign mark_src = 'saf-mark-circle-store.png'
    when 'studio'
      assign mark_src = 'saf-mark-circle-studio.png'
    else
      assign mark_src = 'saf-mark-circle-white.png'
  endcase
-%}

<style>
  #shopify-section-{{ sid }} .rb-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 1920 / {{ section.settings.band_height }};
    min-height: {{ section.settings.min_height }}px;
    overflow: hidden;
    {%- if section.settings.fill == 'colour' -%}
      background: {{ section.settings.background }};
      --rb-paper-strength: {{ section.settings.texture | divided_by: 100.0 }};
    {%- else -%}
      background: var(--rb-ink);
    {%- endif -%}
  }
  #shopify-section-{{ sid }} .rb-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%;
  }
  #shopify-section-{{ sid }} .rb-hero__overlay {
    /* explicit display: Dawn's base.css hides every `div:empty`, and these
       decorative layers have no children */
    display: block;
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  #shopify-section-{{ sid }} .rb-hero__inner {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 2.08vw, 40px);
    text-align: center;
    padding: var(--rb-gutter);
    box-sizing: border-box;
  }
  #shopify-section-{{ sid }} .rb-hero__mark {
    display: block;
    width: clamp({{ section.settings.mark_width | divided_by: 2 }}px, {{ section.settings.mark_width | times: 100.0 | divided_by: 1920.0 }}vw, {{ section.settings.mark_width }}px);
    height: auto;
  }
  #shopify-section-{{ sid }} .rb-hero__heading {
    color: {{ section.settings.text_color }};
    max-width: 20ch;
    text-wrap: balance;
  }
  {%- if section.settings.heading_style == 'page_title' -%}
    /* the page-title lockup sits tight under the mark, not on the hero's
       normal 40px rhythm */
    #shopify-section-{{ sid }} .rb-hero__inner { gap: clamp(6px, 0.63vw, 12px); }
    #shopify-section-{{ sid }} .rb-hero__heading { max-width: none; }
  {%- endif -%}
  #shopify-section-{{ sid }} .rb-hero__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ sid }} .rb-hero {
      aspect-ratio: {{ section.settings.mobile_ratio }};
    }
  }
</style>

<div class="rb-section rb-bleed">
  <div class="rb-hero{% if section.settings.fill == 'colour' %} rb-paper{% endif %}">
    {%- if section.settings.fill == 'colour' -%}
      {%- comment -%}
        Colour band. The paper texture carries it on its own, which is the
        comp — but a picked image now paints behind that texture instead of
        being thrown away, so a coloured hero can take a photograph or a flat
        graphic without leaving the brand surface. The band's own focal point
        and overlay settings drive it, so there is only ever one image picker
        on this section.

        "How the image meets the band colour" is the Figma layer's blend mode.
        Hanre's frames are a coloured rectangle with a near-black crumpled-paper
        photograph SCREENED over it — pick Screen there and the band colour is
        what you set, lifted by the paper's folds, instead of being buried under
        an opaque photo.
      {%- endcomment -%}
      {%- render 'rb-panel-image',
        image: img,
        focal_x: section.settings.focal_x,
        focal_y: section.settings.focal_y,
        blend: section.settings.image_blend,
        rotate: section.settings.image_rotate,
        veil: section.settings.overlay_color,
        veil_opacity: section.settings.overlay_opacity,
        sizes: '100vw',
        widths: '750, 1100, 1500, 1920, 2400, 3000',
        width: 2400
      -%}
    {%- elsif img != blank -%}
      {{
        img
        | image_url: width: 3840
        | image_tag:
          class: 'rb-hero__img',
          widths: '750, 1100, 1500, 1920, 2400, 3000, 3840',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: img.alt | default: shop.name
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'rb-hero__placeholder placeholder-svg' }}
    {%- endif -%}

    {%- if section.settings.overlay_opacity > 0 and section.settings.fill != 'colour' -%}
      <div class="rb-hero__overlay" aria-hidden="true"></div>
    {%- endif -%}

    <div class="rb-hero__inner">
      {%- if section.settings.show_mark -%}
        <img
          src="{{ mark_src | asset_url }}"
          alt=""
          width="398"
          height="398"
          class="rb-hero__mark"
          loading="eager"
        >
      {%- endif -%}

      {%- if heading != blank -%}
        {%- if section.settings.heading_style == 'page_title' -%}
          <h1 class="rb-page-title rb-hero__heading">{{ heading }}</h1>
        {%- else -%}
          <div class="rb-display rb-hero__heading">{{ heading }}</div>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="rb-btn rb-btn--white"
        >{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rebrand hero",
  "tag": "section",
  "class": "rb-section-wrapper",
  "settings": [
    { "type": "select", "id": "fill", "label": "Band fill", "default": "image",
      "options": [
        { "value": "image", "label": "Photograph" },
        { "value": "colour", "label": "Coloured paper (artists page)" }
      ] },
    { "type": "color", "id": "background", "default": "#505a43", "label": "Band colour",
      "info": "Used when the fill is coloured paper." },
    { "type": "range", "id": "texture", "min": 0, "max": 100, "step": 5,
      "default": 100, "unit": "%", "label": "Crumpled paper texture" },
    { "type": "image_picker", "id": "image", "label": "Background image",
      "info": "Comp uses a 1920x883 photograph of a paint palette. On a coloured-paper band it paints behind the crumpled texture, over the band colour — leave it empty there for a plain coloured band." },
    { "type": "select", "id": "image_blend", "default": "normal",
      "label": "How the image meets the band colour",
      "info": "Only applies on a coloured-paper band. Screen is the Figma setting for a dark crumpled-paper photograph: the band colour stays and the paper's folds lift out of it. Drop the crumpled paper texture to 0% when you do that, or the theme's own texture doubles up on it.",
      "options": [
        { "value": "normal", "label": "Image covers the colour" },
        { "value": "screen", "label": "Screen — colour through a dark image" },
        { "value": "multiply", "label": "Multiply — colour through a light image" },
        { "value": "soft-light", "label": "Soft light — image as faint grain" },
        { "value": "luminosity", "label": "Luminosity — image's shading, band's hue" }
      ] },
    { "type": "select", "id": "image_rotate", "default": "0",
      "label": "Rotate the image",
      "info": "The comps turn the portrait paper texture a quarter, so the band shows a strip across the sheet's width. Figma's 90° is 270° here — Figma counts anticlockwise, CSS clockwise.",
      "options": [
        { "value": "0", "label": "None" },
        { "value": "90", "label": "90° clockwise" },
        { "value": "180", "label": "180°" },
        { "value": "270", "label": "90° anticlockwise (Figma 90°)" }
      ] },
    { "type": "range", "id": "band_height", "min": 300, "max": 1100, "step": 10,
      "default": 850, "unit": "px", "label": "Band height at 1920px wide",
      "info": "Sets the aspect ratio, so the band scales with the viewport." },
    { "type": "range", "id": "min_height", "min": 240, "max": 700, "step": 10,
      "default": 380, "unit": "px", "label": "Minimum height" },
    { "type": "text", "id": "mobile_ratio", "default": "4 / 5",
      "label": "Mobile aspect ratio", "info": "CSS aspect-ratio, e.g. 4 / 5." },
    { "type": "range", "id": "focal_x", "min": 0, "max": 100, "step": 1,
      "default": 50, "unit": "%", "label": "Image focal point — horizontal" },
    { "type": "range", "id": "focal_y", "min": 0, "max": 100, "step": 1,
      "default": 50, "unit": "%", "label": "Image focal point — vertical" },
    { "type": "header", "content": "Overlay" },
    { "type": "color", "id": "overlay_color", "default": "#1e1e1e", "label": "Overlay colour" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5,
      "default": 0, "unit": "%", "label": "Overlay opacity" },
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_mark", "default": true,
      "label": "Show circled protea mark" },
    { "type": "select", "id": "mark", "label": "Which protea", "default": "saaf",
      "options": [
        { "value": "saaf", "label": "SA Art Fair" },
        { "value": "store", "label": "The Store (sheaf protea)" },
        { "value": "studio", "label": "The Studio (pom protea)" }
      ] },
    { "type": "range", "id": "mark_width", "min": 90, "max": 420, "step": 5,
      "default": 340, "unit": "px", "label": "Mark width at 1920px wide" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading",
      "info": "Comp leaves this empty on the home page — the mark carries the hero on its own." },
    { "type": "checkbox", "id": "auto_heading", "default": false,
      "label": "Use the collection or page name when the heading is empty",
      "info": "For the shared collection template, so each collection titles its own hero." },
    { "type": "select", "id": "heading_style", "label": "Heading style", "default": "statement",
      "options": [
        { "value": "statement", "label": "Statement sentence (home page)" },
        { "value": "page_title", "label": "Page title (THE STORE / THE STUDIO)" }
      ] },
    { "type": "color", "id": "text_color", "default": "#ffffff", "label": "Heading colour" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rebrand hero" }]
}
{% endschema %}
