{% comment %}
  Rebrand page nav — a slim bar of sibling links.

  Bianca's brief: "When we click into a workshop or class, can we have the
  navigation bar showing options (class / workshops / Meet the teachers /
  contact)". A class page is a dead end otherwise: you arrive from an ad or a
  share link and the only way sideways is the burger.

  Not in the Figma, so it is built to disappear into it — hairline rules,
  the sans caps eyebrow size already used for section labels, no fill. Any
  link that matches the page you are on marks itself current instead of
  pretending to go somewhere.

  Scrolls horizontally on a phone rather than wrapping to two ragged rows.

  A "Gallery" block (2026-09-11) opens the class teacher's photos and videos
  full-screen instead of going anywhere. It only appears on a class page whose
  teacher has a gallery — see snippets/rb-gallery.liquid — so the same block
  can sit in every class template and on the FAQ page without ever showing a
  dead link.

  An "Artwork by …" item (2026-09-18) is added by this section rather than by a
  block, for the same reason the Gallery tab hides itself: it is only true of
  some class pages. It appears when the class's teacher also sells work here,
  and is absent everywhere else — including /pages/faq, which has no product in
  scope and never reaches the lookup at all.
{% endcomment %}

{{ 'saf-rebrand.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Ask the catalogue once, and only on a class page. `product` is nil on
  /pages/faq and on every collection page this bar also sits on, so both tests
  below fail there and the snippet is never rendered.
{%- endcomment -%}
{%- capture pnav_artist -%}
  {%- if section.settings.show_artwork_tab and product.type == 'Class' -%}
    {%- render 'rb-artist-collection',
      teacher_name: product.metafields.booking.instructor_name,
      product: product
    -%}
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  assign sid = section.id
  assign here = request.path | downcase

  assign pnav_artist = pnav_artist | strip
  assign pnav_art_url = ''
  assign pnav_art_label = ''
  assign show_art = false

  if pnav_artist != blank
    assign pnav_art_url = pnav_artist | split: '|' | first
    assign pnav_art_name = pnav_artist | split: '|' | last

    comment
      The label is a setting so it can be retyped, with {{ first_name }} left
      in it as a stand-in for whoever this class belongs to — one label, every
      class. The name comes from the artist collection rather than from the
      class credit because the two disagree: the class says "Zara Farinha",
      her work is filed under "Zara-Leigh Farinha", and the tab is pointing at
      the work.
    endcomment
    assign pnav_first = pnav_art_name | split: ' ' | first
    assign pnav_art_label = section.settings.artwork_tab_label | default: 'Artwork by {{ first_name }}'
    assign pnav_art_label = pnav_art_label | replace: '{{ first_name }}', pnav_first | replace: '{{first_name}}', pnav_first | strip

    if pnav_art_url != blank and pnav_art_label != blank
      assign show_art = true
    endif
  endif
-%}

<style>
  #shopify-section-{{ sid }} .rb-pnav {
    background: {{ section.settings.background }};
    border-top: 1px solid {{ section.settings.rule_color }};
    border-bottom: 1px solid {{ section.settings.rule_color }};
  }
  #shopify-section-{{ sid }} .rb-pnav__scroll {
    /* a phone gets a swipeable row; the page body must never scroll sideways */
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  #shopify-section-{{ sid }} .rb-pnav__scroll::-webkit-scrollbar { display: none; }

  #shopify-section-{{ sid }} .rb-pnav__list {
    list-style: none;
    margin: 0 auto;
    padding: clamp(12px, 1.15vw, 22px) var(--rb-gutter);
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.align }};
    gap: clamp(18px, 2.4vw, 46px);
    width: max-content;
    min-width: 100%;
    box-sizing: border-box;
  }
  #shopify-section-{{ sid }} .rb-pnav__list a,
  #shopify-section-{{ sid }} .rb-pnav__list button {
    display: block;
    white-space: nowrap;
    color: {{ section.settings.text_color }};
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-caps);
    line-height: inherit;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0 0 3px;
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    background: none;
    cursor: pointer;
  }
  #shopify-section-{{ sid }} .rb-pnav__list .rb-pnav__off {
    opacity: 0.4;
    cursor: default;
  }
  #shopify-section-{{ sid }} .rb-pnav__list button:hover,
  #shopify-section-{{ sid }} .rb-pnav__list button:focus-visible,
  #shopify-section-{{ sid }} .rb-pnav__list a:hover,
  #shopify-section-{{ sid }} .rb-pnav__list a:focus-visible {
    color: {{ section.settings.accent_color }};
    border-bottom-color: currentColor;
  }
  #shopify-section-{{ sid }} .rb-pnav__list a[aria-current] {
    color: {{ section.settings.accent_color }};
    border-bottom-color: currentColor;
  }
</style>

<nav class="rb-section rb-pnav" aria-label="{{ section.settings.aria_label | default: 'Section navigation' | escape }}">
  <div class="rb-pnav__scroll">
    <ul class="rb-pnav__list" role="list">
      {%- for block in section.blocks -%}
        {%- comment -%}
          Sits before the last block, which is how the Gallery tab ends up
          second from the end too — Contact is always the item that closes the
          bar. Rendered here rather than as a block because whether it exists
          is a fact about the class, not something to be set per template, and
          because max_blocks is full at 8.
        {%- endcomment -%}
        {%- if show_art and forloop.last -%}
          <li>
            <a href="{{ pnav_art_url }}">{{ pnav_art_label | escape }}</a>
          </li>
          {%- assign show_art = false -%}
        {%- endif -%}
        {%- if block.type == 'gallery' -%}
          {%- comment -%}
            Ships HIDDEN. Whether this class has a gallery is decided once, by
            sections/rb-class-gallery.liquid (the class's own pictures, else its
            teacher's, else none) — and a section cannot read another section's
            variables, so asking the question again here would be a second
            answer free to disagree with the lightbox. assets/rb-gallery.js
            unhides this item only when that section has printed a gallery, so a
            class without one never shows a tab.
          {%- endcomment -%}
          <li {{ block.shopify_attributes }} data-rb-gallery-tab hidden>
            <button type="button" data-rb-gallery-open aria-haspopup="dialog">
              {{- block.settings.label | default: 'Gallery' | escape -}}
            </button>
          </li>
          {%- continue -%}
        {%- endif -%}
        {%- liquid
          assign to = block.settings.link | default: '#'
          assign to_path = to | split: '?' | first | downcase
          assign is_here = false
          if to_path != '' and to_path != '#' and here == to_path
            assign is_here = true
          endif
        -%}
        {%- if block.settings.label != blank -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ to }}" {% if is_here %}aria-current="page"{% endif %}>
              {{- block.settings.label | escape -}}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
      {%- comment -%}
        Only reached by a bar with no blocks at all, which no live template has
        — but a bar that has something to say should still say it.
      {%- endcomment -%}
      {%- if show_art -%}
        <li>
          <a href="{{ pnav_art_url }}">{{ pnav_art_label | escape }}</a>
        </li>
      {%- endif -%}
    </ul>
  </div>
</nav>

{% schema %}
{
  "name": "Rebrand page nav",
  "tag": "section",
  "class": "rb-section-wrapper",
  "max_blocks": 8,
  "settings": [
    { "type": "paragraph", "content": "A slim bar of sibling links. Add one block per link; the one matching the current page marks itself." },
    { "type": "text", "id": "aria_label", "label": "Screen-reader name for this bar", "default": "Studio navigation" },
    { "type": "select", "id": "align", "label": "Alignment", "default": "center",
      "options": [
        { "value": "center", "label": "Centred" },
        { "value": "flex-start", "label": "Left" },
        { "value": "space-between", "label": "Spread" }
      ] },
    { "type": "color", "id": "background", "default": "#ffffff", "label": "Background" },
    { "type": "color", "id": "text_color", "default": "#1e1e1e", "label": "Text" },
    { "type": "color", "id": "accent_color", "default": "#b00e3f", "label": "Hover + current" },
    { "type": "color", "id": "rule_color", "default": "#e0e0e0", "label": "Rules" },
    { "type": "header", "content": "Artwork tab" },
    { "type": "checkbox", "id": "show_artwork_tab", "default": true,
      "label": "Link to the teacher's own artwork",
      "info": "On a class page whose teacher also sells work here, adds one more item pointing at her collection. Teachers who do not sell work never show it, and neither does any page without a class on it." },
    { "type": "text", "id": "artwork_tab_label", "default": "Artwork by {{ first_name }}",
      "label": "Artwork tab label",
      "info": "{{ first_name }} is replaced with the teacher's first name, so one label serves every class." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "gallery",
      "name": "Gallery",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Opens the class teacher's photos and videos full-screen. Only shows on class pages whose teacher has a gallery; add photos and videos in the SA Booking Admin Gallery tab." },
        { "type": "text", "id": "label", "label": "Label", "default": "Gallery" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rebrand page nav",
      "blocks": [
        { "type": "link", "settings": { "label": "Classes", "link": "shopify://collections/classes" } },
        { "type": "link", "settings": { "label": "Workshops", "link": "shopify://collections/workshops" } },
        { "type": "link", "settings": { "label": "Meet the Teachers", "link": "/pages/the-team" } },
        { "type": "link", "settings": { "label": "Contact", "link": "/pages/contact" } }
      ]
    }
  ]
}
{% endschema %}
