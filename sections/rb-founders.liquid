{% comment %}
  Rebrand founders band — polaroid on the left with the gold protea stamp
  straddling its right edge, script heading + two justified columns + a signed
  sign-off on the right. Comp: 1920 x 847 content, container 1674.

  The polaroid framing (stacked paper, slight rotation) is baked into the
  supplied PNG, so swapping the image means supplying a photo already framed
  that way.

  2026-09-18 — "Where the words come from" can now be the booking app instead of
  the fields below. On "app" the script line, the sign-off and the polaroid come
  from shop.metafields.booking_app.team.settings (the admin's Team tab → Page
  copy). Anything the app leaves blank keeps using the field below it, and if
  the metafield is missing altogether the band renders exactly as it always has.
{% endcomment %}

{{ 'saf-rebrand.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id

  assign fd_heading = section.settings.heading
  assign fd_signature = section.settings.signature
  assign fd_photo = ''
  if section.settings.data_source == 'app'
    assign fd_team = shop.metafields.booking_app.team.value
    assign fd_cfg = fd_team.settings
    if fd_cfg.foundersText != blank
      assign fd_heading = fd_cfg.foundersText
    endif
    if fd_cfg.foundersSignature != blank
      assign fd_signature = fd_cfg.foundersSignature
    endif
    if fd_cfg.foundersImage != blank
      # Shopify writes its own CDN links protocol-relative and the app stores
      # the full https address; the scheme comes off here so this photo is
      # served exactly like every other picture on the page.
      assign fd_photo = fd_cfg.foundersImage | remove_first: 'https:'
    endif
  endif
-%}

<style>
  #shopify-section-{{ sid }} .rb-founders {
    background: {{ section.settings.background }};
    padding-block:
      clamp(56px, 15.47vw, 297px)
      clamp(56px, 10.42vw, 200px);
  }
  #shopify-section-{{ sid }} .rb-founders__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 3.13vw, 60px);
    align-items: center;
  }
  #shopify-section-{{ sid }} .rb-founders__media {
    position: relative;
    justify-self: start;
    width: 100%;
    max-width: {{ section.settings.image_width }}px;
  }
  #shopify-section-{{ sid }} .rb-founders__media img {
    display: block;
    width: 100%;
    height: auto;
  }
  #shopify-section-{{ sid }} .rb-founders__stamp {
    position: absolute;
    top: 50%;
    left: 100%;
    width: {{ section.settings.stamp_width }}px;
    max-width: 37%;
    height: auto;
    /* the stamp overlaps ~1/4 of its own width onto the polaroid's right edge
       in the comp — both PNGs have baked-in transparent margins (the gold
       badge especially, ~7% on its left), so this has to overshoot a plain
       "just touching" value to actually look like an overlap */
    transform: translate(-26%, -50%);
    pointer-events: none;
  }

  /* the comp does not run this column to the full half-width: the script
     measures ~690px and the body pair ~556px on the 1920 frame */
  #shopify-section-{{ sid }} .rb-founders__heading {
    color: {{ section.settings.heading_color }};
    line-height: 1.28;
    max-width: 690px;
  }
  #shopify-section-{{ sid }} .rb-founders__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 2.71vw, 52px);
    margin-top: clamp(18px, 2.4vw, 46px);
    max-width: 556px;
  }
  #shopify-section-{{ sid }} .rb-founders__cols .rb-body {
    font-size: var(--rb-fs-body-sm);
    text-align: justify;
    color: {{ section.settings.body_color }};
  }
  #shopify-section-{{ sid }} .rb-founders__cols .rb-body p { margin: 0 0 0.7em; }
  #shopify-section-{{ sid }} .rb-founders__cols .rb-body p:last-child { margin-bottom: 0; }

  #shopify-section-{{ sid }} .rb-founders__sign {
    margin-top: clamp(16px, 2.08vw, 40px);
    font-size: clamp(22px, 1.88vw, 36px);
    color: {{ section.settings.heading_color }};
  }

  @media screen and (max-width: 899px) {
    #shopify-section-{{ sid }} .rb-founders__grid { grid-template-columns: 1fr; }
    #shopify-section-{{ sid }} .rb-founders__media {
      justify-self: center;
      max-width: min(360px, 80%);
      margin-bottom: 12px;
    }
    #shopify-section-{{ sid }} .rb-founders__cols { grid-template-columns: 1fr; }
    #shopify-section-{{ sid }} .rb-founders__cols .rb-body { text-align: left; }
    /* left:100% pushes the stamp past the viewport once the polaroid is
       centred and near-full-width; tuck it back onto the image instead */
    #shopify-section-{{ sid }} .rb-founders__stamp {
      left: auto;
      right: -27%;
      transform: translateY(-50%);
    }
  }
</style>

<div class="rb-section rb-founders">
  <div class="rb-container rb-founders__grid">
    <div class="rb-founders__media">
      {%- if fd_photo != blank -%}
        {%- assign fd_sep = '?' -%}
        {%- if fd_photo contains '?' -%}{%- assign fd_sep = '&' -%}{%- endif -%}
        {{
          fd_photo
          | append: fd_sep
          | append: 'width=1200'
          | image_tag:
            widths: '360, 480, 700, 940, 1200',
            sizes: '(max-width: 899px) 80vw, 30vw',
            loading: 'lazy',
            alt: fd_signature
        }}
      {%- elsif section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            widths: '360, 480, 700, 940, 1200',
            sizes: '(max-width: 899px) 80vw, 30vw',
            loading: 'lazy',
            alt: section.settings.image.alt | default: section.settings.signature
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

      {%- if section.settings.show_stamp -%}
        {%- assign fd_stamp = 'saf-stamp-gold.png' | asset_url -%}
        {%- if section.settings.data_source == 'app' and fd_cfg.foundersStampImage != blank -%}
          {%- assign fd_stamp = fd_cfg.foundersStampImage | remove_first: 'https:' -%}
        {%- endif -%}
        <img
          src="{{ fd_stamp }}"
          alt=""
          width="329"
          height="336"
          class="rb-founders__stamp"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <div class="rb-founders__text">
      {%- if fd_heading != blank -%}
        <h2 class="rb-script rb-founders__heading">{{ fd_heading | escape }}</h2>
      {%- endif -%}

      <div class="rb-founders__cols">
        {%- if section.settings.column_one != blank -%}
          <div class="rb-body">{{ section.settings.column_one }}</div>
        {%- endif -%}
        {%- if section.settings.column_two != blank -%}
          <div class="rb-body">{{ section.settings.column_two }}</div>
        {%- endif -%}
      </div>

      {%- if fd_signature != blank -%}
        <p class="rb-script rb-founders__sign">{{ fd_signature | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rebrand founders",
  "tag": "section",
  "class": "rb-section-wrapper",
  "settings": [
    { "type": "select", "id": "data_source", "label": "Where the words come from", "default": "blocks",
      "options": [
        { "value": "blocks", "label": "The fields below (theme editor)" },
        { "value": "app", "label": "The booking app’s Team tab" }
      ],
      "info": "“The booking app” reads the script line, the sign-off and the photo from the Team tab’s Page copy. Anything left blank there keeps using the field below." },
    { "type": "image_picker", "id": "image", "label": "Polaroid image",
      "info": "The polaroid frame is part of the supplied artwork, not a CSS effect." },
    { "type": "range", "id": "image_width", "min": 280, "max": 700, "step": 5,
      "default": 475, "unit": "px", "label": "Polaroid width at 1920px wide" },
    { "type": "checkbox", "id": "show_stamp", "default": true, "label": "Show gold protea stamp" },
    { "type": "range", "id": "stamp_width", "min": 80, "max": 320, "step": 5,
      "default": 175, "unit": "px", "label": "Stamp width at 1920px wide" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod.",
      "label": "Script heading" },
    { "type": "color", "id": "heading_color", "default": "#b00e3f", "label": "Script colour" },
    { "type": "richtext", "id": "column_one",
      "default": "<p>Tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut eu fugiat nulla pariatur..</p>",
      "label": "Body column 1" },
    { "type": "richtext", "id": "column_two",
      "default": "<p>Aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore</p>",
      "label": "Body column 2" },
    { "type": "color", "id": "body_color", "default": "#1e1e1e", "label": "Body colour" },
    { "type": "text", "id": "signature", "default": "– Bianca & Georgina", "label": "Signature" },
    { "type": "color", "id": "background", "default": "#ffffff", "label": "Background" }
  ],
  "presets": [{ "name": "Rebrand founders" }]
}
{% endschema %}
