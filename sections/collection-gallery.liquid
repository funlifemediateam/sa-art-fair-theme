{% style %}
  .cgal-section {
    background: #f7f3ef;
    padding: 0 0 80px;
  }

  /* ── Header ── */
  .cgal-header {
    background: #0f4a52;
    height: 380px;
    padding: 40px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .cgal-eyebrow {
    font-family: var(--font-body-family);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #d2d241;
    margin: 0 0 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }
  .cgal-eyebrow::before,
  .cgal-eyebrow::after {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: rgba(242,107,82,0.65);
    flex-shrink: 0;
  }
  .cgal-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 700;
    color: #eeefeb;
    margin: 0 0 22px;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .cgal-description {
    font-family: var(--font-body-family);
    font-size: 1rem;
    color: rgba(238,239,235,0.55);
    max-width: 460px;
    margin: 0 auto;
    line-height: 1.85;
  }

  /* ── Controls bar ── */
  .cgal-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1400px;
    margin: 0 auto;
    padding: 28px 40px 20px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cgal-count {
    font-family: var(--font-body-family);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: rgba(29,28,33,0.5);
    text-transform: uppercase;
  }

  /* ── Masonry grid ── */
  .cgal-grid {
    columns: 4;
    column-gap: 3px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .cgal-item {
    break-inside: avoid;
    margin-bottom: 3px;
    display: block;
    position: relative;
    overflow: hidden;
    background: #e8e0d8;
    cursor: pointer;
  }
  .cgal-item img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .cgal-item:hover img {
    transform: scale(1.05);
  }
  .cgal-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20,20,24,0.78) 0%, rgba(20,20,24,0) 55%);
    opacity: 0;
    transition: opacity 0.35s ease;
    display: flex;
    align-items: flex-end;
    padding: 22px 20px;
  }
  .cgal-item:hover .cgal-overlay {
    opacity: 1;
  }
  .cgal-info {
    color: #eeefeb;
    transform: translateY(8px);
    transition: transform 0.35s ease;
  }
  .cgal-item:hover .cgal-info {
    transform: translateY(0);
  }
  .cgal-title {
    font-family: var(--font-heading-family);
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .cgal-price {
    font-family: var(--font-body-family);
    font-size: 0.78rem;
    font-weight: 500;
    color: rgba(238,239,235,0.75);
    margin: 0;
  }
  .cgal-sold-badge {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #d2d241;
    border: 1px solid rgba(210,210,65,0.6);
    border-radius: 2px;
    padding: 2px 7px;
    margin-top: 5px;
  }

  /* ── Empty state ── */
  .cgal-empty {
    text-align: center;
    padding: 80px 40px;
    font-family: var(--font-body-family);
    color: rgba(29,28,33,0.45);
    font-size: 1rem;
    font-style: italic;
  }

  /* ── Pagination ── */
  .cgal-pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 48px;
    padding: 0 40px;
    flex-wrap: wrap;
  }
  .cgal-pagination a,
  .cgal-pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 42px;
    padding: 0 14px;
    border: 1px solid rgba(29,28,33,0.2);
    border-radius: 3px;
    font-family: var(--font-body-family);
    font-size: 0.82rem;
    font-weight: 500;
    color: #1d1c21;
    text-decoration: none;
    transition: border-color 0.18s, background 0.18s, color 0.18s;
  }
  .cgal-pagination a:hover {
    border-color: #18727d;
    color: #18727d;
  }
  .cgal-pagination .current {
    background: #0f4a52;
    border-color: #1d1c21;
    color: #eeefeb;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .cgal-grid { columns: 3; }
  }
  @media (max-width: 749px) {
    .cgal-grid { columns: 2; column-gap: 2px; padding: 0 16px; }
    .cgal-header { height: 280px; padding: 32px 20px; }
    .cgal-controls { padding: 20px 16px 12px; }
    .cgal-overlay { padding: 14px 12px; }
    .cgal-title { font-size: 0.82rem; }
  }
  @media (max-width: 479px) {
    .cgal-grid { columns: 1; }
  }
{% endstyle %}

<div class="cgal-section">

  <div class="cgal-header">
    <p class="cgal-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="cgal-heading">{{ collection.title }}</h1>
    <p class="cgal-description">{{ section.settings.intro }}</p>
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}

    <div class="cgal-controls">
      <p class="cgal-count">{{ collection.products_count }} work{% if collection.products_count != 1 %}s{% endif %}</p>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="cgal-grid">
        {%- for product in collection.products -%}
          <a href="{{ product.url }}" class="cgal-item">
            {%- if product.featured_image -%}
              {%- assign alt_text = product.title | escape -%}
              {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: alt_text }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            {%- if product.tags contains 'dummy' -%}
              <span class="saf-dummy-badge">&#9679; Placeholder</span>
            {%- endif -%}
            {%- unless product.available -%}
              <span class="saf-sold-badge">Sold</span>
            {%- endunless -%}
            <div class="cgal-overlay">
              <div class="cgal-info">
                <p class="cgal-title">{{ product.title }}</p>
                <p class="cgal-price">{{ product.price | money }}</p>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="cgal-pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}">&larr;</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}">&rarr;</a>
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- else -%}
      <p class="cgal-empty">No works in this collection yet.</p>
    {%- endif -%}

  {%- endpaginate -%}

</div>

{% schema %}
{
  "name": "Gallery Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SA Art Fair"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Original paintings, prints, and mixed media by our resident Hout Bay artists — each piece made in the studio and available to collect."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 4,
      "label": "Works per page",
      "default": 24
    }
  ],
  "presets": [{ "name": "Gallery Grid" }]
}
{% endschema %}
