{% comment %}
  Rebrand people grid — the Studio page's "Meet our teachers" wall: a full-colour
  portrait over a coloured caption panel carrying the name, a role line and a
  ghost pill.

  The comp alternates the panel between cherry and coral across the wall
  without a strict pattern, so each card can be pinned to either colour and
  "Auto" just alternates by position.

  Each card reads from a collection (that is how teachers are modelled in this
  store) and every field can be overridden per card.

  2026-09-18 — "Where the people come from" can now be the booking app instead
  of these blocks. On "app" the wall is drawn from shop.metafields.booking_app.team
  (the admin's Team tab): the members of one group, visible ones only, in the
  order the array has them. Everything else — classes, element order, image
  sizing, the tone alternation — is the same markup either way, so this is a
  swap of data and nothing else.

  The blocks stay where they are and are what renders whenever the metafield is
  missing, unreadable, or has nobody to show. That fallback is the whole point:
  the Studio page and every other wall using this section are untouched, and an
  empty save can never empty a page.

  2026-09-18 — "Learn More" skips the middle step. A card pointing at a teacher
  collection that holds exactly one class now points at the class itself, so
  the visitor lands where they were always heading instead of on a page with a
  single tile on it. The card's own href is what gets read, so this works the
  same whether the wall came from the blocks or from the app, and a teacher
  with two classes (Janice) or none keeps her collection — there the collection
  is the useful page.
{% endcomment %}

{{ 'saf-rebrand.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign cols = section.settings.columns

  assign pg_app = false
  assign pg_people = ''
  assign pg_settings = ''
  if section.settings.data_source == 'app'
    assign pg_team = shop.metafields.booking_app.team.value
    if pg_team != blank and pg_team.members != blank
      assign pg_want = section.settings.app_group | default: 'teachers'
      assign pg_rows = pg_team.members | where: 'group', pg_want
      assign pg_n = 0
      for pg_m in pg_rows
        if pg_m.visible
          assign pg_n = pg_n | plus: 1
        endif
      endfor
      if pg_n > 0
        assign pg_app = true
        assign pg_people = pg_rows
        assign pg_settings = pg_team.settings
      endif
    endif
  endif

  assign pg_eyebrow = section.settings.eyebrow
  assign pg_intro = section.settings.intro
  if pg_app
    if pg_settings.teachersHeading != blank
      assign pg_eyebrow = pg_settings.teachersHeading | escape | replace: '&#39;', "'" | prepend: '<p>' | append: '</p>'
    endif
    if pg_settings.teachersIntro != blank
      assign pg_intro = pg_settings.teachersIntro | escape | replace: '&#39;', "'" | prepend: '<p>' | append: '</p>'
    endif
  endif
-%}

{%- comment -%}
  The headings above are escaped because anything reaching a shop metafield is
  data, not markup — but an apostrophe is put back, because "the studio's
  classes" is what the page has always said and &#39; would be a difference in
  the HTML for no difference on screen.
{%- endcomment -%}

<style>
  #shopify-section-{{ sid }} .rb-pg {
    background: {{ section.settings.background }};
    padding-block:
      clamp(48px, 6.25vw, 120px)
      clamp(48px, 7.29vw, 140px);
  }
  #shopify-section-{{ sid }} .rb-pg__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(8px, 0.83vw, 16px);
    text-align: center;
    margin-bottom: clamp(28px, 3.44vw, 66px);
  }
  #shopify-section-{{ sid }} .rb-pg__intro {
    max-width: 42ch;
    font-size: var(--rb-fs-body-sm);
    color: {{ section.settings.intro_color }};
  }
  #shopify-section-{{ sid }} .rb-pg__intro p { margin: 0; }

  #shopify-section-{{ sid }} .rb-pg__grid {
    display: grid;
    grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));
    gap: clamp(14px, 1.35vw, 26px);
  }
  #shopify-section-{{ sid }} .rb-pg__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .rb-pg__media {
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
  }

  #shopify-section-{{ sid }} .rb-pg__panel {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    box-sizing: border-box;
    padding: clamp(12px, 1.15vw, 22px) clamp(12px, 1.25vw, 24px) clamp(14px, 1.35vw, 26px);
    --rb-paper-strength: {{ section.settings.texture | divided_by: 100.0 }};
  }
  #shopify-section-{{ sid }} .rb-pg__name {
    margin: 0;
    font-family: var(--rb-sans);
    font-weight: 700;
    font-size: var(--rb-fs-meta);
    line-height: 1.25;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  #shopify-section-{{ sid }} .rb-pg__role {
    margin: 2px 0 0;
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-meta);
    line-height: 1.3;
  }
  #shopify-section-{{ sid }} .rb-pg__cta {
    align-self: center;
    margin-top: clamp(10px, 1.04vw, 20px);
    min-height: clamp(28px, 1.98vw, 38px);
    padding-inline: clamp(14px, 1.35vw, 26px);
    font-size: clamp(11px, 0.78vw, 15px);
    letter-spacing: 0;
    text-transform: none;
    font-family: var(--rb-serif);
  }

  #shopify-section-{{ sid }} .rb-pg__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(24px, 2.71vw, 52px);
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ sid }} .rb-pg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 519px) {
    #shopify-section-{{ sid }} .rb-pg__grid { grid-template-columns: 1fr; }
  }

  {%- if pg_app -%}
    {%- assign pg_i = 0 -%}
    {%- for pg_m in pg_people -%}
      {%- unless pg_m.visible -%}{%- continue -%}{%- endunless -%}
      {%- liquid
        assign m = pg_i | modulo: 2
        if m == 0
          assign panel_bg = section.settings.tone_a
          assign panel_fg = section.settings.tone_a_text
        else
          assign panel_bg = section.settings.tone_b
          assign panel_fg = section.settings.tone_b_text
        endif
        assign pg_i = pg_i | plus: 1
      -%}
    #shopify-section-{{ sid }} [data-blk="{{ pg_m.id }}"] .rb-pg__panel {
      background: {{ panel_bg }};
      color: {{ panel_fg }};
      /* the veil over a panel background image is this card's own tone, so it
         is declared here rather than passed into the snippet */
      --rb-paper-veil: {{ panel_bg }};
    }
    {%- endfor -%}
  {%- else -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign tone = block.settings.tone
      if tone == 'auto'
        assign m = forloop.index0 | modulo: 2
        if m == 0
          assign tone = 'a'
        else
          assign tone = 'b'
        endif
      endif
      if tone == 'a'
        assign panel_bg = section.settings.tone_a
        assign panel_fg = section.settings.tone_a_text
      else
        assign panel_bg = section.settings.tone_b
        assign panel_fg = section.settings.tone_b_text
      endif
    -%}
    #shopify-section-{{ sid }} [data-blk="{{ block.id }}"] .rb-pg__panel {
      background: {{ panel_bg }};
      color: {{ panel_fg }};
      /* the veil over a panel background image is this card's own tone, so it
         is declared here rather than passed into the snippet */
      --rb-paper-veil: {{ panel_bg }};
    }
  {%- endfor -%}
  {%- endif -%}
</style>

<div class="rb-section rb-pg">
  <div class="rb-container">
    {%- if pg_eyebrow != blank or pg_intro != blank -%}
      <div class="rb-pg__head">
        {%- if pg_eyebrow != blank -%}
          <div class="rb-caps">{{ pg_eyebrow }}</div>
        {%- endif -%}
        {%- if pg_intro != blank -%}
          <div class="rb-body rb-pg__intro">{{ pg_intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="rb-pg__grid">
      {%- if pg_app -%}
      {%- for pg_m in pg_people -%}
        {%- unless pg_m.visible -%}{%- continue -%}{%- endunless -%}
        {%- liquid
          assign name = pg_m.name
          assign url = pg_m.link
          # Straight to the class — see the twin of this in the blocks loop
          # below, and the note at the top of the file.
          if url contains '/collections/'
            assign pg_rest = url | split: '/collections/' | last | split: '?' | first | split: '#' | first
            assign pg_seg = pg_rest | split: '/'
            if pg_seg.size == 1
              assign pg_col = collections[pg_seg.first]
              if pg_col.handle != blank
                assign pg_classes = pg_col.products | where: 'type', 'Class'
                if pg_classes.size == 1
                  assign url = pg_classes.first.url
                endif
              endif
            endif
          endif
          # Shopify writes its own CDN links protocol-relative and the rest of
          # this page is full of them; the app stores the full https address, so
          # the scheme comes off here. escape comes LAST and guards the attribute
          # the address lands in — appending to an already-escaped string escapes
          # the appended part a second time, which is how &amp;amp; happens.
          assign p_base = pg_m.photo | remove_first: 'https:'
          assign p_sep = '?'
          if p_base contains '?'
            assign p_sep = '&'
          endif
          assign p_pre = p_base | append: p_sep | append: 'width=' | escape
          # The stored size, scaled to the 900 wide copy the src asks for, so the
          # space is reserved before the picture lands and nothing shifts.
          # `plus: 0` first: a member saved before sizes were stored has none,
          # and Liquid refuses to compare nil with a number.
          assign photo_w = pg_m.photoW | plus: 0
          assign photo_n = pg_m.photoH | plus: 0
          assign photo_h = 0
          if photo_w > 0 and photo_n > 0
            assign half = photo_w | divided_by: 2
            assign photo_h = photo_n | times: 900 | plus: half | divided_by: photo_w
          endif
        -%}
        {%- comment -%}
          The <img> below is written out by hand. image_tag and image_url both
          refuse a plain URL — they want a Shopify image object, and a member's
          photo is only ever an address — so this reproduces exactly what
          image_tag emits on the blocks path, down to the newline it leaves
          after the tag. That is what keeps the two paths' HTML identical.

          data-blk carries the member's id here and a block id on the blocks
          path. It is a CSS hook for this card's tone and nothing else.
        {%- endcomment -%}
        <div class="rb-pg__card" data-blk="{{ pg_m.id }}" >
          <a href="{{ url | default: '#' }}" class="rb-media rb-pg__media" tabindex="-1" aria-hidden="true">
            {%- if pg_m.photo != blank -%}
              <img src="{{ p_pre }}900" alt="{{ pg_m.alt | escape }}" srcset="{{ p_pre }}260 260w, {{ p_pre }}380 380w, {{ p_pre }}560 560w, {{ p_pre }}900 900w"{% if photo_h > 0 %} width="900" height="{{ photo_h }}"{% endif %} loading="lazy" sizes="(max-width: 519px) 90vw, (max-width: 989px) 45vw, 23vw">
{% else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>

          <div class="rb-pg__panel rb-paper">
            {%- render 'rb-panel-image',
              image: section.settings.panel_image,
              fit: section.settings.panel_image_fit,
              focal_x: section.settings.panel_image_focal_x,
              focal_y: section.settings.panel_image_focal_y,
              veil_opacity: section.settings.panel_image_veil,
              sizes: '(max-width: 519px) 90vw, (max-width: 989px) 45vw, 23vw',
              widths: '260, 380, 560, 900',
              width: 900
            -%}

            {%- if name != blank -%}
              <p class="rb-pg__name">{{ name | escape }}</p>
            {%- endif -%}
            {%- if pg_m.role != blank -%}
              <p class="rb-pg__role">{{ pg_m.role | escape }}</p>
            {%- endif -%}
            {%- if pg_m.linkLabel != blank -%}
              <a href="{{ url | default: '#' }}" class="rb-btn rb-btn--ghost rb-pg__cta">
                {{- pg_m.linkLabel | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
      {%- else -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign name = block.settings.name | default: col.title
          assign img = block.settings.image | default: col.featured_image
          assign url = block.settings.link | default: col.url
          comment
            Straight to the class. Deliberately reads `url` rather than `col`,
            so a card with a hand-typed collection link behaves like one that
            took the collection from the block — and a card pointing anywhere
            else is left alone. Twin of the loop above.
          endcomment
          if url contains '/collections/'
            assign pg_rest = url | split: '/collections/' | last | split: '?' | first | split: '#' | first
            assign pg_seg = pg_rest | split: '/'
            comment
              One segment only. A collection URL ends at the handle; anything
              with a further path on it is a product inside the collection, and
              that is not ours to redirect.
            endcomment
            if pg_seg.size == 1
              assign pg_col = collections[pg_seg.first]
              comment
                collections[unknown] is nil, and reading a count off nil is a
                render error — so the handle is tested first, in its own if.
              endcomment
              if pg_col.handle != blank
                assign pg_classes = pg_col.products | where: 'type', 'Class'
                if pg_classes.size == 1
                  assign url = pg_classes.first.url
                endif
              endif
            endif
          endif
        -%}
        <div class="rb-pg__card" data-blk="{{ block.id }}" {{ block.shopify_attributes }}>
          <a href="{{ url | default: '#' }}" class="rb-media rb-pg__media" tabindex="-1" aria-hidden="true">
            {%- if img != blank -%}
              {{
                img
                | image_url: width: 900
                | image_tag:
                  widths: '260, 380, 560, 900',
                  sizes: '(max-width: 519px) 90vw, (max-width: 989px) 45vw, 23vw',
                  loading: 'lazy',
                  alt: ''
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>

          <div class="rb-pg__panel rb-paper">
            {%- render 'rb-panel-image',
              image: section.settings.panel_image,
              fit: section.settings.panel_image_fit,
              focal_x: section.settings.panel_image_focal_x,
              focal_y: section.settings.panel_image_focal_y,
              veil_opacity: section.settings.panel_image_veil,
              sizes: '(max-width: 519px) 90vw, (max-width: 989px) 45vw, 23vw',
              widths: '260, 380, 560, 900',
              width: 900
            -%}

            {%- if name != blank -%}
              <p class="rb-pg__name">{{ name }}</p>
            {%- endif -%}
            {%- if block.settings.role != blank -%}
              <p class="rb-pg__role">{{ block.settings.role | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ url | default: '#' }}" class="rb-btn rb-btn--ghost rb-pg__cta">
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%}
      Blank by default, so the wall matches the comp exactly. The Studio page
      switches it on because it shows eight of twenty teachers and the other
      twelve need a way in.
    {%- endcomment -%}
    {%- if section.settings.more_label != blank -%}
      <div class="rb-pg__more">
        <a href="{{ section.settings.more_link | default: '#' }}"
           class="rb-btn rb-btn--serif rb-btn--outline">
          {{- section.settings.more_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rebrand people grid",
  "tag": "section",
  "class": "rb-section-wrapper",
  "max_blocks": 24,
  "settings": [
    { "type": "select", "id": "data_source", "label": "Where the people come from", "default": "blocks",
      "options": [
        { "value": "blocks", "label": "The blocks below (theme editor)" },
        { "value": "app", "label": "The booking app’s Team tab" }
      ],
      "info": "“The booking app” draws this wall from the Team tab. If the app has nobody to show, the blocks below render instead — so the page is never empty." },
    { "type": "select", "id": "app_group", "label": "Which group from the app", "default": "teachers",
      "options": [
        { "value": "teachers", "label": "Teachers" },
        { "value": "studio",   "label": "Studio" },
        { "value": "founders", "label": "Founders" }
      ],
      "info": "Only used when the people come from the app." },
    { "type": "richtext", "id": "eyebrow", "default": "<p>Meet our teachers</p>",
      "label": "Eyebrow",
      "info": "Rendered uppercase. Bold runs render cherry, the rest teal." },
    { "type": "richtext", "id": "intro",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod.</p>",
      "label": "Intro" },
    { "type": "color", "id": "intro_color", "default": "#1e1e1e", "label": "Intro colour" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1,
      "default": 4, "label": "Columns" },
    { "type": "text", "id": "image_ratio", "default": "227 / 200", "label": "Portrait ratio" },
    { "type": "header", "content": "Colour" },
    { "type": "color", "id": "background", "default": "#ffffff", "label": "Background" },
    { "type": "color", "id": "tone_a", "default": "#b00e3f", "label": "Panel tone A" },
    { "type": "color", "id": "tone_a_text", "default": "#ffffff", "label": "Panel tone A text" },
    { "type": "color", "id": "tone_b", "default": "#e07468", "label": "Panel tone B" },
    { "type": "color", "id": "tone_b_text", "default": "#ffffff", "label": "Panel tone B text" },
    { "type": "range", "id": "texture", "min": 0, "max": 100, "step": 5,
      "default": 100, "unit": "%", "label": "Crumpled paper texture" },
    { "type": "header", "content": "Panel background image" },
    { "type": "image_picker", "id": "panel_image", "label": "Panel background image",
      "info": "Sits behind the name plate on every card, over the card tone and under the crumpled paper texture. Leave empty for plain coloured plates." },
    { "type": "select", "id": "panel_image_fit", "label": "How it fills the plate", "default": "cover",
      "options": [
        { "value": "cover", "label": "Fill the plate (crops)" },
        { "value": "contain", "label": "Fit the whole image (no crop)" }
      ] },
    { "type": "range", "id": "panel_image_focal_x", "min": 0, "max": 100, "step": 1,
      "default": 50, "unit": "%", "label": "Panel image focal point — horizontal",
      "info": "Only used when the image fills the plate." },
    { "type": "range", "id": "panel_image_focal_y", "min": 0, "max": 100, "step": 1,
      "default": 50, "unit": "%", "label": "Panel image focal point — vertical" },
    { "type": "range", "id": "panel_image_veil", "min": 0, "max": 100, "step": 5,
      "default": 0, "unit": "%", "label": "Card tone over the image",
      "info": "Tints the image back towards each card's own tone so the names keep their contrast." },
    { "type": "header", "content": "Footer link" },
    { "type": "text", "id": "more_label", "label": "Button label",
      "info": "Blank shows no button, which is what the design has." },
    { "type": "url", "id": "more_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection",
          "info": "Teachers and artists are collections in this store. Supplies the name, photo and link." },
        { "type": "text", "id": "name", "label": "Name override" },
        { "type": "text", "id": "role", "default": "Art Classes", "label": "Role" },
        { "type": "image_picker", "id": "image", "label": "Portrait override" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "text", "id": "button_label", "default": "Learn More", "label": "Button label" },
        { "type": "select", "id": "tone", "label": "Panel colour", "default": "auto",
          "options": [
            { "value": "auto", "label": "Auto (alternates)" },
            { "value": "a", "label": "Tone A" },
            { "value": "b", "label": "Tone B" }
          ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rebrand people grid",
      "blocks": [
        { "type": "person" }, { "type": "person" },
        { "type": "person" }, { "type": "person" }
      ]
    }
  ]
}
{% endschema %}
