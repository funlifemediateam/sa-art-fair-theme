{%- assign quiz_heading    = section.settings.heading    | default: "What's Your Art Personality?" -%}
{%- assign quiz_subheading = section.settings.subheading | default: 'See how your personality can shape your journey as a collector.' -%}
{%- assign quiz_cta        = section.settings.cta_text   | default: 'Take the Test' -%}
{%- assign quiz_api_url    = section.settings.api_url    | default: 'https://sa-art-fair-admin.vercel.app' -%}
{%- assign overlay_alpha   = section.settings.overlay_opacity | divided_by: 100.0 -%}
{%- assign accent          = section.settings.accent_color | default: '#c9873a' -%}

<section
  id="sa-art-quiz-section"
  style="position:relative;min-height:{{ section.settings.min_height | default: 80 }}vh;display:flex;align-items:center;justify-content:center;overflow:hidden"
>

  <div aria-hidden="true" style="position:absolute;inset:0;z-index:0">
    {%- if section.settings.bg_image != blank -%}
      <img
        src="{{ section.settings.bg_image | image_url: width: 2400 }}"
        alt=""
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.height }}"
        style="width:100%;height:100%;object-fit:cover;object-position:center"
        loading="lazy"
      >
    {%- else -%}
      <img
        src="https://cdn.shopify.com/s/files/1/0745/5771/8606/files/earth-memory_99e1d4c5-cee5-40d7-abd0-0fe5154bd2bf.jpg?v=1783088446"
        alt=""
        width="3783"
        height="3496"
        style="width:100%;height:100%;object-fit:cover;object-position:center"
        loading="lazy"
      >
    {%- endif -%}
    <div style="position:absolute;inset:0;background:rgba(0,0,0,{{ overlay_alpha }})"></div>
  </div>

  <div style="position:relative;z-index:1;text-align:center;padding:80px 24px;max-width:680px;width:100%">
    <p style="font-size:0.7rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:{{ accent }};margin:0 0 18px">Art Personality</p>
    <h2 style="font-size:clamp(2rem,5vw,3.4rem);font-weight:700;line-height:1.1;color:#fff;margin:0 0 20px;letter-spacing:-0.02em">
      {{- quiz_heading -}}
    </h2>
    <p style="font-size:1.05rem;line-height:1.7;color:rgba(255,255,255,0.72);margin:0 auto 36px;max-width:500px">
      {{- quiz_subheading -}}
    </p>
    <button
      id="sa-quiz-start-btn"
      style="display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:16px 42px;background:#fff;color:#2e1a28;font-size:0.82rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;border:none;cursor:pointer;border-radius:2px"
    >
      <span>{{- quiz_cta -}}</span>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><polyline points="12 5 19 12 12 19"/></svg>
    </button>
    <p style="margin:16px 0 0;font-size:0.72rem;color:rgba(255,255,255,0.38);letter-spacing:0.05em">10 questions · 3 minutes</p>
  </div>

</section>

<div id="sa-quiz-overlay" style="display:none;position:fixed;inset:0;z-index:10000;background:#fff;overflow-y:auto"></div>

<script>
  window.__saQuizApiUrl     = {{ quiz_api_url | json }};
  window.__saGoogleClientId = {{ shop.metafields.booking_app.google_client_id | default: '' | json }};
  window.__saFbAppId        = {{ shop.metafields.booking_app.facebook_app_id  | default: '' | json }};
</script>
<script src="{{ 'quiz.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Art Personality Quiz",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's Your Art Personality?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See how your personality can shape your journey as a collector."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Take the Test"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 10,
      "max": 85,
      "step": 5,
      "unit": "%",
      "label": "Image overlay darkness",
      "default": 50
    },
    {
      "type": "header",
      "content": "Accent"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#c9873a"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Section height",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "api_url",
      "label": "Admin API URL",
      "default": "https://sa-art-fair-admin.vercel.app",
      "info": "Leave as default unless your admin app URL has changed."
    }
  ],
  "presets": [
    {
      "name": "Art Personality Quiz"
    }
  ]
}
{% endschema %}
