{% comment %}
  Rebrand class cards — "Browse our classes" on the class page and "View
  classes by <teacher>" on a teacher page are the same row: rounded cards with
  the artwork on top and a coloured paper panel under it carrying the title,
  the time, the teacher and a white pill.

  Cards come from a collection of class products rather than from blocks, so
  the row stays right as the studio's calendar changes. Each card reads the
  same booking metafields the class page uses.

  The comp runs this grid narrower than the site container and centres it,
  which is what "Grid max width" is for.
{% endcomment %}

{{ 'saf-rebrand.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id

  comment
    Blank collection falls back to the page's own collection, so one classes
    index template serves /collections/classes, /collections/workshops and
    every teacher collection without a per-page setting.
  endcomment
  assign col = collections[section.settings.collection] | default: collection

  assign items = col.products
  assign limit = section.settings.count

  assign teacher_filter = section.settings.teacher_filter | downcase | strip

  comment
    Reading variants per card costs nothing when nothing asks for a price, so
    the whole booking-facts block is skipped unless a setting wants it.
  endcomment
  assign show_facts = false
  if section.settings.show_price or section.settings.show_deposit or section.settings.show_spaces
    assign show_facts = true
  endif

  assign eyebrow = section.settings.eyebrow
  if section.settings.eyebrow_name != blank
    assign eyebrow = eyebrow | replace: '[teacher]', section.settings.eyebrow_name
  else
    assign eyebrow = eyebrow | replace: '[teacher]', collection.title
  endif
-%}

<style>
  #shopify-section-{{ sid }} .rb-cc {
    background: {{ section.settings.background }};
    padding-block:
      clamp(48px, 6.25vw, 120px)
      clamp(48px, 7.29vw, 140px);
  }
  #shopify-section-{{ sid }} .rb-cc__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(6px, 0.63vw, 12px);
    text-align: center;
    margin-bottom: clamp(26px, 3.02vw, 58px);
  }
  #shopify-section-{{ sid }} .rb-cc__intro {
    max-width: 40ch;
    font-size: var(--rb-fs-body-sm);
    color: {{ section.settings.intro_color }};
  }
  #shopify-section-{{ sid }} .rb-cc__intro p { margin: 0; }

  #shopify-section-{{ sid }} .rb-cc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    gap: clamp(20px, 2.66vw, 51px);
    max-width: {{ section.settings.grid_width }}px;
    margin-inline: auto;
  }

  #shopify-section-{{ sid }} .rb-cc__card {
    display: flex;
    flex-direction: column;
    border-radius: {{ section.settings.radius }}px;
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .rb-cc__media {
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
  }
  #shopify-section-{{ sid }} .rb-cc__panel {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    padding: clamp(12px, 1.25vw, 24px) clamp(12px, 1.35vw, 26px) clamp(16px, 1.72vw, 33px);
    --rb-paper-strength: {{ section.settings.texture | divided_by: 100.0 }};
  }
  #shopify-section-{{ sid }} .rb-cc__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  #shopify-section-{{ sid }} .rb-cc__title {
    margin: 0;
    font-family: var(--rb-serif);
    font-size: clamp(18px, 1.46vw, 28px);
    line-height: 1.15;
  }
  #shopify-section-{{ sid }} .rb-cc__title a { color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} .rb-cc__title a:hover { text-decoration: underline; }
  #shopify-section-{{ sid }} .rb-cc__time {
    flex: 0 0 auto;
    font-family: var(--rb-sans);
    font-size: clamp(9px, 0.63vw, 12px);
    line-height: 1.2;
    opacity: 0.9;
  }
  #shopify-section-{{ sid }} .rb-cc__by {
    margin: 2px 0 0;
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-meta);
    line-height: 1.3;
    text-decoration: underline;
  }
  #shopify-section-{{ sid }} .rb-cc__body {
    margin-top: clamp(6px, 0.63vw, 12px);
    font-size: var(--rb-fs-meta);
    line-height: 1.4;
  }
  #shopify-section-{{ sid }} .rb-cc__body p { margin: 0; }

  /* Booking facts. Sit above the button, under the blurb, in the card's own
     text colour — they are facts about the class, not a second voice. */
  #shopify-section-{{ sid }} .rb-cc__when {
    margin: 4px 0 0;
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-meta);
    line-height: 1.3;
    opacity: 0.92;
  }
  #shopify-section-{{ sid }} .rb-cc__facts {
    margin-top: clamp(8px, 0.83vw, 16px);
    font-family: var(--rb-sans);
    line-height: 1.35;
  }
  #shopify-section-{{ sid }} .rb-cc__facts p { margin: 0; }
  #shopify-section-{{ sid }} .rb-cc__price {
    font-size: clamp(13px, 0.94vw, 18px);
    font-weight: 600;
  }
  #shopify-section-{{ sid }} .rb-cc__deposit,
  #shopify-section-{{ sid }} .rb-cc__spaces {
    margin-top: 2px !important;
    font-size: var(--rb-fs-meta);
    opacity: 0.9;
  }
  /* the one fact that should catch the eye, so the "spaces filling up" line in
     the late-September ads is backed by the same number on the page */
  #shopify-section-{{ sid }} .rb-cc__spaces {
    font-weight: 600;
    opacity: 1;
  }

  #shopify-section-{{ sid }} .rb-cc__cta {
    align-self: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(6px, 0.52vw, 10px);
    margin-top: auto;
    padding-top: clamp(14px, 1.46vw, 28px);
  }
  /* a white pill whose label takes the card's own tone, so it reads as a hole
     punched in the panel rather than a foreign button */
  #shopify-section-{{ sid }} .rb-cc__btn {
    min-height: clamp(32px, 2.19vw, 42px);
    padding-inline: clamp(22px, 2.4vw, 46px);
    background: #ffffff;
    border-color: #ffffff;
  }
  #shopify-section-{{ sid }} .rb-cc__btn:hover {
    background: {{ section.settings.background }};
    border-color: #ffffff;
  }

  #shopify-section-{{ sid }} .rb-cc__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(24px, 2.71vw, 52px);
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ sid }} .rb-cc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 639px) {
    #shopify-section-{{ sid }} .rb-cc__grid { grid-template-columns: 1fr; }
  }

  /* card tones: A is the default, B is the accent the comps drop in here and
     there. "Alternate" flips every other card. */
  #shopify-section-{{ sid }} .rb-cc__card--a .rb-cc__panel {
    background: {{ section.settings.tone_a }};
    color: {{ section.settings.tone_a_text }};
  }
  #shopify-section-{{ sid }} .rb-cc__card--a .rb-cc__btn { color: {{ section.settings.tone_a }}; }
  #shopify-section-{{ sid }} .rb-cc__card--b .rb-cc__panel {
    background: {{ section.settings.tone_b }};
    color: {{ section.settings.tone_b_text }};
  }
  #shopify-section-{{ sid }} .rb-cc__card--b .rb-cc__btn { color: {{ section.settings.tone_b }}; }

  /* With a Book pill present, "View Class" steps back to a ghost so there is
     one obvious action per card. Alone, it keeps the comp's white pill.

     This has to sit after the tone rules AND carry .rb-cc__card, or
     `.rb-cc__card--a .rb-cc__btn { color: tone_a }` wins on source order at
     equal specificity and paints a coral label on a coral panel. */
  #shopify-section-{{ sid }} .rb-cc__card .rb-cc__btn--book ~ .rb-cc__btn {
    background: transparent;
    border-color: currentColor;
    color: inherit;
  }
  #shopify-section-{{ sid }} .rb-cc__card .rb-cc__btn--book ~ .rb-cc__btn:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: currentColor;
    color: inherit;
  }
</style>

<div class="rb-section rb-cc">
  <div class="rb-container">
    {%- if section.settings.eyebrow != blank or section.settings.intro != blank -%}
      <div class="rb-cc__head">
        {%- if eyebrow != blank -%}
          <div class="rb-caps">{{ eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="rb-body rb-cc__intro">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="rb-cc__grid">
      {%- assign shown = 0 -%}
      {%- for item in items -%}
        {%- liquid
          assign by = item.metafields.booking.instructor_name
          assign time = item.metafields.booking.class_time
        -%}

        {%- comment -%}
          Booking facts for a landing page. All four are off by default, so every
          page that already runs this section keeps the comp's card exactly:
          image, title, time, teacher, blurb, pill. The Term 4 page turns them on
          because an ad has to answer "when, how much, is there space" before the
          click, not after it.

          Prices are read off the variants rather than a metafield, because the
          variants are what the booking widget actually charges. Titles are
          matched loosely ("Drop-in", "Single Session", "Monthly", "Full Term",
          "Deposit (Pay in 2)") so renaming a variant does not blank the card.
        {%- endcomment -%}
        {%- liquid
          assign p_single = 0
          assign p_month = 0
          assign p_term = 0
          assign p_dep = 0
          assign seats = -1

          if show_facts
            for v in item.variants
              assign vt = v.title | downcase
              if vt contains 'deposit' or vt contains 'pay in 2'
                assign p_dep = v.price
              elsif vt contains 'month'
                assign p_month = v.price
              elsif vt contains 'term'
                assign p_term = v.price
                if v.inventory_management != blank
                  assign seats = v.inventory_quantity
                endif
              elsif vt contains 'single' or vt contains 'drop' or vt contains 'session'
                assign p_single = v.price
                if seats == -1 and v.inventory_management != blank
                  assign seats = v.inventory_quantity
                endif
              endif
            endfor

            comment
              A class with one unnamed variant ("Default Title") still needs a
              price on the card, so fall back to the product's own.
            endcomment
            if p_single == 0 and p_month == 0 and p_term == 0
              assign p_single = item.price_min
              if seats == -1 and item.first_available_variant.inventory_management != blank
                assign seats = item.first_available_variant.inventory_quantity
              endif
            endif
          endif
        -%}

        {%- liquid
          assign when = ''
          if section.settings.show_schedule
            assign days = ''
            if item.metafields.booking.day_mon.value
              assign days = days | append: ', Mondays'
            endif
            if item.metafields.booking.day_tue.value
              assign days = days | append: ', Tuesdays'
            endif
            if item.metafields.booking.day_wed.value
              assign days = days | append: ', Wednesdays'
            endif
            if item.metafields.booking.day_thu.value
              assign days = days | append: ', Thursdays'
            endif
            if item.metafields.booking.day_fri.value
              assign days = days | append: ', Fridays'
            endif
            if item.metafields.booking.day_sat.value
              assign days = days | append: ', Saturdays'
            endif
            if item.metafields.booking.day_sun.value
              assign days = days | append: ', Sundays'
            endif
            assign days = days | remove_first: ', '

            assign starts = ''
            assign start_raw = item.metafields.booking.start_date
            if start_raw != blank
              assign starts = start_raw | date: '%-d %b'
            endif

            comment
              A one-off workshop has a date, not a weekday pattern — saying
              "Thursdays" about a single evening reads as a weekly class.
            endcomment
            if item.metafields.booking.is_one_off.value
              assign when = starts
            elsif days != blank and starts != blank
              assign when = days | append: ' · from ' | append: starts
            elsif days != blank
              assign when = days
            else
              assign when = starts
            endif
          endif
        -%}

        {%- comment -%}
          A teacher's collection holds their artworks alongside their classes,
          and so does a combined "Classes & Workshops" collection once artwork
          creeps in. A card only makes sense for something bookable, so anything
          without booking data and without a class/workshop product type is
          skipped rather than rendered as a class with no time and no teacher.
        {%- endcomment -%}
        {%- if section.settings.only_classes -%}
          {%- liquid
            assign is_class = false
            if by != blank or time != blank
              assign is_class = true
            else
              assign ptype = item.type | downcase
              if ptype contains 'class' or ptype contains 'workshop'
                assign is_class = true
              endif
            endif
          -%}
          {%- unless is_class -%}
            {%- continue -%}
          {%- endunless -%}
        {%- endif -%}

        {%- comment -%}
          A teacher page shows only that teacher's classes. Filtering has to
          happen inside the loop rather than through `limit`, or a filtered-out
          class still eats one of the slots.
        {%- endcomment -%}
        {%- if teacher_filter != blank -%}
          {%- assign haystack = by | default: '' | downcase -%}
          {%- unless haystack contains teacher_filter -%}
            {%- continue -%}
          {%- endunless -%}
        {%- endif -%}
        {%- if shown >= limit -%}
          {%- break -%}
        {%- endif -%}

        {%- liquid
          assign tone = 'a'
          if section.settings.pattern == 'alternate'
            assign m = shown | modulo: 2
            if m == 1
              assign tone = 'b'
            endif
          endif
          assign shown = shown | plus: 1
        -%}
        <article class="rb-cc__card rb-cc__card--{{ tone }}">
          <a href="{{ item.url }}" class="rb-media rb-cc__media" tabindex="-1" aria-hidden="true">
            {%- if item.featured_image != blank -%}
              {{
                item.featured_image
                | image_url: width: 900
                | image_tag:
                  widths: '260, 400, 600, 900',
                  sizes: '(max-width: 639px) 90vw, (max-width: 989px) 45vw, 26vw',
                  loading: 'lazy',
                  alt: ''
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>

          <div class="rb-cc__panel rb-paper">
            <div class="rb-cc__row">
              <h3 class="rb-cc__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
              {%- if time != blank -%}
                <span class="rb-cc__time">{{ time }}</span>
              {%- endif -%}
            </div>

            {%- if by != blank -%}
              <p class="rb-cc__by">{{ section.settings.by_prefix }} {{ by }}</p>
            {%- endif -%}

            {%- if when != blank -%}
              <p class="rb-cc__when">{{ when }}</p>
            {%- endif -%}

            {%- if section.settings.show_excerpt -%}
              <div class="rb-cc__body">
                <p>{{ item.description | strip_html | truncatewords: 18 }}</p>
              </div>
            {%- endif -%}

            {%- if show_facts -%}
              <div class="rb-cc__facts">
                {%- if section.settings.show_price -%}
                  <p class="rb-cc__price">
                    {%- assign bits = '' -%}
                    {%- if p_single > 0 -%}
                      {%- capture bit -%}{{ p_single | money_without_trailing_zeros }} {{ section.settings.session_word }}{%- endcapture -%}
                      {%- assign bits = bits | append: ' · ' | append: bit -%}
                    {%- endif -%}
                    {%- if p_month > 0 -%}
                      {%- capture bit -%}{{ p_month | money_without_trailing_zeros }} {{ section.settings.month_word }}{%- endcapture -%}
                      {%- assign bits = bits | append: ' · ' | append: bit -%}
                    {%- endif -%}
                    {%- if p_term > 0 -%}
                      {%- capture bit -%}{{ p_term | money_without_trailing_zeros }} {{ section.settings.term_word }}{%- endcapture -%}
                      {%- assign bits = bits | append: ' · ' | append: bit -%}
                    {%- endif -%}
                    {{- bits | remove_first: ' · ' -}}
                  </p>
                {%- endif -%}

                {%- if section.settings.show_deposit and p_dep > 0 -%}
                  <p class="rb-cc__deposit">
                    {{- section.settings.deposit_label }} {{ p_dep | money_without_trailing_zeros -}}
                  </p>
                {%- endif -%}

                {%- comment -%}
                  Scarcity is only honest when it is real, so this renders from
                  live inventory and only once the seats actually run low. A
                  class with untracked inventory reports -1 and says nothing.
                {%- endcomment -%}
                {%- if section.settings.show_spaces and seats > 0 and seats <= section.settings.spaces_threshold -%}
                  <p class="rb-cc__spaces">{{ section.settings.spaces_label | replace: '[n]', seats }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.button_label != blank or section.settings.book_label != blank -%}
              <div class="rb-cc__cta">
                {%- if section.settings.book_label != blank -%}
                  {%- comment -%}
                    Straight to the booking widget rather than the top of the
                    class page — the widget is the third band down, and an ad
                    click that lands above the fold it needs still has to scroll.
                    The widget's real element id is per-product
                    ("…template--<template id>__booking"), so the link says
                    #book and saf-rebrand.js resolves it on arrival.
                  {%- endcomment -%}
                  <a href="{{ item.url }}#book" class="rb-btn rb-btn--serif rb-cc__btn rb-cc__btn--book">
                    {{- section.settings.book_label | escape -}}
                  </a>
                {%- endif -%}
                {%- if section.settings.button_label != blank -%}
                  <a href="{{ item.url }}" class="rb-btn rb-btn--serif rb-cc__btn">
                    {{- section.settings.button_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}

      {%- if shown == 0 and request.design_mode -%}
        <p class="rb-body">
          No classes matched. Pick a collection of classes, and check the teacher filter.
        </p>
      {%- endif -%}
    </div>

    {%- if section.settings.more_label != blank -%}
      <div class="rb-cc__more">
        <a href="{{ section.settings.more_link | default: col.url | default: '#' }}"
           class="rb-btn rb-btn--serif rb-btn--outline">
          {{- section.settings.more_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rebrand class cards",
  "tag": "section",
  "class": "rb-section-wrapper",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Classes collection",
      "info": "Blank uses the collection this page is already showing." },
    { "type": "range", "id": "count", "min": 3, "max": 48, "step": 1,
      "default": 6, "label": "Classes to show" },
    { "type": "checkbox", "id": "only_classes", "default": true,
      "label": "Only show bookable classes",
      "info": "Skips artworks that share the collection with a teacher's classes." },
    { "type": "richtext", "id": "eyebrow", "default": "<p>Browse our classes</p>",
      "label": "Eyebrow",
      "info": "Rendered uppercase. Bold runs render cherry, the rest teal. Write [teacher] to drop the teacher's name in." },
    { "type": "text", "id": "eyebrow_name", "label": "Name for [teacher]",
      "info": "Blank uses the collection title, which is what a teacher page wants." },
    { "type": "text", "id": "teacher_filter", "label": "Only show classes by",
      "info": "Matched against each class's booking.instructor_name. Blank shows every class in the collection." },
    { "type": "richtext", "id": "intro",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod.</p>",
      "label": "Intro" },
    { "type": "color", "id": "intro_color", "default": "#1e1e1e", "label": "Intro colour" },
    { "type": "header", "content": "Cards" },
    { "type": "text", "id": "by_prefix", "default": "By", "label": "Teacher prefix" },
    { "type": "checkbox", "id": "show_excerpt", "default": true, "label": "Show a short description" },
    { "type": "text", "id": "button_label", "default": "View Class", "label": "Card button label" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1,
      "default": 3, "label": "Columns" },
    { "type": "range", "id": "grid_width", "min": 800, "max": 1670, "step": 10,
      "default": 1300, "unit": "px", "label": "Grid max width" },
    { "type": "text", "id": "image_ratio", "default": "398 / 380", "label": "Card image ratio" },
    { "type": "range", "id": "radius", "min": 0, "max": 48, "step": 1,
      "default": 18, "unit": "px", "label": "Card corner radius" },
    { "type": "header", "content": "Booking facts",
      "info": "All off by default, which is the comp's card. Switch them on for a page an ad lands on, where the click has to be earned before the class page loads." },
    { "type": "checkbox", "id": "show_schedule", "default": false,
      "label": "Show the day and start date",
      "info": "Reads booking.day_* and booking.start_date. A one-off workshop shows its date instead of a weekday." },
    { "type": "checkbox", "id": "show_price", "default": false, "label": "Show prices",
      "info": "Read off the variants the booking widget charges — drop-in, monthly, full term." },
    { "type": "text", "id": "session_word", "default": "a session", "label": "Wording after the drop-in price" },
    { "type": "text", "id": "month_word", "default": "a month", "label": "Wording after the monthly price" },
    { "type": "text", "id": "term_word", "default": "the term", "label": "Wording after the term price" },
    { "type": "checkbox", "id": "show_deposit", "default": false,
      "label": "Show the pay-in-2 deposit",
      "info": "Only appears on classes that have pay-in-2 switched on in the booking app." },
    { "type": "text", "id": "deposit_label", "default": "Or hold your seat for", "label": "Wording before the deposit" },
    { "type": "checkbox", "id": "show_spaces", "default": false,
      "label": "Show spaces left when a class is filling up",
      "info": "Live inventory. Says nothing until the class drops to the number below, and nothing at all if inventory is untracked." },
    { "type": "range", "id": "spaces_threshold", "min": 1, "max": 24, "step": 1,
      "default": 8, "label": "Only show spaces at or below" },
    { "type": "text", "id": "spaces_label", "default": "Only [n] spaces left",
      "label": "Spaces wording", "info": "[n] is replaced with the number left." },
    { "type": "text", "id": "book_label", "label": "Book button label",
      "info": "Blank leaves the comp's single pill. Filled adds a Book pill that jumps straight to the booking widget, and steps the other button back to an outline." },
    { "type": "header", "content": "Colour" },
    { "type": "color", "id": "background", "default": "#ffffff", "label": "Background" },
    { "type": "select", "id": "pattern", "label": "Card colours", "default": "all_a",
      "options": [
        { "value": "all_a", "label": "All tone A" },
        { "value": "alternate", "label": "Alternate A and B" }
      ] },
    { "type": "color", "id": "tone_a", "default": "#e07468", "label": "Tone A" },
    { "type": "color", "id": "tone_a_text", "default": "#ffffff", "label": "Tone A text" },
    { "type": "color", "id": "tone_b", "default": "#b00e3f", "label": "Tone B" },
    { "type": "color", "id": "tone_b_text", "default": "#ffffff", "label": "Tone B text" },
    { "type": "range", "id": "texture", "min": 0, "max": 100, "step": 5,
