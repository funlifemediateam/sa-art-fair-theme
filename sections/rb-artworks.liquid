{% comment %}
  Rebrand artworks — "Available Artworks".

  Two arrangements in the comps, one section:
    Toolbar (Store page)      — a full-width strip of controls under the
                                heading: search, artist, medium, colour,
                                price, availability, sort.
    Rail (artist page)        — Show/Sort on the right, and a narrow "Filter
                                By" rail on the left with colour swatches and
                                orientation.

  The grid is server-rendered and paginated so the page works without JS; the
  filters then swap in a client-rendered grid. See assets/saf-rb-artworks.js
  for why it fetches the whole collection rather than filtering the page.

  Medium and colour options come from the collection's own tags, so the
  dropdowns never offer a filter that matches nothing.
{% endcomment %}

{{ 'saf-rebrand.css' | asset_url | stylesheet_tag }}
<script src="{{ 'saf-rb-artworks.js' | asset_url }}" defer></script>

{%- liquid
  assign sid = section.id
  assign col = collections[section.settings.collection] | default: collection
  assign per_page = section.settings.per_page
  assign layout = section.settings.layout

  assign medium_tags = ''
  assign colour_tags = ''
  for t in col.all_tags
    assign lower = t | downcase
    if lower contains 'medium-'
      assign medium_tags = medium_tags | append: ',' | append: lower
    elsif lower contains 'colour-'
      assign colour_tags = colour_tags | append: ',' | append: lower
    endif
  endfor
  assign medium_list = medium_tags | remove_first: ',' | split: ','
  assign colour_list = colour_tags | remove_first: ',' | split: ','

  assign show_options = '12,24,48' | split: ','
-%}

<style>
  #shopify-section-{{ sid }} .rb-aw {
    background: {{ section.settings.background }};
    padding-block:
      {% if layout == 'rail' %}clamp(40px, 8.13vw, 156px){% else %}clamp(40px, 4.79vw, 92px){% endif %}
      clamp(48px, 6.77vw, 130px);
  }
  {% comment %}
    "Available Artworks" measures 480px of ink in BOTH the Store and the artist
    comps, which is 64px of IvyPresto — larger than the shared section-title
    token, so this heading carries its own size.
  {% endcomment %}
  #shopify-section-{{ sid }} .rb-aw__heading {
    color: {{ section.settings.heading_color }};
    text-align: center;
    font-size: clamp(30px, 3.33vw, 64px);
    margin-bottom: {% if layout == 'rail' %}clamp(24px, 7.55vw, 145px){% else %}clamp(20px, 2.4vw, 46px){% endif %};
  }

  /* ---- toolbar layout (Store) ---------------------------------------- */
  #shopify-section-{{ sid }} .rb-aw__bar {
    background: {{ section.settings.bar_color }};
    padding-block: clamp(10px, 0.94vw, 18px);
    margin-bottom: clamp(24px, 3.13vw, 60px);
  }
  #shopify-section-{{ sid }} .rb-aw__bar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(8px, 0.83vw, 16px);
  }
  #shopify-section-{{ sid }} .rb-aw__search {
    flex: 1 1 320px;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: clamp(34px, 2.4vw, 46px);
    padding-inline: clamp(12px, 1.04vw, 20px);
    border: 1px solid rgba(30, 30, 30, 0.16);
    border-radius: 999px;
    background: #fff;
  }
  #shopify-section-{{ sid }} .rb-aw__search svg {
    width: 16px; height: 16px; flex: 0 0 auto; opacity: 0.55;
  }
  #shopify-section-{{ sid }} .rb-aw__search input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: none;
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-body-sm);
    color: var(--rb-ink);
  }
  #shopify-section-{{ sid }} .rb-aw__search input:focus { outline: none; }

  #shopify-section-{{ sid }} .rb-aw__control,
  #shopify-section-{{ sid }} .rb-aw__dd > summary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    box-sizing: border-box;
    min-height: clamp(34px, 2.4vw, 46px);
    padding-inline: clamp(12px, 1.04vw, 20px);
    border: 1px solid rgba(30, 30, 30, 0.16);
    border-radius: 999px;
    background: #fff;
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-body-sm);
    line-height: 1;
    color: var(--rb-ink);
    cursor: pointer;
    list-style: none;
  }
  #shopify-section-{{ sid }} .rb-aw__dd > summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ sid }} .rb-aw__control {
    appearance: none;
    background-image: none;
    padding-right: clamp(28px, 2.19vw, 42px);
  }
  #shopify-section-{{ sid }} .rb-aw__select-wrap { position: relative; display: inline-flex; }
  {% comment %}
    A bare <select> is as wide as its LONGEST option, so "Featured" sat with a
    chevron floating 100px away from it. In the "fit" variant the visible text
    is a span that carries the selected option, and the real select lies over
    it invisibly — so the control hugs its label, as the comp draws it, and
    stays a native select for keyboard and screen-reader users.
  {% endcomment %}
  #shopify-section-{{ sid }} .rb-aw__select-wrap--fit { align-items: center; }
  #shopify-section-{{ sid }} .rb-aw__select-wrap--fit select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    opacity: 0;
    cursor: pointer;
  }
  #shopify-section-{{ sid }} .rb-aw__label {
    pointer-events: none;
    white-space: nowrap;
  }
  #shopify-section-{{ sid }} .rb-aw__select-wrap svg {
    position: absolute;
    right: clamp(10px, 0.83vw, 16px);
    top: 50%;
    transform: translateY(-50%);
    width: 12px; height: 12px;
    pointer-events: none;
    opacity: 0.6;
  }

  #shopify-section-{{ sid }} .rb-aw__dd { position: relative; }
  #shopify-section-{{ sid }} .rb-aw__dd-panel {
    position: absolute;
    z-index: 5;
    top: calc(100% + 6px);
    left: 0;
    min-width: 210px;
    padding: 12px 14px;
    border: 1px solid rgba(30, 30, 30, 0.14);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 8px 26px rgba(30, 30, 30, 0.12);
  }
  #shopify-section-{{ sid }} .rb-aw__opt {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-body-sm);
    cursor: pointer;
    text-transform: capitalize;
  }

  #shopify-section-{{ sid }} .rb-aw__toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: clamp(34px, 2.4vw, 46px);
    padding-inline: clamp(12px, 1.04vw, 20px);
    border: 1px solid rgba(30, 30, 30, 0.16);
    border-radius: 999px;
    background: #fff;
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-body-sm);
    cursor: pointer;
  }
  #shopify-section-{{ sid }} .rb-aw__toggle.is-on {
    background: var(--rb-ink);
    color: #fff;
    border-color: var(--rb-ink);
  }
  #shopify-section-{{ sid }} .rb-aw__toggle input { margin: 0; }

  /* ---- rail layout (artist page) --------------------------------------
     Measured off the artist comp at its 1920 frame: the Show/Sort controls
     are PLAIN TEXT with a chevron, not the pills the Store toolbar uses;
     the rail is a 177px box at the left gutter whose rows are right-aligned;
     and the grid beside it is three 408px columns with a 56px gutter. */
  #shopify-section-{{ sid }} .rb-aw__sorts {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(14px, 2.55vw, 49px);
    margin-bottom: clamp(16px, 5.1vw, 98px);
  }
  #shopify-section-{{ sid }} .rb-aw__sorts .rb-aw__select-wrap {
    padding-right: clamp(26px, 2.45vw, 47px);
    font-family: var(--rb-sans);
    font-size: clamp(15px, 1.3vw, 25px);
    line-height: 1.2;
    color: var(--rb-ink);
  }
  #shopify-section-{{ sid }} .rb-aw__sorts .rb-aw__control {
    min-height: 0;
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
    line-height: inherit;
  }
  #shopify-section-{{ sid }} .rb-aw__sorts .rb-aw__select-wrap svg {
    right: 0;
    width: clamp(14px, 1.51vw, 29px);
    height: clamp(14px, 1.51vw, 29px);
    opacity: 1;
    stroke-width: 1.5;
  }
  #shopify-section-{{ sid }} .rb-aw__layout {
    display: grid;
    grid-template-columns: max({{ section.settings.rail_width }}px, 10.6%) minmax(0, 1fr);
    column-gap: 9.6%;
    align-items: start;
  }
  /* the rail's rows sit against a common right edge in the comp */
  #shopify-section-{{ sid }} .rb-aw__rail {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }
  #shopify-section-{{ sid }} .rb-aw__rail-title {
    margin: 0 0 clamp(14px, 1.98vw, 38px);
    font-family: var(--rb-sans);
    font-weight: 700;
    font-size: clamp(14px, 1.25vw, 24px);
    line-height: 1.2;
  }
  #shopify-section-{{ sid }} .rb-aw__rail-group { width: 100%; }
  #shopify-section-{{ sid }} .rb-aw__rail-group + .rb-aw__rail-group { margin-top: clamp(12px, 1.51vw, 29px); }
  #shopify-section-{{ sid }} .rb-aw__rail-group > summary {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(10px, 1.51vw, 29px);
    cursor: pointer;
    list-style: none;
    font-family: var(--rb-sans);
    font-size: clamp(14px, 1.25vw, 24px);
    line-height: 1.2;
  }
  #shopify-section-{{ sid }} .rb-aw__rail-group > summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ sid }} .rb-aw__rail-group > summary svg {
    flex: 0 0 auto;
    width: clamp(14px, 1.51vw, 29px);
    height: clamp(14px, 1.51vw, 29px);
    stroke-width: 1.5;
    transition: transform 0.2s ease;
  }
  #shopify-section-{{ sid }} .rb-aw__rail-group[open] > summary svg { transform: rotate(180deg); }

  #shopify-section-{{ sid }} .rb-aw__swatches {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: clamp(7px, 0.57vw, 11px);
    margin-top: clamp(12px, 1.56vw, 30px);
  }
  #shopify-section-{{ sid }} .rb-aw__swatch {
    position: relative; /* holds the visually-hidden checkbox */
    display: inline-flex;
    width: clamp(18px, 1.77vw, 34px);
    height: clamp(18px, 1.77vw, 34px);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 0 0 1px rgba(30, 30, 30, 0.12) inset;
  }
  #shopify-section-{{ sid }} .rb-aw__swatch.is-on {
    box-shadow: 0 0 0 2px var(--rb-ink);
  }
  /* the input is the control; the dot is its label, so it must not vanish */
  #shopify-section-{{ sid }} .rb-aw__swatch input {
    position: absolute;
    width: 1px; height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* ---- grid ------------------------------------------------------------ */
  #shopify-section-{{ sid }} .rb-aw__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    gap: clamp(24px, 3.44vw, 66px) {% if layout == 'rail' %}clamp(20px, 2.92vw, 56px){% else %}clamp(20px, 3.13vw, 60px){% endif %};
  }
  /* the class's own `display: grid` beats the UA [hidden] rule, so a grid
     JS toggles off with .hidden would otherwise keep rendering on top of
     the one it's meant to replace */
  #shopify-section-{{ sid }} .rb-aw__grid[hidden] { display: none; }
  #shopify-section-{{ sid }} .rb-aw__card { display: flex; flex-direction: column; }
  #shopify-section-{{ sid }} .rb-aw__media {
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
  }
  #shopify-section-{{ sid }} .rb-aw__hover {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    inset: 0;
    background: rgba(30, 30, 30, 0.18);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  #shopify-section-{{ sid }} .rb-aw__media:hover .rb-aw__hover,
  #shopify-section-{{ sid }} .rb-aw__media:focus-visible .rb-aw__hover { opacity: 1; }
  #shopify-section-{{ sid }} .rb-aw__hover-btn {
    background: rgba(255, 255, 255, 0.9);
    color: var(--rb-ink);
    border-color: transparent;
    pointer-events: none;
  }

  #shopify-section-{{ sid }} .rb-aw__title {
    margin: clamp(8px, 0.83vw, 16px) 0 0;
    font-family: var(--rb-serif);
    font-weight: 400;
    font-size: clamp(17px, 1.35vw, 26px);
    line-height: 1.2;
    color: {{ section.settings.card_title_color }};
  }
  #shopify-section-{{ sid }} .rb-aw__title a { color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} .rb-aw__title a:hover { text-decoration: underline; }
  #shopify-section-{{ sid }} .rb-aw__artist {
    margin: 2px 0 0;
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-meta);
    text-decoration: underline;
    color: {{ section.settings.card_meta_color }};
  }
  #shopify-section-{{ sid }} .rb-aw__price {
    margin: clamp(8px, 0.73vw, 14px) 0 0;
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-meta);
    color: {{ section.settings.card_meta_color }};
  }
  #shopify-section-{{ sid }} .rb-aw__sold { opacity: 0.6; }
  #shopify-section-{{ sid }} .rb-aw__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: clamp(10px, 1.15vw, 22px);
    font-size: clamp(14px, 1.3vw, 25px);
    color: {{ section.settings.card_meta_color }};
  }
  /* pushed to the foot of the card so the pills line up across a row even
     when one title wraps onto a second line, as the comp shows them */
  #shopify-section-{{ sid }} .rb-aw__cta-row {
    display: flex;
    justify-content: center;
    margin-top: auto;
    padding-top: clamp(16px, 1.93vw, 37px);
  }
  /* the comp's pill hugs its label — much tighter than the site-wide button */
  #shopify-section-{{ sid }} .rb-aw__cta-row .rb-btn {
    padding-inline: clamp(16px, 1.3vw, 25px);
    font-size: clamp(15px, 1.22vw, 23px);
  }

  #shopify-section-{{ sid }} .rb-aw__count {
    margin: clamp(10px, 1.04vw, 20px) 0 0;
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-meta);
    text-align: center;
    color: {{ section.settings.card_meta_color }};
  }
  #shopify-section-{{ sid }} .rb-aw__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(24px, 2.6vw, 50px);
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ sid }} .rb-aw__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #shopify-section-{{ sid }} .rb-aw__layout { grid-template-columns: 1fr; row-gap: clamp(20px, 4vw, 40px); }
    /* the rail's right edge only reads as an edge beside the grid; stacked
       above it, the same alignment looks like a mistake */
    #shopify-section-{{ sid }} .rb-aw__rail { align-items: flex-start; text-align: left; }
    #shopify-section-{{ sid }} .rb-aw__rail-group > summary { justify-content: flex-start; }
    #shopify-section-{{ sid }} .rb-aw__swatches { justify-content: flex-start; }
  }
  @media screen and (max-width: 639px) {
    #shopify-section-{{ sid }} .rb-aw__grid { grid-template-columns: 1fr; }
    #shopify-section-{{ sid }} .rb-aw__search { flex-basis: 100%; }
  }
</style>

{%- capture chevron -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 9l7 7 7-7"></path></svg>
{%- endcapture -%}

{%- capture grid_markup -%}
  <div class="rb-aw__grid" data-rba-server>
    {%- paginate col.products by per_page -%}
      {%- assign next_page_url = paginate.next.url -%}
      {%- for item in col.products -%}
        <article class="rb-aw__card">
          <a href="{{ item.url }}" class="rb-media rb-aw__media">
            {%- if item.featured_image != blank -%}
              {{
                item.featured_image
                | image_url: width: 900
                | image_tag:
                  widths: '280, 420, 620, 900',
                  sizes: '(max-width: 639px) 90vw, (max-width: 989px) 45vw, 30vw',
                  loading: 'lazy',
                  alt: item.featured_image.alt | default: item.title
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="rb-aw__hover">
              <span class="rb-btn rb-btn--serif rb-aw__hover-btn">{{ section.settings.hover_label | escape }}</span>
            </span>
          </a>

          {%- if layout == 'rail' -%}
            <div class="rb-meta rb-aw__row">
              <span>{{ item.title }}</span>
              <span>{{ item.vendor }}</span>
            </div>
            <div class="rb-aw__cta-row">
              <a href="{{ item.url }}" class="rb-btn rb-btn--serif rb-btn--outline">
                {{- section.settings.card_button | escape -}}
              </a>
            </div>
          {%- else -%}
            <h3 class="rb-aw__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
            {%- if item.vendor != blank -%}
              <p class="rb-aw__artist">{{ item.vendor }}</p>
            {%- endif -%}
            <p class="rb-aw__price">
              {{- item.price | money -}}
              {%- unless item.available %} <span class="rb-aw__sold">Sold</span>{% endunless -%}
            </p>
          {%- endif -%}
        </article>
      {%- else -%}
        {%- if request.design_mode -%}
          <p class="rb-body">Pick a collection to fill this grid.</p>
        {%- endif -%}
      {%- endfor -%}

    {%- endpaginate -%}
  </div>
{%- endcapture -%}

<div
  class="rb-section rb-aw"
  data-rba-root
  data-rba-url="{{ col.url }}"
  data-rba-card="{% if layout == 'rail' %}collection{% else %}artwork{% endif %}"
  data-rba-view-label="{{ section.settings.hover_label | escape }}"
  data-rba-per-page="{{ per_page }}"
>
  {%- if section.settings.heading != blank -%}
    <div class="rb-container">
      <h2 class="rb-section-title rb-aw__heading">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  {%- if layout == 'toolbar' -%}
    <div class="rb-aw__bar">
      <div class="rb-container rb-aw__bar-inner">
        <label class="rb-aw__search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
          </svg>
          <input type="search" data-rba-q placeholder="{{ section.settings.search_placeholder | escape }}"
                 aria-label="{{ section.settings.search_placeholder | escape }}">
        </label>

        <span class="rb-aw__select-wrap">
          <select class="rb-aw__control" data-rba-artist aria-label="Artist">
            <option value="">All artists</option>
            {%- for v in col.all_vendors -%}
              <option value="{{ v | escape }}">{{ v }}</option>
            {%- endfor -%}
          </select>
          {{ chevron }}
        </span>

        {%- if medium_list.size > 0 -%}
          <details class="rb-aw__dd" data-rba-dd>
            <summary>Medium {{ chevron }}</summary>
            <div class="rb-aw__dd-panel">
              {%- for t in medium_list -%}
                {%- assign val = t | remove_first: 'medium-' -%}
                <label class="rb-aw__opt">
                  <input type="checkbox" data-rba-medium value="{{ val }}"> {{ val | replace: '-', ' ' }}
                </label>
              {%- endfor -%}
            </div>
          </details>
        {%- endif -%}

        {%- if colour_list.size > 0 -%}
          <details class="rb-aw__dd" data-rba-dd>
            <summary>Colour {{ chevron }}</summary>
            <div class="rb-aw__dd-panel">
              {%- for t in colour_list -%}
                {%- assign val = t | remove_first: 'colour-' -%}
                <label class="rb-aw__opt">
                  <input type="checkbox" data-rba-colour value="{{ val }}"> {{ val | replace: '-', ' ' }}
                </label>
              {%- endfor -%}
            </div>
          </details>
        {%- endif -%}

        <span class="rb-aw__select-wrap">
          <select class="rb-aw__control" data-rba-price aria-label="Price">
            <option value="">Any price</option>
            <option value="0-2500">Under R2 500</option>
            <option value="2500-5000">R2 500 – R5 000</option>
            <option value="5000-7500">R5 000 – R7 500</option>
            <option value="7500-">R7 500 and up</option>
          </select>
          {{ chevron }}
        </span>

        <label class="rb-aw__toggle">
          <input type="checkbox" data-rba-avail> Available only
        </label>

        <span class="rb-aw__select-wrap">
          <select class="rb-aw__control" data-rba-sort aria-label="Sort by">
            <option value="">Featured</option>
            <option value="newest">Newest</option>
            <option value="price-asc">Price, low to high</option>
            <option value="price-desc">Price, high to low</option>
            <option value="az">A–Z</option>
          </select>
          {{ chevron }}
        </span>
      </div>
    </div>

    <div class="rb-container">
      {{ grid_markup }}
      <div class="rb-aw__grid" data-rba-results hidden></div>
      <p class="rb-body" data-rba-empty hidden>No works match those filters.</p>
      <p class="rb-aw__count" data-rba-count></p>
    </div>

  {%- else -%}
    <div class="rb-container">
      <div class="rb-aw__sorts">
        {%- comment -%}
          The comp reads "Show 24" at rest, so the resting option is the page
          size the server already rendered — picking it must not switch the
          grid to a client-rendered one. The explicit counts come after it,
          and "Show all" is a large slice rather than an empty value, which
          the filter script treats as "no filter active".
        {%- endcomment -%}
        <span class="rb-aw__select-wrap rb-aw__select-wrap--fit">
          <span class="rb-aw__label" data-rba-label>Show {{ per_page }}</span>
          <select class="rb-aw__control" data-rba-show aria-label="How many to show">
            <option value="">Show {{ per_page }}</option>
            {%- for n in show_options -%}
              {%- assign ni = n | plus: 0 -%}
              {%- unless ni == per_page -%}<option value="{{ ni }}">Show {{ ni }}</option>{%- endunless -%}
            {%- endfor -%}
            <option value="9999">Show all</option>
          </select>
          {{ chevron }}
        </span>
        <span class="rb-aw__select-wrap rb-aw__select-wrap--fit">
          <span class="rb-aw__label" data-rba-label>Featured</span>
          <select class="rb-aw__control" data-rba-sort aria-label="Sort by">
            <option value="">Featured</option>
            <option value="newest">Newest</option>
            <option value="price-asc">Price, low to high</option>
            <option value="price-desc">Price, high to low</option>
            <option value="az">A–Z</option>
          </select>
          {{ chevron }}
        </span>
      </div>

      <div class="rb-aw__layout">
        <aside class="rb-aw__rail">
          <p class="rb-aw__rail-title">{{ section.settings.rail_title | escape }}</p>

          {%- if colour_list.size > 0 -%}
            <details class="rb-aw__rail-group" open>
              <summary>Colour {{ chevron }}</summary>
              <div class="rb-aw__swatches">
                {%- for t in colour_list -%}
                  {%- liquid
                    assign val = t | remove_first: 'colour-'
                    assign dot = '#505a43'
                    case val
                      when 'warm'
                        assign dot = '#e07468'
                      when 'cool'
                        assign dot = '#0c3642'
                      when 'neutral'
                        assign dot = '#bea532'
                    endcase
                  -%}
                  <label class="rb-aw__swatch" style="background: {{ dot }};"
                         title="{{ val | capitalize }}">
                    <input type="checkbox" data-rba-colour value="{{ val }}"
                           aria-label="{{ val | capitalize }}">
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endif -%}

          <details class="rb-aw__rail-group">
            <summary>Orientation {{ chevron }}</summary>
            <div>
              <span class="rb-aw__select-wrap" style="margin-top:10px;">
                <select class="rb-aw__control" data-rba-orientation aria-label="Orientation">
                  <option value="">Any</option>
                  <option value="landscape">Landscape</option>
                  <option value="portrait">Portrait</option>
                </select>
                {{ chevron }}
              </span>
            </div>
          </details>
        </aside>

        <div>
          {{ grid_markup }}
          <div class="rb-aw__grid" data-rba-results hidden></div>
          <p class="rb-body" data-rba-empty hidden>No works match those filters.</p>
          <p class="rb-aw__count" data-rba-count></p>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%}
    Blank `more_link` used to fall back to `col.url` — on a page that IS
    that same collection (e.g. the Store's own "Available Artworks" grid),
    that just links the button back to the page it's already on, so
    clicking it "refreshes to the same page" instead of showing more work.
    A blank link now falls back to the collection's next page instead, and
    the button is hidden once there is no next page to show.
  {%- endcomment -%}
  {%- assign more_href = section.settings.more_link | default: next_page_url -%}
  {%- if section.settings.more_label != blank and more_href != blank -%}
    <div class="rb-container">
      <div class="rb-aw__more" data-rba-more>
        <a href="{{ more_href }}"
           class="rb-btn rb-btn--serif rb-btn--outline"
           {% if section.settings.more_link == blank %}data-rba-more-auto{% endif %}>
          {{- section.settings.more_label | escape -}}
        </a>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Rebrand artworks",
  "tag": "section",
  "class": "rb-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "default": "Available Artworks", "label": "Heading" },
    { "type": "collection", "id": "collection", "label": "Collection",
      "info": "Blank uses the collection the page is already showing." },
    { "type": "select", "id": "layout", "label": "Filter layout", "default": "toolbar",
      "options": [
        { "value": "toolbar", "label": "Toolbar strip (Store page)" },
        { "value": "rail", "label": "Side rail (artist page)" }
      ] },
    { "type": "range", "id": "per_page", "min": 6, "max": 48, "step": 3,
      "default": 9, "label": "Works per page" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1,
      "default": 3, "label": "Columns" },
    { "type": "text", "id": "image_ratio", "default": "1 / 1", "label": "Artwork ratio" },
    { "type": "text", "id": "hover_label", "default": "View Artwork", "label": "Hover button label" },
    { "type": "header", "content": "Toolbar" },
    { "type": "text", "id": "search_placeholder", "default": "Search artworks, artists, mediums…",
      "label": "Search placeholder" },
    { "type": "color", "id": "bar_color", "default": "#f4f4f1", "label": "Toolbar strip colour" },
    { "type": "header", "content": "Side rail" },
    { "type": "text", "id": "rail_title", "default": "Filter By:", "label": "Rail title" },
    { "type": "range", "id": "rail_width", "min": 120, "max": 320, "step": 10,
      "default": 150, "unit": "px", "label": "Rail minimum width",
      "info": "The rail tracks the comp's 10.6% of the content width and never falls below this." },
    { "type": "text", "id": "card_button", "default": "Browse Collection", "label": "Card button label" },
    { "type": "header", "content": "Footer link" },
    { "type": "text", "id": "more_label", "default": "See More…", "label": "Button label" },
    { "type": "url", "id": "more_link", "label": "Button link",
      "info": "Defaults to the collection." },
    { "type": "header", "content": "Colour" },
    { "type": "color", "id": "background", "default": "#ffffff", "label": "Background" },
    { "type": "color", "id": "heading_color", "default": "#505a43", "label": "Heading" },
    { "type": "color", "id": "card_title_color", "default": "#1e1e1e", "label": "Card title" },
    { "type": "color", "id": "card_meta_color", "default": "#1e1e1e", "label": "Card meta" }
  ],
  "presets": [{ "name": "Rebrand artworks" }]
}
{% endschema %}
