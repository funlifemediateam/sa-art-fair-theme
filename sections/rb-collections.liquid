{% comment %}
  Rebrand featured collections — gold eyebrow over a row of 8:5 collection
  cards, each captioned "Collection Title / Artist Name" with a serif pill.

  Comp: 1920 x 857, three 516 x 322 cards, 64px gutter, container 1674px.

  Each card reads from a real collection and falls back through overrides, so
  the section keeps working once the placeholder catalog is replaced.
{% endcomment %}

{{ 'saf-rebrand.css' | asset_url | stylesheet_tag }}

{%- assign sid = section.id -%}

<style>
  #shopify-section-{{ sid }} .rb-cols {
    background: {{ section.settings.background }};
    padding-block:
      clamp(28px, 3.57vw, 68px)
      clamp(28px, 4.74vw, 91px);
  }
  #shopify-section-{{ sid }} .rb-cols__eyebrow {
    color: {{ section.settings.eyebrow_color }};
    text-align: center;
    margin-bottom: clamp(28px, 3.75vw, 72px);
  }
  #shopify-section-{{ sid }} .rb-cols__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr));
    gap: clamp(24px, 3.33vw, 64px);
  }
  #shopify-section-{{ sid }} .rb-col {
    display: flex;
    flex-direction: column;
  }
  #shopify-section-{{ sid }} .rb-col__media {
    display: block;
    aspect-ratio: 516 / 322;
    overflow: hidden;
    background: #efefef;
  }
  #shopify-section-{{ sid }} .rb-col__media img,
  #shopify-section-{{ sid }} .rb-col__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  #shopify-section-{{ sid }} .rb-col__media:hover img { transform: scale(1.03); }

  #shopify-section-{{ sid }} .rb-col__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(10px, 1.15vw, 22px);
    font-family: var(--rb-sans);
    font-size: var(--rb-fs-card);
    line-height: 1.3;
    color: {{ section.settings.caption_color }};
  }
  #shopify-section-{{ sid }} .rb-col__title {
    margin: 0;
    font: inherit;
    text-decoration: none;
    color: inherit;
  }
  #shopify-section-{{ sid }} .rb-col__title:hover { text-decoration: underline; }
  #shopify-section-{{ sid }} .rb-col__artist { text-align: right; }

  #shopify-section-{{ sid }} .rb-col__cta-row {
    display: flex;
    justify-content: center;
    margin-top: clamp(18px, 1.93vw, 37px);
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ sid }} .rb-cols__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 639px) {
    #shopify-section-{{ sid }} .rb-cols__grid { grid-template-columns: 1fr; }
  }
</style>

<div class="rb-section rb-cols">
  <div class="rb-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="rb-eyebrow rb-cols__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <div class="rb-cols__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign title = block.settings.title | default: col.title
          assign img = block.settings.image | default: col.featured_image
          assign url = col.url | default: block.settings.link
          if block.settings.link != blank
            assign url = block.settings.link
          endif
        -%}
        <div class="rb-col" {{ block.shopify_attributes }}>
          <a href="{{ url | default: '#' }}" class="rb-col__media">
            {%- if img != blank -%}
              {{
                img
                | image_url: width: 1200
                | image_tag:
                  widths: '400, 520, 700, 1040, 1200',
                  sizes: '(max-width: 639px) 90vw, (max-width: 989px) 45vw, 30vw',
                  loading: 'lazy',
                  alt: img.alt | default: title
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>

          <div class="rb-col__caption">
            <a href="{{ url | default: '#' }}" class="rb-col__title">
              {{- title | default: 'Collection Title' -}}
            </a>
            {%- if block.settings.artist != blank -%}
              <span class="rb-col__artist">{{ block.settings.artist | escape }}</span>
            {%- endif -%}
          </div>

          {%- if block.settings.button_label != blank -%}
            <div class="rb-col__cta-row">
              <a href="{{ url | default: '#' }}" class="rb-btn rb-btn--serif rb-btn--outline">
                {{- block.settings.button_label | escape -}}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rebrand collections",
  "tag": "section",
  "class": "rb-section-wrapper",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "default": "Our Featured Collections", "label": "Eyebrow" },
    { "type": "color", "id": "eyebrow_color", "default": "#bea532", "label": "Eyebrow colour" },
    { "type": "color", "id": "caption_color", "default": "#7d7d7d", "label": "Caption colour" },
    { "type": "color", "id": "background", "default": "#ffffff", "label": "Background" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override",
          "info": "Leave blank to use the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image override",
          "info": "Leave blank to use the collection image." },
        { "type": "text", "id": "artist", "default": "Artist Name", "label": "Artist name" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "text", "id": "button_label", "default": "Browse Collection", "label": "Button label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rebrand collections",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
