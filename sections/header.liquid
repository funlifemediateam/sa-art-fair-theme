<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  /* Stronger base contrast — visible bottom border */
  .header-wrapper {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.12);
    transition: background-color 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    will-change: background-color;
  }
  .header-wrapper--border-bottom {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.12);
  }

  /* Opaque cream sticky state */
  .shopify-section-header-sticky .header-wrapper {
    background-color: rgb(var(--color-background)) !important;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    border-bottom-color: rgba(var(--color-foreground), 0.08) !important;
  }

  /* ── Two-row header: logo · search · icons / nav below (Rise Art layout) ── */
  @media screen and (min-width: 990px) {
    .header--middle-left {
      grid-template-areas:
        'heading search icons'
        '. navigation ctas' !important;
      grid-template-columns: auto minmax(24rem, 1fr) auto !important;
      column-gap: 2.4rem;
      row-gap: 1.2rem;
      align-items: center;
    }
    .header--middle-left .header__heading,
    .header--middle-left .header__heading-link {
      justify-self: start;
    }
    /* Nav row starts under the search bar */
    .header--middle-left .header__inline-menu {
      justify-self: start;
      margin-left: -1rem;
    }
  }
  /* Mobile: search bar gets its own full-width row */
  @media screen and (max-width: 989px) {
    .header {
      grid-template-areas:
        'left-icons heading icons'
        'search search search' !important;
      row-gap: 0.6rem;
    }
  }
  .header__search-bar {
    display: block;
    grid-area: search;
    width: 100%;
  }
  .header__search-bar predictive-search,
  .header__search-bar search-form {
    position: relative;
    display: block;
  }
  .header__search-bar .search {
    position: relative;
  }
  .header__search-bar .field__input.search__input {
    border-radius: 6px;
    background-color: rgba(var(--color-foreground), 0.04);
    box-shadow: none;
    border: 1px solid rgba(var(--color-foreground), 0.18);
    height: 4.4rem;
    min-height: 4.4rem;
    padding-left: 4.2rem;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  .header__search-bar .field__input.search__input:focus {
    border-color: rgba(var(--color-foreground), 0.55);
    background-color: rgb(var(--color-background));
    outline: none;
    box-shadow: none;
  }
  .header__search-bar .field:after,
  .header__search-bar .field:before {
    display: none;
  }
  /* Leading search icon inside the bar */
  .header__search-bar .search__button {
    left: 0;
    right: auto;
    top: 0;
    height: 4.4rem;
    width: 4.2rem;
  }
  .header__search-bar .search__button:after,
  .header__search-bar .search__button:before {
    display: none;
  }
  .header__search-bar .reset__button {
    right: 0;
    top: 0;
    height: 4.4rem;
  }
  .header__search-bar .predictive-search {
    top: calc(100% + 0.4rem);
    left: 0;
    width: 100%;
    border-radius: 6px;
  }

  /* ── Header icon dropdowns (account / wishlist / currency) ── */
  .header__icons {
    gap: 0.4rem;
  }
  .header__icon-menu {
    position: relative;
  }
  .header__icon-menu > details > summary::-webkit-details-marker {
    display: none;
  }
  .header__icon-menu .header__icon-panel {
    position: absolute;
    top: 100%;
    right: -0.5rem;
    min-width: 18rem;
    padding: 1rem 0;
    margin: 0;
    background-color: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: 6px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.12);
    list-style: none;
    z-index: 6;
  }
  .header__icon-panel li {
    list-style: none;
  }
  .header__icon-panel a,
  .header__icon-panel button.header__icon-panel-option {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.9rem 1.6rem;
    font-size: 1.3rem;
    letter-spacing: 0.03em;
    color: rgba(var(--color-foreground), 0.85);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body-family);
  }
  .header__icon-panel a:hover,
  .header__icon-panel button.header__icon-panel-option:hover {
    color: rgb(var(--color-foreground));
    background-color: rgba(var(--color-foreground), 0.05);
  }
  .header__icon-panel .header__icon-panel-note {
    padding: 0.8rem 1.6rem 0.2rem;
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.5;
    color: rgba(var(--color-foreground), 0.6);
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
    margin-top: 0.6rem;
  }
  /* Same height as the 4.4rem icon buttons so it centres on the icon row */
  .saf-currency summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    height: 4.4rem;
    padding: 0 0.8rem;
    font-size: 1.3rem;
    letter-spacing: 0.03em;
    color: rgba(var(--color-foreground), 0.88);
    white-space: nowrap;
  }
  .header__icons {
    align-items: center;
  }
  .header__icon-menu,
  .header__icon-menu > details {
    display: flex;
    align-items: center;
  }

  /* ── Path CTAs (desktop: right end of nav row; labels via theme settings) ── */
  .saf-header-ctas {
    grid-area: ctas;
    justify-self: end;
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }
  .saf-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3.4rem;
    padding: 0 1.8rem;
    border-radius: 999px;
    font-family: var(--font-body-family);
    font-size: 1.15rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .saf-cta--buy {
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border: 1px solid rgb(var(--color-button));
  }
  .saf-cta--buy:hover {
    background-color: transparent;
    color: rgba(var(--color-foreground), 0.95);
  }
  .saf-cta--create {
    background-color: transparent;
    color: rgba(var(--color-foreground), 0.9);
    border: 1px solid rgba(var(--color-foreground), 0.4);
  }
  .saf-cta--create:hover {
    border-color: rgba(var(--color-foreground), 0.9);
    color: rgb(var(--color-foreground));
  }
  /* Transparent-over-hero state: buttons flip to white treatment */
  .section-header.header-at-top .header-wrapper--transparent .saf-cta--buy {
    background-color: #fff;
    color: #1d1c21;
    border-color: #fff;
  }
  .section-header.header-at-top .header-wrapper--transparent .saf-cta--buy:hover {
    background-color: transparent;
    color: #fff;
  }
  .section-header.header-at-top .header-wrapper--transparent .saf-cta--create {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
  }
  @media screen and (max-width: 989px) {
    .saf-header-ctas {
      display: none;
    }
  }

  /* ── Path-based navigation (three-state nav + mega menu) ── */
  /* With path nav on, the nav row spans the logo + search columns so a full
     path's sub-links fit on one line (default mode keeps the original grid) */
  @media screen and (min-width: 990px) {
    .header--path-nav.header--middle-left {
      grid-template-areas:
        'heading search icons'
        'navigation navigation ctas' !important;
    }
  }
  .saf-pnav .list-menu--inline {
    align-items: center;
  }
  /* Active path pill — must be unmistakable (theme button tokens).
     Double up on .saf-pnav: the later "refined menu typography"
     .header__menu-item rules carry !important at equal specificity. */
  .saf-pnav .saf-path-current {
    background-color: rgb(var(--color-button)) !important;
    color: rgb(var(--color-button-text)) !important;
    border-radius: 999px !important;
    padding: 0.6rem 1.6rem !important;
    margin-right: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }
  .saf-pnav .saf-path-current:hover {
    outline: none !important;
    opacity: 0.92;
  }
  /* Low-key switch link to the other path — fixed slot (ctas grid area) */
  .saf-path-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body-family);
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(var(--color-foreground), 0.6);
    white-space: nowrap;
    padding: 0.6rem 0.2rem;
    transition: color 0.2s ease;
  }
  .saf-path-switch:hover {
    color: rgb(var(--color-foreground));
  }
  .saf-path-switch__arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .saf-path-switch:hover .saf-path-switch__arrow {
    transform: translateX(3px);
  }
  /* Path label is a link, caret is the disclosure. The .saf-pnav prefix is
     required: the refined menu typography rules below use !important on
     .header__menu-item and would otherwise win at equal specificity. */
  .saf-pnav .saf-pnav__summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .saf-pnav .saf-pnav__label {
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-decoration: none;
    padding: 0;
  }
  .saf-pnav .saf-pnav__caret {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem;
    margin: -0.4rem -0.4rem -0.4rem 0;
    cursor: pointer;
  }
  .saf-pnav .saf-pnav__caret svg {
    height: 0.6rem;
    transition: transform 0.2s ease;
  }
  .saf-pnav details[open] > .saf-pnav__summary .saf-pnav__caret svg {
    transform: rotate(180deg);
  }
  /* Mega panel: calm, spacious, premium */
  .saf-mega .mega-menu__content {
    padding: 4rem 0 4.8rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.06);
  }
  .saf-mega__inner {
    display: flex;
    gap: 8rem;
    align-items: flex-start;
  }
  .saf-mega__lead {
    display: inline-flex;
    align-items: baseline;
    gap: 0.8rem;
    font-family: var(--font-heading-family);
    font-size: 2.4rem;
    line-height: 1.2;
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }
  .saf-mega__lead-arrow {
    font-size: 1.8rem;
    transition: transform 0.2s ease;
  }
  .saf-mega__lead:hover .saf-mega__lead-arrow {
    transform: translateX(4px);
  }
  .saf-mega__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 22rem;
  }
  .saf-mega__links a {
    display: inline-block;
    padding: 0.55rem 0;
    font-size: 1.4rem;
    letter-spacing: 0.02em;
    color: rgba(var(--color-foreground), 0.78);
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .saf-mega__links a:hover {
    color: rgb(var(--color-foreground));
    transform: translateX(2px);
  }
  .saf-mega__links a[aria-current='page'] {
    color: rgb(var(--color-foreground));
    font-weight: 500;
  }
  .saf-mega__sublinks {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.6rem;
  }
  .saf-mega__sublinks a {
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.65);
  }
  .saf-currency .header__icon-panel-option[aria-current='true'] {
    font-weight: 600;
    color: rgb(var(--color-foreground));
  }
  .wishlist-count-bubble {
    position: absolute;
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    height: 1.7rem;
    min-width: 1.7rem;
    border-radius: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    bottom: 0.4rem;
    right: 0.2rem;
    padding: 0 0.3rem;
    line-height: 1;
  }
  /* Count bubble must stay hidden when empty (display:flex would beat [hidden]) */
  .wishlist-count-bubble[hidden] {
    display: none !important;
  }
  /* Heart icon: outline via currentColor (svg has no fill attribute of its own) */
  .header__icon--wishlist svg path,
  .header__icon--wishlist-mobile svg path {
    fill: currentColor;
  }
  .header__icon--wishlist .svg-wrapper,
  .header__icon--wishlist-mobile .svg-wrapper {
    width: 2rem;
    height: 2rem;
  }
  /* Dawn draws the cart in a 40-unit viewBox with heavy padding, so at the row's
     shared 2rem sizing the painted bag lands ~20% smaller than the 20-unit
     icons beside it. Size its box up so the glyphs match optically. */
  .header__icon--cart .svg-wrapper,
  .header__icon--cart .icon {
    width: 48px;
    height: 48px;
  }
  /* Mobile: hide desktop-only header items (!important — base.css
     .header__icon:not(.header__icon--summary) outranks a single class) */
  @media screen and (max-width: 989px) {
    .header__icon-menu--desktop,
    .saf-currency,
    .header__icon--gift-card,
    .header__icon--contact,
    .header__icon--instagram,
    .header__icon--location {
      display: none !important;
    }
  }

  /* ── Refined menu typography ── */
  .header__menu-item {
    font-family: var(--font-body-family);
    font-size: 1.15rem !important;
    letter-spacing: 0.02em;
    font-weight: 400;
    color: rgba(var(--color-foreground), 0.88) !important;
    padding-left: 1rem !important;
    padding-right: 1rem !important;
    border-radius: 5px;
    transition: color 0.2s ease, background-color 0.2s ease !important;
    text-decoration: none !important;
  }
  .header__menu-item:hover {
    color: rgba(var(--color-foreground), 1) !important;
    background-color: transparent !important;
    outline: 1px solid rgba(var(--color-foreground), 0.4);
    text-decoration: none !important;
  }
  .header__menu-item span {
    text-decoration: none !important;
    border-bottom: none !important;
  }
  /* Dropdown/mega summaries: the caret is absolutely positioned at right 0.8rem,
     so the label needs room reserved for it. The padding-right: 1rem above is
     !important and beats Dawn's summary.list-menu__item { padding-right: 2.7rem },
     which let the caret sit on top of the last letter ("Collect Ar⌄").
     summary.header__menu-item outranks it at equal importance. */
  summary.header__menu-item {
    padding-right: 2.7rem !important;
  }
  summary.header__menu-item .icon-caret {
    color: rgba(var(--color-foreground), 0.55);
    transition: transform 0.2s ease, color 0.2s ease;
  }
  summary.header__menu-item:hover .icon-caret,
  details[open] > summary.header__menu-item .icon-caret {
    color: rgb(var(--color-foreground));
  }
  .header__active-menu-item {
    color: rgba(var(--color-foreground), 1) !important;
    background-color: transparent !important;
    outline: 1px solid rgba(var(--color-foreground), 0.4);
    text-decoration: none !important;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  .list-menu__item--active,
  .list-menu__item--active:hover {
    text-decoration: none !important;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }
</style>

{%- style -%}
  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 3rem;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{%- liquid
  comment
    Path-based navigation. Three states: 'global' (both paths + global links),
    'a' (inside path 1), 'b' (inside path 2). Link source per state: the menu
    picker, falling back to the booking app navigation metafield
    (booking_app.path_nav json: { "global": [], "pathA": [], "pathB": [] },
    items shaped { "title": "", "url": "" } to match Liquid link drops).

    Detection: the current URL (query/hash/trailing slash stripped) is matched
    against each list. A global-menu EXACT match always wins (so shared pages
    like Contact stay in the global state); otherwise a path claims the page
    when the URL equals one of its links/landing page or sits under one
    (link path + '/'). No match = global state.
  endcomment
  assign saf_path_enabled = section.settings.enable_path_nav
  assign saf_path_state = 'global'
  if saf_path_enabled
    assign saf_path_nav_meta = shop.metafields.booking_app.path_nav.value
    assign saf_a_label = section.settings.path_a_label
    assign saf_b_label = section.settings.path_b_label
    assign saf_a_url = section.settings.path_a_url | default: routes.all_products_collection_url
    assign saf_b_url = section.settings.path_b_url | default: routes.all_products_collection_url

    comment
      Menu pickers live in 'Path menu' blocks: a section may hold only one
      link_list setting, but each block may hold its own.
    endcomment
    assign saf_a_list = ''
    assign saf_b_list = ''
    assign saf_g_list = ''
    for saf_blk in section.blocks
      if saf_blk.type == 'path_menu'
        if saf_blk.settings.path == 'a' and saf_a_list == blank
          assign saf_a_list = saf_blk.settings.menu.links
        elsif saf_blk.settings.path == 'b' and saf_b_list == blank
          assign saf_b_list = saf_blk.settings.menu.links
        elsif saf_blk.settings.path == 'global' and saf_g_list == blank
          assign saf_g_list = saf_blk.settings.menu.links
        endif
      endif
    endfor
    if saf_a_list == blank
      assign saf_a_list = saf_path_nav_meta['pathA']
    endif
    if saf_b_list == blank
      assign saf_b_list = saf_path_nav_meta['pathB']
    endif
    if saf_g_list == blank
      assign saf_g_list = saf_path_nav_meta['global']
    endif

    assign saf_cur = request.path | split: '?' | first | split: '#' | first
    assign saf_cur_last = saf_cur | slice: -1
    if saf_cur_last == '/' and saf_cur.size > 1
      assign saf_cur_len = saf_cur.size | minus: 1
      assign saf_cur = saf_cur | slice: 0, saf_cur_len
    endif
    assign saf_cur_slash = saf_cur | append: '/'

    assign saf_in_g = false
    for saf_l in saf_g_list
      assign saf_lp = saf_l.url | split: '?' | first | split: '#' | first
      if saf_lp == saf_cur and saf_lp != '/' and saf_lp != blank
        assign saf_in_g = true
      endif
    endfor

    assign saf_in_a = false
    assign saf_a_probe = saf_a_url | split: '?' | first | split: '#' | first | split: ','
    for saf_l in saf_a_list
      assign saf_lp = saf_l.url | split: '?' | first | split: '#' | first
      assign saf_extra = saf_lp | split: ','
      assign saf_a_probe = saf_a_probe | concat: saf_extra
    endfor
    for saf_lp in saf_a_probe
      if saf_lp == '/' or saf_lp == blank
        continue
      endif
      assign saf_lps = saf_lp | append: '/'
      assign saf_head = saf_cur_slash | slice: 0, saf_lps.size
      if saf_lp == saf_cur or saf_head == saf_lps
        assign saf_in_a = true
      endif
    endfor

    assign saf_in_b = false
    assign saf_b_probe = saf_b_url | split: '?' | first | split: '#' | first | split: ','
    for saf_l in saf_b_list
      assign saf_lp = saf_l.url | split: '?' | first | split: '#' | first
      assign saf_extra = saf_lp | split: ','
      assign saf_b_probe = saf_b_probe | concat: saf_extra
    endfor
    for saf_lp in saf_b_probe
      if saf_lp == '/' or saf_lp == blank
        continue
      endif
      assign saf_lps = saf_lp | append: '/'
      assign saf_head = saf_cur_slash | slice: 0, saf_lps.size
      if saf_lp == saf_cur or saf_head == saf_lps
        assign saf_in_b = true
      endif
    endfor

    if saf_in_g
      assign saf_path_state = 'global'
    elsif saf_in_a
      assign saf_path_state = 'a'
    elsif saf_in_b
      assign saf_path_state = 'b'
    endif
  endif
-%}

