        }
      ]
    },
    {
      "id": "minimalist",
      "name": "The Serene Minimalist",
      "description": "You find peace in simplicity. A single well-placed element, clean negative space or a precisely arranged composition gives you more satisfaction than noise ever could. You are drawn to stillness — art that rewards patience, that reveals more the longer you sit with it. Structured compositions and quiet colour harmonies feel like home. You do not collect art to impress; you collect it to breathe.",
      "image": "https:\/\/images.metmuseum.org\/CRDImages\/ep\/original\/DP353257.jpg",
      "recommendations": [
        {
          "title": "Explore the Gallery",
          "url": "\/collections\/gallery"
        },
        {
          "title": "Browse our Artists",
          "url": "\/collections\/artists"
        },
        {
          "title": "See Suggested Classes",
          "url": "\/collections\/classes"
        }
      ]
    },
    {
      "id": "romantic",
      "name": "The Nature Romantic",
      "description": "You feel most at home when art puts you in nature's embrace — dappled light through trees, the texture of earth after rain, a horizon that seems to breathe. Impressionist painting, organic forms and landscapes resonate deeply with you. For you, the best art is a window: it transports you somewhere quieter, somewhere alive. You collect pieces that make a room feel like the world got bigger.",
      "image": "https:\/\/www.artic.edu\/iiif\/2\/3c27b499-af56-f0d5-93b5-a7f2f1ad5813\/full\/843,\/0\/default.jpg",
      "recommendations": [
