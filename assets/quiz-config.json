  "personalities": [
    {
      "id": "expressionist",
      "name": "The Expressionist",
      "description": "Art is your emotional outlet and mirror. You are drawn to works that feel urgent, unfiltered and alive — where you can sense the artist's hand, their struggle, their joy. Gestural strokes, vibrant tension and raw energy speak directly to you. For you, art does not need to be pretty; it needs to be honest. You collect with your gut, not your head — and that is exactly as it should be.",
      "image": "https:\/\/images.metmuseum.org\/CRDImages\/ep\/original\/DP-42549-001.jpg",
      "recommendations": [
        {
          "title": "Explore the Gallery",
          "url": "\/collections\/gallery"
        },
        {
          "title": "Browse our Artists",
          "url": "\/collections\/artists"
        },
        {
          "title": "See Suggested Classes",
