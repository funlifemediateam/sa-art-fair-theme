      ]
    },
    {
      "id": "urban",
      "name": "The Urban Observer",
      "description": "People are your subject. You are drawn to art that documents the human condition — portraits that reveal character, scenes of city life, works that hold a moment in time and ask you to look closely. You value craft and representation: the ability to capture something real and true about how we live. Your collection tells stories. Every piece you own is a conversation waiting to happen.",
      "image": "https:\/\/www.artic.edu\/iiif\/2\/f8fd76e9-c396-5678-36ed-6a348c904d27\/full\/843,\/0\/default.jpg",
      "recommendations": [
